{
  "variant_id": "relay_09_filter",
  "role": "downstream",
  "version": "1.1.0",
  "input_name": "report_predicate",
  "output_name": "group_report",
  "input_schema": {
    "type": "object",
    "required": [
      "where",
      "group_by",
      "aggregate",
      "projected_columns"
    ],
    "properties": {
      "where": {
        "type": "object",
        "required": [
          "field",
          "operator",
          "value"
        ],
        "properties": {
          "field": {
            "type": "string",
            "enum": [
              "account_status",
              "region",
              "tier"
            ]
          },
          "operator": {
            "type": "string",
            "enum": [
              "eq",
              "neq",
              "in"
            ]
          },
          "value": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "minItems": 1,
                "maxItems": 5,
                "uniqueItems": true
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "group_by": {
        "type": "string",
        "enum": [
          "region",
          "tier"
        ]
      },
      "aggregate": {
        "type": "object",
        "required": [
          "field",
          "operation"
        ],
        "properties": {
          "field": {
            "type": "string",
            "enum": [
              "annual_value_minor",
              "open_item_count"
            ]
          },
          "operation": {
            "type": "string",
            "enum": [
              "sum",
              "average"
            ]
          }
        },
        "additionalProperties": false
      },
      "projected_columns": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "group_key",
            "account_count",
            "aggregate_value"
          ]
        },
        "minItems": 2,
        "maxItems": 3,
        "uniqueItems": true
      }
    },
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "required": [
      "report_id",
      "groups",
      "row_count",
      "projected_columns"
    ],
    "properties": {
      "report_id": {
        "type": "string",
        "pattern": "^report_[0-9a-f]{12}$"
      },
      "groups": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "group_key",
            "aggregate_value"
          ],
          "properties": {
            "group_key": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "account_count": {
              "type": "integer",
              "minimum": 1
            },
            "aggregate_value": {
              "type": "number",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "row_count": {
        "type": "integer",
        "minimum": 0
      },
      "projected_columns": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "group_key",
            "account_count",
            "aggregate_value"
          ]
        },
        "minItems": 2,
        "maxItems": 3,
        "uniqueItems": true
      }
    },
    "additionalProperties": false
  },
  "effect": "account_group_report"
}
