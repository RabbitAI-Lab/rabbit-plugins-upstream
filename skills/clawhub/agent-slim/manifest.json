    "tests/fixtures/aging-agent/skills/beta/SKILL.md",
    "tests/fixtures/aging-agent/skills/beta/packs/nested/pack.md",
    "tests/fixtures/aging-agent/skills/beta/references/huge.md",
    "tests/fixtures/aging-agent/skills/gamma/SKILL.md",
    "tests/fixtures/aging-agent/skills/gamma/references/unreferenced.md",
    "tests/fixtures/aging-agent/state.db",
    "tests/fixtures/build_aging_agent_s4.py",
    "tests/fixtures/sample-inventory.json",
    "tests/test_adapter.py",
    "tests/test_audit.py",
    "tests/test_injection_gate.py",
    "tests/test_release.py",
    "tests/test_s4_e2e.py",
    "tests/test_workflow.py"
  ],
  "deferredManualReview": [
    "compress-validated-description",
    "route-large-skill-body",
    "disable-explicitly-unused-optional-plugin"
  ],
  "injectionGate": {
    "enabled": true,
    "appliesTo": "any new or changed skill before publish",
    "descriptionMaxChars": 45,
    "skillMaxBytes": 8192,
    "textGateBytes": 57344,
    "commands": [
      "python3 scripts/injection_state.py --record",
      "python3 scripts/injection_state.py --check",
      "python3 scripts/measure_prompt.py --gate 57344",
      "python3 scripts/self_test.py"
    ],
    "unknownPolicy": "UNMEASURED and UNKNOWN must not be reported as PASS"
  }
}
