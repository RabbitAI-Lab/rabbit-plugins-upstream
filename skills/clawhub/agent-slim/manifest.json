{
  "schemaVersion": "1.0",
  "name": "agent-slim",
  "slug": "agent-slim",
  "displayName": "Agent 整体瘦身师",
  "version": "0.2.0",
  "status": "released",
  "phase": "s8-injection-gate",
  "author": "lis",
  "license": "MIT",
  "description": "Agent 瘦身：盘点、注入测量、发布闸门、回滚；不删原件。",
  "entrypoints": {
    "skill": "SKILL.md",
    "readme": "README.md",
    "readmeEn": "README.en.md",
    "interface": "agents/openai.yaml",
    "usage": "docs/usage.md",
    "architecture": "docs/architecture.md",
    "safety": "docs/safety.md",
    "acceptance": "docs/acceptance.md",
    "auditContract": "docs/audit-json-contract.md",
    "executionContract": "docs/execution-contract.md",
    "adapterContract": "references/adapter-contract.md",
    "integrationRouting": "references/integration-routing.md",
    "routingIndex": "references/routing-index.md",
    "planSchema": "schemas/plan.schema.json",
    "transactionManifestSchema": "schemas/transaction-manifest.schema.json",
    "verificationSchema": "schemas/verification.schema.json",
    "injectionDocs": "docs/injection-measurement.md",
    "injectionBaseline": "references/baseline-20261109.json",
    "injectionBudgets": "references/budgets.md",
    "mcpMeasure": "references/mcp-measure.md"
  },
  "hosts": {
    "codex": {
      "role": "first-host",
      "implementation": "audit-plan-apply-verify-restore",
      "verified": true,
      "verifiedScope": "s4-synthetic-aging-e2e-host-adapter; real-host-test-prompts-pending"
    },
    "other-agents": {
      "role": "adapter-interface-only",
      "implementation": "adapter-interface-only",
      "verified": false
    }
  },
  "defaultMode": "dry-run",
  "allowlist": [
    "quarantine-redundant-backup",
    "archive-verified-old-session",
    "quarantine-low-frequency-file"
  ],
  "deniedByDefault": [
    "delete-original",
    "secret-or-credential-change",
    "provider-or-auth-change",
    "database-vacuum",
    "system-level-config-change",
    "company-data-upload",
    "claim-token-savings-from-cold-storage"
  ],
  "delegatedResponsibilities": {
    "existence-review": "ponytail",
    "single-skill-extraction-and-routing": "skill-architect",
    "memory-thresholds-recovery-and-handoff": "memory-orchestrator",
    "token-usage-facts": "host-meter-or-existing-usage-tool",
    "release-and-review": "skill-publisher"
  },
  "validation": {
    "command": "python3 -m unittest discover -s tests -p 'test_*.py' -v",
    "fixture": "tests/fixtures/build_aging_agent_s4.py",
    "jsonContract": "docs/audit-json-contract.md",
    "verificationLog": "outputs/s5-release-ready.md",
    "commands": [
      "python3 -m py_compile scripts/*.py tests/*.py tests/fixtures/*.py",
      "python3 -m unittest discover -s tests -p 'test_*.py' -v",
      "python3 tests/validate_s1.py",
      "for f in schemas/*.json; do python3 -m json.tool \"$f\" >/dev/null || exit 1; done",
      "python3 scripts/build_release.py --json",
      "python3 scripts/self_test.py"
    ],
    "schemas": [
      "schemas/plan.schema.json",
      "schemas/transaction-manifest.schema.json",
      "schemas/verification.schema.json"
    ]
  },
  "release": {
    "version": "0.2.0",
    "packages": {
      "github": {
        "prefix": "agent-slim-0.2.0/",
        "include": [
          "SKILL.md",
          "README.md",
          "README.en.md",
          "CHANGELOG.md",
          "LICENSE",
          "NOTICE.md",
          "manifest.json",
          "agents",
          "icons",
          "docs",
          "references",
          "schemas",
          "scripts",
          "tests"
        ],
        "exclude": [
          "**/__pycache__/**",
          "**/*.pyc",
          "**/.DS_Store",
          "tests/validate_s1.py"
        ]
      },
      "skillhub": {
        "prefix": "agent-slim/",
        "include": [
          "SKILL.md",
          "README.md",
          "CHANGELOG.md",
          "LICENSE",
          "NOTICE.md",
          "manifest.json",
          "docs",
          "references",
          "schemas",
          "scripts"
        ],
        "exclude": [
          "**/__pycache__/**",
          "**/*.pyc",
          "**/.DS_Store"
        ],
        "renames": {
          "LICENSE": "LICENSE.md"
        },
        "platformNotes": "SkillHub 不接收 png 等二进制文件：不打包 icons/ 与 agents/openai.yaml；LICENSE 重命名为 LICENSE.md。图标由平台侧上传维护。"
      },
      "clawhub": {
        "prefix": "",
        "include": [
          "SKILL.md",
          "README.md",
          "README.en.md",
          "CHANGELOG.md",
          "LICENSE",
          "NOTICE.md",
          "manifest.json",
          "agents",
          "icons",
          "docs",
          "references",
          "schemas",
          "scripts",
          "tests"
        ],
        "exclude": [
          "**/__pycache__/**",
          "**/*.pyc",
          "**/.DS_Store",
          "tests/validate_s1.py"
        ]
      }
    }
  },
  "publishableFiles": [
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE.md",
    "README.en.md",
    "README.md",
    "SKILL.md",
    "agents/openai.yaml",
    "docs/acceptance.md",
    "docs/architecture.md",
    "docs/audit-json-contract.md",
    "docs/execution-contract.md",
    "docs/injection-measurement.md",
    "docs/safety.md",
    "docs/usage.md",
    "icons/icon_large.png",
    "icons/icon_small.png",
    "manifest.json",
    "references/README.md",
    "references/adapter-contract.md",
    "references/baseline-20261109.json",
    "references/budgets.md",
    "references/context-model.md",
    "references/integration-routing.md",
    "references/mcp-measure.md",
    "references/routing-index.md",
    "schemas/plan.schema.json",
    "schemas/transaction-manifest.schema.json",
    "schemas/verification.schema.json",
    "scripts/README.md",
    "scripts/agent_slim.py",
    "scripts/agent_slim_adapter.py",
    "scripts/agent_slim_workflow.py",
    "scripts/budget_dashboard.py",
    "scripts/build_release.py",
    "scripts/injection_state.py",
    "scripts/make_icons.py",
    "scripts/mcp_probe.py",
    "scripts/measure_prompt.py",
    "scripts/scan_layers.py",
    "scripts/self_test.py",
    "scripts/token_experiment.py",
    "tests/fixtures/aging-agent/AGENTS.md",
    "tests/fixtures/aging-agent/archived_sessions/old-archive.jsonl.zst",
    "tests/fixtures/aging-agent/backups/snapshot.zip",
    "tests/fixtures/aging-agent/config.toml",
    "tests/fixtures/aging-agent/log/codex.log",
    "tests/fixtures/aging-agent/memories/memory_summary.md",
    "tests/fixtures/aging-agent/plugins/cache/test-market/plug-a/1.0.0/.app.json",
    "tests/fixtures/aging-agent/plugins/cache/test-market/plug-a/1.0.0/.mcp.json",
    "tests/fixtures/aging-agent/plugins/cache/test-market/plug-a/1.0.0/skills/plugin-skill/SKILL.md",
    "tests/fixtures/aging-agent/rules/conditional.md",
    "tests/fixtures/aging-agent/rules/duplicate-a.md",
    "tests/fixtures/aging-agent/rules/duplicate-b.md",
    "tests/fixtures/aging-agent/rules/index.md",
    "tests/fixtures/aging-agent/rules/resident.md",
