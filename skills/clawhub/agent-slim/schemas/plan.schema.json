{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Slim Plan",
  "type": "object",
  "required": [
    "schemaVersion", "kind", "planId", "createdAt", "mode", "defaultApplyMode",
    "home", "sourceAudit", "transaction", "policy", "actions", "preservedFiles",
    "parseChecks", "referenceGraph", "ranking", "limitations"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "kind": {"const": "agent-slim-plan"},
    "planId": {"type": "string", "minLength": 1},
    "createdAt": {"type": "string", "minLength": 1},
    "mode": {"const": "dry-run"},
    "defaultApplyMode": {"const": "dry-run"},
    "home": {"type": "string", "minLength": 1},
    "sourceAudit": {
      "type": "object",
      "required": ["sha256", "summaryStatus"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "summaryStatus": {"enum": ["PASS", "WARN"]},
        "runId": {"type": ["string", "null"]},
        "warningCount": {"type": "integer", "minimum": 0},
        "unknownCount": {"type": "integer", "minimum": 0}
      }
    },
    "transaction": {
      "type": "object",
      "required": ["id", "root", "dir", "manifestPath", "manifestSha256Path", "restoreScriptPath", "restoreShellPath", "resultPath"],
      "properties": {
        "id": {"type": "string", "pattern": "^txn-[a-f0-9]+$"},
        "root": {"type": "string", "minLength": 1},
        "dir": {"type": "string", "minLength": 1},
        "manifestPath": {"type": "string", "minLength": 1},
        "manifestSha256Path": {"type": "string", "minLength": 1},
        "restoreScriptPath": {"type": "string", "minLength": 1},
        "restoreShellPath": {"type": "string", "minLength": 1},
        "resultPath": {"type": "string", "minLength": 1}
      }
    },
    "policy": {
      "type": "object",
      "required": ["allowedActions", "confirmationInput", "deleteAllowed", "vacuumAllowed", "secretOrProviderChangesAllowed"],
      "properties": {
        "allowedActions": {
          "type": "array",
          "items": {"enum": ["quarantine-redundant-backup", "archive-verified-old-session", "quarantine-low-frequency-file"]}
        },
        "confirmationInput": {"type": "array", "items": {"type": "string"}},
        "deleteAllowed": {"const": false},
        "vacuumAllowed": {"const": false},
        "secretOrProviderChangesAllowed": {"const": false}
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id", "action", "status", "executable", "target", "reason",
          "expectedContextSavings", "expectedDiskSavings", "risk", "reversibility",
          "backupPath", "verification"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^action-[0-9]{3}$"},
          "action": {"type": "string", "minLength": 1},
          "status": {"enum": ["ready", "pending-confirmation"]},
          "executable": {"type": "boolean"},
          "target": {
            "type": "object",
            "required": ["path", "kind"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "kind": {"const": "file"},
              "sha256": {"type": ["string", "null"]},
              "bytes": {"type": "integer", "minimum": 0},
              "mtimeNs": {"type": ["integer", "null"]}
            }
          },
          "reason": {"type": "string", "minLength": 1},
          "expectedContextSavings": {
            "type": "object",
            "required": ["tokens", "evidence", "basis"],
            "properties": {
              "tokens": {"type": "integer", "minimum": 0},
              "evidence": {"enum": ["unknown", "estimated-upper-bound", "measured"]},
              "basis": {"type": "string", "minLength": 1}
            }
          },
          "expectedDiskSavings": {
            "type": "object",
            "required": ["bytes", "evidence", "basis", "recoverableBytes"],
            "properties": {
              "bytes": {"type": "integer", "minimum": 0},
              "evidence": {"type": "string", "minLength": 1},
              "basis": {"type": "string", "minLength": 1},
              "recoverableBytes": {"type": "integer", "minimum": 0}
            }
          },
          "risk": {"enum": ["R0", "R1", "R2", "R3"]},
          "reversibility": {"type": "string", "minLength": 1},
          "backupPath": {"type": ["string", "null"]},
          "verification": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "preservedFiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "bytes": {"type": "integer", "minimum": 0}
        }
      }
    },
    "parseChecks": {"type": "array", "items": {"type": "object"}},
    "referenceGraph": {"type": "array", "items": {"type": "object"}},
    "ranking": {"type": "object"},
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
