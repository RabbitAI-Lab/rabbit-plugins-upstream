{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Slim Transaction Manifest",
  "type": "object",
  "required": ["schemaVersion", "kind", "transactionId", "planId", "planSha256", "createdAt", "mode", "status", "home", "transactionDir", "restoreCommand", "actions"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "kind": {"const": "agent-slim-transaction-manifest"},
    "transactionId": {"type": "string", "pattern": "^txn-[a-f0-9]+$"},
    "planId": {"type": "string", "minLength": 1},
    "planSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "createdAt": {"type": "string", "minLength": 1},
    "mode": {"const": "apply"},
    "status": {"const": "prepared"},
    "home": {"type": "string", "minLength": 1},
    "transactionDir": {"type": "string", "minLength": 1},
    "restoreCommand": {"type": "string", "minLength": 1},
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "action", "source", "destinationRoot", "destination", "sha256", "bytes", "mtimeNs", "verification"],
        "properties": {
          "id": {"type": "string", "pattern": "^action-[0-9]{3}$"},
          "action": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "destinationRoot": {"const": "transaction"},
          "destination": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "bytes": {"type": "integer", "minimum": 0},
          "mtimeNs": {"type": "integer", "minimum": 0},
          "verification": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    }
  }
}
