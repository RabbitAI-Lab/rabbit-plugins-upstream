{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Slim Verification Result",
  "type": "object",
  "required": ["schemaVersion", "kind", "createdAt", "planId", "transactionId", "phase", "checks", "summary", "capabilities", "artifacts"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "kind": {"const": "agent-slim-verification"},
    "createdAt": {"type": "string", "minLength": 1},
    "planId": {"type": "string", "minLength": 1},
    "transactionId": {"type": "string", "minLength": 1},
    "phase": {"enum": ["applied", "restored"]},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "status"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "status": {"enum": ["PASS", "FAIL", "SKIPPED", "UNKNOWN"]}
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["status", "blockingFailures", "unknownChecks"],
      "properties": {
        "status": {"enum": ["PASS", "PARTIAL", "FAIL"]},
        "blockingFailures": {"type": "array", "items": {"type": "string"}},
        "unknownChecks": {"type": "array", "items": {"type": "string"}}
      }
    },
    "capabilities": {"type": "object"},
    "artifacts": {
      "type": "object",
      "required": ["manifestSha256", "manifest"],
      "properties": {
        "manifestSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "manifest": {"type": "string", "minLength": 1}
      }
    }
  }
}
