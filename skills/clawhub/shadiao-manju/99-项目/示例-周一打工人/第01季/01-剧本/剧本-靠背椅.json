  "lines": [
    {
      "seq": 1,
      "speaker": "老板",
      "type": "dialogue",
      "text": "宣布个新规定。",
      "emotion": "得意",
      "sfx": "叮",
      "scene": "S1"
    },
    {
      "seq": 2,
      "speaker": "老板",
      "type": "dialogue",
      "text": "日报不满三千字，算没上班。",
      "emotion": "平静",
      "sfx": "",
      "scene": "S1"
    },
    {
      "seq": 3,
      "speaker": "阿强",
      "type": "dialogue",
      "text": "三千字？我一天就三件事。",
      "emotion": "无语",
      "sfx": "",
      "scene": "S1"
    },
    {
      "seq": 4,
      "speaker": "老板",
      "type": "dialogue",
      "text": "那就把三件事，写成三千字。",
      "emotion": "得意",
      "sfx": "",
      "scene": "S1"
    },
    {
      "seq": 5,
      "speaker": "阿强",
      "type": "dialogue",
      "text": "明白。我写。",
      "emotion": "平静",
      "sfx": "",
      "scene": "S1"
    },
    {
      "seq": 6,
      "speaker": "旁白",
      "type": "narration",
      "text": "第二天早上，阿强交了日报。",
      "emotion": "平静",
      "sfx": "",
      "scene": "S2"
    },
    {
      "seq": 7,
      "speaker": "老板",
      "type": "dialogue",
      "text": "这三千字，怎么全是赋能？",
      "emotion": "愤怒",
      "sfx": "",
      "scene": "S2"
    },
    {
      "seq": 8,
      "speaker": "阿强",
      "type": "dialogue",
      "text": "您要字数，没说要内容。",
      "emotion": "平静",
      "sfx": "",
      "scene": "S2"
    },
    {
      "seq": 9,
      "speaker": "老板",
      "type": "dialogue",
      "text": "重写。要有质量。",
      "emotion": "无语",
      "sfx": "咚",
      "scene": "S2"
    },
    {
      "seq": 10,
      "speaker": "阿强",
      "type": "dialogue",
      "text": "明白。我加小标题了。",
      "emotion": "平静",
      "sfx": "",
      "scene": "S2"
    },
    {
      "seq": 11,
      "speaker": "老板",
      "type": "dialogue",
      "text": "小标题也是赋能？",
      "emotion": "无语",
      "sfx": "",
      "scene": "S2"
    },
    {
      "seq": 12,
      "speaker": "阿强",
      "type": "dialogue",
      "text": "小标题是，赋能的分类。",
      "emotion": "平静",
      "sfx": "",
      "scene": "S2"
    },
    {
      "seq": 13,
      "speaker": "老板",
      "type": "dialogue",
      "text": "算了，我示范一份。",
      "emotion": "得意",
      "sfx": "",
      "scene": "S2"
    },
    {
      "seq": 14,
      "speaker": "旁白",
      "type": "narration",
      "text": "老板打了三个小时。",
      "emotion": "平静",
      "sfx": "",
      "scene": "S3"
    },
    {
      "seq": 15,
      "speaker": "阿强",
      "type": "dialogue",
      "text": "您这份，三千二百字。",
      "emotion": "惊讶",
      "sfx": "",
      "scene": "S3"
    },
    {
      "seq": 16,
      "speaker": "阿强",
      "type": "dialogue",
      "text": "三千一百九十字，是降本增效。",
      "emotion": "平静",
      "sfx": "",
      "scene": "S3"
    },
    {
      "seq": 17,
      "speaker": "老板",
      "type": "dialogue",
      "text": "我这叫战略。",
      "emotion": "得意",
      "sfx": "",
      "scene": "S3"
    },
    {
      "seq": 18,
      "speaker": "阿强",
      "type": "dialogue",
      "text": "那我这叫执行。",
      "emotion": "平静",
      "sfx": "",
      "scene": "S3"
    },
    {
      "seq": 19,
      "speaker": "老板",
      "type": "dialogue",
      "text": "重写。",
      "emotion": "得意",
      "sfx": "咚",
      "scene": "S3"
    },
    {
      "seq": 20,
      "speaker": "阿强",
      "type": "dialogue",
      "text": "明白。那您那份，也重写吗？",
      "emotion": "平静",
      "sfx": "",
      "scene": "S3"
    },
    {
      "seq": 21,
      "speaker": "老板",
      "type": "dialogue",
      "text": "……我这叫，亲自示范。",
      "emotion": "无语",
      "sfx": "乌鸦",
      "scene": "S3"
    },
    {
      "seq": 22,
      "speaker": "旁白",
      "type": "narration",
      "text": "当天晚上，两个人一起写到十二点。",
      "emotion": "平静",
      "sfx": "",
      "scene": "S4"
    }
  ]
