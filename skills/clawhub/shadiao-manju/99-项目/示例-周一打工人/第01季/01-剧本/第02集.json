    },
    {
      "seq": 15,
      "speaker": "阿强",
      "type": "dialogue",
      "text": "我这是严格执行。",
      "emotion": "平静",
      "sfx": "",
      "scene": "S3"
    },
    {
      "seq": 16,
      "speaker": "旁白",
      "type": "narration",
      "text": "三天后，老板的活也没干完。",
      "emotion": "平静",
      "sfx": "",
      "scene": "S3"
    },
    {
      "seq": 17,
      "speaker": "老板",
      "type": "dialogue",
      "text": "大老板问我进度，我说什么？",
      "emotion": "悲伤",
      "sfx": "",
      "scene": "S3"
    },
    {
      "seq": 18,
      "speaker": "阿强",
      "type": "dialogue",
      "text": "说弹性。",
      "emotion": "平静",
      "sfx": "",
      "scene": "S3"
    },
    {
      "seq": 19,
      "speaker": "老板",
      "type": "dialogue",
      "text": "那是给你们的！",
      "emotion": "愤怒",
      "sfx": "咚",
      "scene": "S3"
    },
    {
      "seq": 20,
      "speaker": "阿强",
      "type": "dialogue",
      "text": "弹性不分上下级。",
      "emotion": "平静",
      "sfx": "",
      "scene": "S3"
    },
    {
      "seq": 21,
      "speaker": "旁白",
      "type": "narration",
      "text": "当晚，老板一个人干到十一点。",
      "emotion": "平静",
      "sfx": "",
      "scene": "S4"
    },
    {
      "seq": 22,
      "speaker": "旁白",
      "type": "narration",
      "text": "第二天，制度改了。",
      "emotion": "平静",
      "sfx": "",
      "scene": "S4"
    },
    {
      "seq": 23,
      "speaker": "老板",
      "type": "dialogue",
      "text": "恢复固定工时，九点上班。",
      "emotion": "无语",
      "sfx": "乌鸦",
      "scene": "S4"
    },
    {
      "seq": 24,
      "speaker": "阿强",
      "type": "dialogue",
      "text": "那我明天九点到。",
      "emotion": "平静",
      "sfx": "",
      "scene": "S4"
    },
    {
