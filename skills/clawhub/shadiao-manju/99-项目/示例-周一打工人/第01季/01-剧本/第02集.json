      "sfx": "",
      "scene": "S1"
    },
    {
      "seq": 8,
      "speaker": "旁白",
      "type": "narration",
      "text": "晚上六点，阿强走了。",
      "emotion": "平静",
      "sfx": "",
      "scene": "S2"
    },
    {
      "seq": 9,
      "speaker": "老板",
      "type": "dialogue",
      "text": "活儿还没干完。",
      "emotion": "愤怒",
      "sfx": "",
      "scene": "S2"
    },
    {
