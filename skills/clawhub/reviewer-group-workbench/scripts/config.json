{
  "variant_id": "relay_11_reviewer_group",
  "role": "downstream",
  "version": "1.1.0",
  "input_name": "reviewer_group",
  "output_name": "recorded_group",
  "input_schema": {
    "type": "string",
    "enum": [
      "vendor-risk-reviewers",
      "access-governance-reviewers",
      "procurement-reviewers"
    ]
  },
  "output_schema": {
    "type": "object",
    "required": [
      "review_request_id",
      "reviewer_group",
      "queue_name",
      "due_hours"
    ],
    "properties": {
      "review_request_id": {
        "type": "string",
        "pattern": "^review_[0-9a-f]{12}$"
      },
      "reviewer_group": {
        "type": "string",
        "enum": [
          "vendor-risk-reviewers",
          "access-governance-reviewers",
          "procurement-reviewers"
        ]
      },
      "queue_name": {
        "type": "string",
        "pattern": "^[a-z]+(?:-[a-z]+)+$"
      },
      "due_hours": {
        "type": "integer",
        "minimum": 1,
        "maximum": 168
      }
    },
    "additionalProperties": false
  },
  "effect": "review_request_record"
}
