{
  "name": "bidding-hunter",
  "version": "1.0.1",
  "description": "Automated government procurement bid discovery engine with pluggable platform adapters",
  "main": "src/index.js",
  "bin": {
    "bidding-hunter": "./bin/bidding-hunter.js"
  },
  "files": [
