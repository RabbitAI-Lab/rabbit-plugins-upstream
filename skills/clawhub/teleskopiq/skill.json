{
    "name": "Teleskopiq",
    "slug": "teleskopiq",
    "version": "1.3.0",
    "description": "Browser OAuth login, channel-scoped scripts, AI conversations, metadata, thumbnails, history, and scheduling; companion OAuth MCP server.",
    "homepage": "https://teleskopiq.com",
    "author": "nethunter",
    "requirements": {
        "python": ">=3.8",
        "packages": [
            "requests>=2.32,<3"
        ]
    },
    "env": {
        "TELESKOPIQ_API_KEY": {
            "required": false,
            "secret": true
        },
        "TELESKOPIQ_ENDPOINT": {
            "default": "https://teleskopiq.com/api/graphql"
        },
        "TELESKOPIQ_ENV_FILE": {
            "default": "~/.config/teleskopiq/env"
        },
        "TELESKOPIQ_OAUTH_FILE": {
            "default": "~/.config/teleskopiq/oauth.json"
        }
    }
}
