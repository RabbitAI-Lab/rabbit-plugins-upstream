# 复制本文件为 .env 并填入你自己的凭证；.env 已在 .gitignore 中，勿提交。
# 值只是占位符，请替换为你自己的真实凭证。

# ---- 生成器已有 ----
# 千帆联网搜索（阶段1联网研究）
QIANFAN_WEBSEARCH_API_KEY=你的千帆联网搜索key
# LLM 网关（封面/文稿等，OpenAI 兼容接口）
LLM_GATEWAY_API_KEY=你的LLM网关key

# ---- 抖音口播稿流水线（douyin_transcript.py）新增 ----
# 阿里云智能语音交互（录音文件识别 file-trans）
ALIYUN_AK_ID=你的AccessKeyId
ALIYUN_AK_SECRET=你的AccessKeySecret
NLS_APP_KEY=你的智能语音AppKey
# 阿里云 OSS（存放抽取的音频供 ASR 拉取），建议与 ASR 同区域 cn-shanghai
OSS_BUCKET=你的桶名
OSS_ENDPOINT=oss-cn-shanghai.aliyuncs.com
# LLM 网关 base（口播稿纠错走同一网关，OpenAI 兼容）
LLM_GATEWAY_BASE_URL=https://你的LLM网关/v1
# 外部 TikTokDownloader（GPL，单独 clone，不纳入本仓库）的本地目录绝对路径
TIKTOK_DOWNLOADER_DIR=D:\path\to\TikTokDownloader
