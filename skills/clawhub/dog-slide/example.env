# ================================================================
# Dog Slide — Environment Configuration Example
# ================================================================
# Copy this file to `.env` and fill in your API keys.
# Resolution order: ./.env → skills/dog-slide/.env → ~/.dog-slide/.env
# ================================================================

# ── Active Backend (required) ──────────────────────────────────
# Switch between providers by changing IMAGE_BACKEND only.
# Recommended: apimart / openai / gemini / qwen / zhipu / volcengine
IMAGE_BACKEND=apimart

# ── APIMart (async gpt-image-2, task-based API) ────────────────
# Uses OpenAI-compatible keys with async polling.
OPENAI_BASE_URL=https://apimart.ai/v1/
OPENAI_API_KEY=sk-your-apimart-key-here
OPENAI_MODEL=gpt-image-2

# ── OpenAI / OpenAI-Compatible ─────────────────────────────────
# IMAGE_BACKEND=openai
# OPENAI_API_KEY=sk-xxx
# OPENAI_MODEL=gpt-image-2
# OPENAI_BASE_URL=https://api.openai.com/v1

# ── Gemini ─────────────────────────────────────────────────────
# IMAGE_BACKEND=gemini
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-3.1-flash-image-preview

# ── Qwen (Alibaba Cloud / DashScope) ───────────────────────────
# IMAGE_BACKEND=qwen
# QWEN_API_KEY=your-dashscope-key
# QWEN_MODEL=qwen-image-2.0-pro

# ── Zhipu (GLM-Image) ──────────────────────────────────────────
# IMAGE_BACKEND=zhipu
# ZHIPU_API_KEY=your-zhipu-key
# ZHIPU_MODEL=glm-image

# ── Volcengine (Doubao Seedream) ───────────────────────────────
# IMAGE_BACKEND=volcengine
# VOLCENGINE_API_KEY=your-volcengine-key
# VOLCENGINE_MODEL=doubao-seedream-4-5-251128

# ── MiniMax ────────────────────────────────────────────────────
# IMAGE_BACKEND=minimax
# MINIMAX_API_KEY=your-minimax-key
# MINIMAX_MODEL=image-01
# MINIMAX_BASE_URL=https://api.minimaxi.com/v1/image_generation

# ── Web Image Search (optional) ────────────────────────────────
# Used by image_search.py for sourcing stock photos.
# PEXELS_API_KEY=your-pexels-key
# PIXABAY_API_KEY=your-pixabay-key

# ── TTS / Audio Narration (optional) ───────────────────────────
# Used by notes_to_audio.py for per-slide voiceover.
# ELEVENLABS_API_KEY=your-elevenlabs-key
# MINIMAX_API_KEY=your-minimax-key
