{
  "name": "企服助手",
  "id": "enterprise-service-assistant",
  "version": "2.0.0",
  "description": "专业的园区企业服务智能助手，提供客户管理、费用催缴、工单调度、KPI报告等服务（完全自包含版）",
  "author": "perrykono-debug",
  "emoji": "🏢",
  "workspace": {
    "path": "enterprise-service-assistant",
    "entrypoint": "SKILL.md"
  },
  "capabilities": [
    "客户档案管理和画像分析",
    "费用催缴提醒和跟进",
    "报修工单自动分派",
    "库存监控和补货提醒",
    "合同续租预警",
    "KPI报告自动生成",
    "C+增值服务需求匹配",
    "走访计划管理"
  ],
  "skills": [
    "docx",
    "pdf",
    "xlsx",
    "tencent-docs",
    "online-search"
  ],
  "setup": {
    "steps": [
      "复制 knowledge/TEMPLATE.md → knowledge/PROJECT_KB.md",
      "填写项目名称和数据文件路径",
      "配置企微 Webhook（可选）",
      "验证配置"
    ],
    "required": [
      "项目名称",
      "数据文件路径（Excel）"
    ],
    "optional": [
      "企微 Webhook",
      "通知渠道",
      "隐私规则"
    ]
  },
  "commands": [
    {
      "example": "@企服助手 查询客户 A栋-601",
      "description": "查询客户信息"
    },
    {
      "example": "@企服助手 客户画像 示例企业",
      "description": "查看客户画像"
    },
    {
      "example": "@企服助手 催缴检查",
      "description": "检查费用收缴状态"
    },
    {
      "example": "@企服助手 库存检查",
      "description": "检查库存水位"
    },
    {
      "example": "@企服助手 续租检查",
      "description": "检查合同到期情况"
    },
    {
      "example": "@企服助手 创建工单 A栋-601 水管漏水",
      "description": "创建报修工单"
    }
  ]
}
