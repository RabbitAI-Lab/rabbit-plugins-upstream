{
  "name": "@yottameta/yotta-resume",
  "version": "0.1.3",
  "description": "元简 — 本地求职者简历分析与成品导出技能：分析简历结构、证据、岗位匹配和风险，向用户追问缺失事实，给出逐条合理化修改建议，并把确认后的内容导出为 DOCX/PDF。触发：简历诊断、改简历、简历追问、JD匹配、导出Word/PDF。边界：不编造经历，不承诺ATS/面试/Offer结果；不自动投递；不处理复杂设计作品集排版；默认本地处理且不联网。",
  "license": "MIT",
  "keywords": [
    "agent-skills",
    "yotta-resume",
    "yottaskills",
    "简历诊断",
    "简历分析",
    "简历优化",
    "改简历",
    "求职简历",
    "JD匹配",
    "简历导出",
    "Word简历",
    "PDF简历",
    "resume review",
    "resume analyzer",
    "resume export",
    "job description matching"
  ],
  "files": [
    "SKILL.md",
    "LICENSE",
    "NOTICE",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "assets",
    "data",
    "examples",
    "install.sh",
    "references",
    "scripts",
    "bin",
    "!scripts/test_*.py",
    "!**/__pycache__",
    "!**/*.pyc"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YottaMeta/yotta-resume.git"
  },
  "scripts": {
    "test": "python -m unittest discover -s scripts -p \"test_*.py\""
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "yotta-resume": "bin/install.js"
  }
}
