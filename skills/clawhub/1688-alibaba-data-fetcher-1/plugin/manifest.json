{
  "manifest_version": 3,
  "name": "1688 Data Claw - 数据采集器",
  "version": "1.0.0",
  "description": "采集1688店铺经营数据，为OpenClaw提供结构化数据接口",
  "key": "",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "tabs",
    "background"
  ],
  "externally_connectable": {
    "matches": ["https://*.1688.com/*", "https://1688.com/*"],
    "ids": ["*"]
  },
  "host_permissions": [
    "https://*.1688.com/*",
    "https://1688.com/*",
    "http://localhost:*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.1688.com/*",
        "https://1688.com/*"
      ],
      "js": [
        "md5.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": ["https://*.1688.com/*"]
    }
  ]
}
