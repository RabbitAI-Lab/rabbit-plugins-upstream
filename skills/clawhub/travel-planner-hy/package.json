{
  "name": "travel-planner-hy",
  "version": "1.3.2",
  "description": "Travel itinerary planning, bounded public guide retrieval and local HTML/QR export. No booking, orders or payments.",
  "main": "scripts/generate-trip-page.js",
  "bin": {
    "travel-planner-hy": "scripts/generate-trip-page.js"
  },
  "scripts": {
    "generate-trip": "node scripts/generate-trip-page.js",
    "start": "node scripts/generate-trip-page.js",
    "mock": "node scripts/generate-trip-page.js --mock",
    "test": "node --test tests/*.test.js"
  },
  "keywords": [
    "travel",
    "trip-planning",
    "itinerary",
    "travel-planner",
    "行程规划",
    "旅游"
  ],
  "author": "cryptocxf",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cryptocxf/travel-planner-hy.git"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "os": [
    "win32",
    "darwin",
    "linux"
  ],
  "files": [
    "scripts/",
    "references/",
    "examples/",
    "tests/",
    "SKILL.md",
    "README.md",
    "skill-card.md",
    "package-lock.json",
    ".npmrc"
  ],
  "dependencies": {
    "qrcode": "1.5.4",
    "ipaddr.js": "2.2.0"
  }
}
