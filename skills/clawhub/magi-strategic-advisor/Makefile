# magi-advisor Makefile
# Development entry points for the MAGI Strategic Advisor project
# Usage: make <target>

PYTHON ?= python3

.PHONY: help validate syntax clean

help: ## Show this help
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | \
		awk 'BEGIN {FS = ":.*?## "}; {printf "  make %-10s %s\n", $$1, $$2}'

validate: syntax ## Run the repository contract validator
	$(PYTHON) scripts/validate-project.py

syntax: ## Compile all scripts to catch syntax errors
	$(PYTHON) -m compileall -q scripts

clean: ## Remove generated bytecode and caches
	rm -rf __pycache__ scripts/__pycache__ .pytest_cache
