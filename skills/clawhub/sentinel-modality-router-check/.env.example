SENTINEL_GATEWAY_PORT=8100
# The router.py address the gateway's CUSTOM_PROVIDERS should point at --
# use host.docker.internal, not localhost, since the gateway runs in Docker
# and router.py runs on the host.
ROUTER_BASE_URL=http://host.docker.internal:8200
ROUTER_PROVIDER_NAME=local-router

# Model aliases router.py/LiteLLM are expected to pick for each modality --
# used to confirm each probe actually reached the model it should have,
# not just that redaction happened somewhere.
TEXT_MODEL_ALIAS=qwen-local
VISION_MODEL_ALIAS=smolvlm-local

# Any small PNG/JPG works -- only used to make the second probe contain an
# image_url block so router.py's modality check routes it to the vision leg.
TEST_IMAGE_PATH=./test_image.png

# Optional: if Jaeger is running (docker compose up -d in the main project),
# the skill looks up the resulting trace and includes its ID/URL in the
# report. Leave blank to skip this -- redaction pass/fail never depends on it.
JAEGER_BASE_URL=http://localhost:16686
JAEGER_SERVICE_NAME=router

# Reuse the same values already configured for OpenClaw's Telegram connection --
# no separate bot setup needed, just copy the same token/chat ID here.
# Optional: if left blank, the skill still runs and prints its result to stdout.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
