# 复制成 .env 后填写，然后 chmod 600 .env
# 凭据全部来自你自己的抓包：mixuebingcheng-cli har 抓包.har
MIXUE_TOKEN=
MIXUE_OPENID=
MIXUE_CUSTOMER_ID=
MIXUE_SHOP=

# 签名私钥：本包【自带】一份 App 级密钥，开箱即用
MIXUE_KEY_PATH=./tools/mxbc_key.pem
# 想换成自己的私钥：
#   1) mixuebingcheng-cli key --set /path/to/your_key.pem
#   2) 或内联（换行写成 \n）：
# MIXUE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----"

# 支付策略：只允许礼品卡，其他通道已停用（无任何开关可解锁）

MIXUE_BASE=https://mxsa.mxbc.net
MIXUE_APPID=d82be6bbc1da11eb9dd000163e122ecb
MIXUE_MP_APPID=wx7696c66d2245d107
