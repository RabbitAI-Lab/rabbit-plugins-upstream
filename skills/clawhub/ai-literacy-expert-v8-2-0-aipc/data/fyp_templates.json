  "description": "5 项目 × FYP I/II AI 脚手架（直接降低 6 学分创新门槛）",
  "fyp_i_templates": {
    "weeks_1_to_8": {
      "W1": {
        "task": "选题头脑风暴",
        "ai_tools": ["S3.2 创意生成器", "DeepSeek-R1 本地"],
        "output": "5-10 个候选选题",
        "duration_hours": 4
      },
      "W2": {
        "task": "文献检索",
        "ai_tools": ["S3.3 综述助手", "arXiv / Google Scholar / CNKI"],
        "output": "50-100 篇候选文献",
        "duration_hours": 8
      },
      "W3": {
        "task": "文献阅读（前半）",
        "ai_tools": ["S3.3 自动摘要 + 主题聚类"],
        "output": "5 段式摘要 × 前半文献 + 主题聚类图",
        "duration_hours": 8
      },
      "W4": {
        "task": "文献阅读（后半）",
        "ai_tools": ["S3.3 自动摘要 + 主题聚类"],
        "output": "5 段式摘要 × 后半文献 + 文献综述草稿",
        "duration_hours": 8
      },
      "W5": {
        "task": "研究问题定义",
        "ai_tools": ["DeepSeek-R1 苏格拉底式提问"],
        "output": "1 个具体研究问题",
        "duration_hours": 4
      },
      "W6": {
        "task": "方法论选择",
        "ai_tools": ["S3.4 方法 AI 顾问"],
        "output": "1 套研究方法",
        "duration_hours": 4
      },
      "W7": {
        "task": "实验设计",
        "ai_tools": ["DeepSeek + 导师反馈"],
        "output": "1 份实验设计方案",
        "duration_hours": 8
      },
      "W8": {
        "task": "开题答辩 PPT",
        "ai_tools": ["compose_lesson.py 模板生成"],
        "output": "1 份开题答辩 PPT",
        "duration_hours": 4
      }
    },
    "total_hours_fyp_i": 48
  },
  "fyp_ii_templates": {
    "weeks_1_to_16": {
      "W1-4": {
        "task": "实验/数据采集",
        "ai_tools": ["DeepSeek-R1 + 4 阶段流水线"],
        "output": "1 份完整数据集",
        "duration_hours": 32
      },
      "W5-8": {
        "task": "数据分析",
        "ai_tools": ["Pandas + Scikit-learn + AI 解释"],
        "output": "1 份分析报告 + 可视化",
        "duration_hours": 32
      },
      "W9-12": {
        "task": "论文写作",
        "ai_tools": ["DeepSeek-R1 草稿 + 导师批注"],
        "output": "1 份完整论文草稿",
        "duration_hours": 48
      },
      "W13": {
        "task": "论文润色",
        "ai_tools": ["LLM 语法 + 学术风格"],
        "output": "1 份润色后论文",
        "duration_hours": 8
      },
      "W14": {
        "task": "答辩 PPT",
        "ai_tools": ["compose_lesson.py 模板 + p5.js 互动"],
        "output": "1 份答辩 PPT + 互动 demo",
        "duration_hours": 8
      },
      "W15-16": {
        "task": "模拟答辩",
        "ai_tools": ["AI 模拟提问 + 学生自评"],
        "output": "1 份自评报告",
        "duration_hours": 16
      }
    },
    "total_hours_fyp_ii": 144
  },
