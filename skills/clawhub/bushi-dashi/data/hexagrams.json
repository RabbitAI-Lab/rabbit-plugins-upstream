  },
  "lower": {
   "trigram": "震",
   "nature": "雷"
  },
  "guaci": "震：亨。震来虩虩，笑言哑哑。震惊百里，不丧匕鬯。",
  "yaoci": [
   "震来虩虩，后笑言哑哑，吉。",
   "震来厉，亿丧贝，跻于九陵，勿逐，七日得。",
   "震苏苏，震行无眚。",
   "震遂泥。",
   "震往来厉，亿无丧，有事。",
   "震索索，视矍矍，征凶；震不于其躬，于其邻，无咎；婚媾有言。"
  ],
  "yaoti": [
   "初九",
   "六二",
   "六三",
   "九四",
   "六五",
   "上六"
  ],
  "tone": "bian",
  "yi": "洊雷震惊，惧而后笑",
  "baihua": "震为雷，两雷相叠，一声接一声。此卦讲突如其来的变动与惊惧——但惊惧之后不是乱，是「君子以恐惧修省」。",
  "metaphor": "春雷第一声，惊的是蛰虫，更是大地的瞌睡。",
  "key_yao": [
   {
    "pos": 0,
    "baihua": "雷来先惊后笑——惊是警醒，笑是安定。",
    "why": "震之吉全在这个「惊」字：会怕，说明还醒着；醒着，就来得及。"
   }
  ],
  "ying": {
   "事业": "震是动。客的事此刻像一声春雷要炸——会有响动，别怕。雷过之后雨落尘定，原先看不清的，都清楚了。",
   "姻缘": "两雷相叠，是一声有人应。感情里最贵的是「应」：你一声雷，他一声雷，才叫震。若一头响一头闷，那是憋，不是震。",
   "财运": "雷快，雨慢。震提醒客：别追雷的速度去求财，等雨的滋润。快钱来得像雷，走得也像雷；留下的，是雨润过的。",
   "健康": "震主足、主惊。客的身子或有「坐不住」之病——心跳、气浮、腿闲。方子一个字：定。惊而后定，气自归元。",
   "出行": "震行百里不丧匕鬯。客可行，但手里要有一件「不丧」的东西：旧习惯、旧约定、旧人。带着它，百里雷声不怕。",
   "失物": "震为动，物被「惊动」过。不在原处了——往最近响过、动过、翻过的地方找。雷声就是线索。",
   "心事": "客的心事像一声雷压在舌下。震说：响出来。第一声惊，第二声笑——怕的不是雷，是一辈子憋着。"
  },
  "detail_level": 2
 },
 "36": {
  "key": 36,
  "seq": 52,
  "name": "艮为山",
  "upper": {
   "trigram": "艮",
   "nature": "山"
  },
  "lower": {
   "trigram": "艮",
   "nature": "山"
  },
  "guaci": "艮：艮其背，不获其身。行其庭，不见其人。无咎。",
  "yaoci": [
   "艮其趾，无咎，利永贞。",
   "艮其腓，不拯其随，其心不快。",
   "艮其限，列其夤，厉薰心。",
   "艮其身，无咎。",
   "艮其辅，言有序，悔亡。",
   "敦艮，吉。"
  ],
  "yaoti": [
   "初六",
   "六二",
   "九三",
   "六四",
   "六五",
   "上九"
  ],
  "tone": "ping",
  "yi": "兼山相阻，知止而安",
  "baihua": "艮为山，两山并立，一止接一止。此卦讲「止」——但止不是死，是「时止则止，时行则行」：止得对时候，才是止的真义。",
  "metaphor": "山不追云。云自来，云自去——山得到的，比追的多。",
  "key_yao": [
   {
    "pos": 5,
    "baihua": "止之于终，敦厚而吉。",
    "why": "艮之吉在「止得稳」：多数人停得下，少数人停得住。"
   }
  ],
  "ying": {
   "事业": "艮曰「思不出其位」。客的事此刻宜守不宜攻。山的功夫在站定：先把脚下这块地站稳，云雨自来。",
   "姻缘": "两山相对，各自立。感情里最怕一座山往另一座山上倒。艮教客：先做自己的山，再谈相对。都立住了，相望才是风景。",
   "财运": "山不动，藏自丰。客之财此刻宜存不宜搏。艮曰：止其所止——钱也要有座山靠着，放得住，才长得出。",
   "健康": "艮主背、主手。客的身子或有「停不下」之病：思多、劳多、夜不能止。方子一个字：艮。止不是懒，是山在养力。",
   "出行": "艮曰「不利有攸往」。不是不许行，是此刻不宜。山留客几日——等风定云散，路自现。急行，只遇雾。",
   "失物": "山善留，物被「放」而未失。别找远，找近：你停过的地方、坐过的地方、手放下的地方。艮曰：止者，在此。",
   "心事": "客的心事像一座山压着。艮不搬山，教客面山而坐：坐久了就看见——山是山，你是你；压着的，只是你们之间的云。"
  },
  "detail_level": 2
 },
 "52": {
  "key": 52,
  "seq": 53,
  "name": "风山渐",
  "upper": {
   "trigram": "巽",
   "nature": "风"
  },
  "lower": {
   "trigram": "艮",
   "nature": "山"
  },
  "guaci": "渐：女归吉，利贞。",
  "yaoci": [
   "鸿渐于干，小子厉，有言，无咎。",
   "鸿渐于磐，饮食衎衎，吉。",
   "鸿渐于陆，夫征不复，妇孕不育，凶，利御寇。",
   "鸿渐于木，或得其桷，无咎。",
   "鸿渐于陵，妇三岁不孕，终莫之胜，吉。",
   "鸿渐于陆，其羽可用为仪，吉。"
  ],
  "yaoti": [
   "初六",
   "六二",
   "九三",
   "六四",
   "九五",
   "上九"
  ],
  "tone": "ji",
  "yi": "山上有木，循序渐进",
  "baihua": "",
  "metaphor": "",
