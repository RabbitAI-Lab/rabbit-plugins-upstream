  "seq": 14,
  "name": "火天大有",
  "upper": {
   "trigram": "离",
   "nature": "火"
  },
  "lower": {
   "trigram": "乾",
   "nature": "天"
  },
  "guaci": "大有：元亨。",
  "yaoci": [
   "无交害，匪咎，艰则无咎。",
   "大车以载，有攸往，无咎。",
   "公用亨于天子，小人弗克。",
   "匪其彭，无咎。",
   "厥孚交如，威如，吉。",
   "自天佑之，吉无不利。"
  ],
  "yaoti": [
   "初九",
   "九二",
   "九三",
   "九四",
   "六五",
   "上九"
  ],
