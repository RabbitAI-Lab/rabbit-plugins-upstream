  "ying": {},
  "detail_level": 0
 },
 "11": {
  "key": 11,
  "seq": 54,
  "name": "雷泽归妹",
  "upper": {
   "trigram": "震",
   "nature": "雷"
  },
  "lower": {
   "trigram": "兑",
   "nature": "泽"
  },
  "guaci": "归妹：征凶，无攸利。",
  "yaoci": [
   "归妹以娣，跛能履，征吉。",
   "眇能视，利幽人之贞。",
   "归妹以须，反归以娣。",
   "归妹愆期，迟归有时。",
   "帝乙归妹，其君之袂不如其娣之袂良；月几望，吉。",
   "女承筐无实，士刲羊无血，无攸利。"
  ],
  "yaoti": [
   "初九",
   "九二",
   "六三",
   "九四",
   "六五",
   "上六"
  ],
  "tone": "xiong",
  "yi": "泽上有雷，所归不当",
  "baihua": "",
  "metaphor": "",
  "key_yao": [],
  "ying": {},
  "detail_level": 0
 },
 "13": {
  "key": 13,
  "seq": 55,
  "name": "雷火丰",
  "upper": {
   "trigram": "震",
   "nature": "雷"
  },
  "lower": {
   "trigram": "离",
   "nature": "火"
  },
  "guaci": "丰：亨。王假之，勿忧，宜日中。",
  "yaoci": [
   "遇其配主，虽旬无咎，往有尚。",
   "丰其蔀，日中见斗，往得疑疾，有孚发若，吉。",
   "丰其沛，日中见沫，折其右肱，无咎。",
   "丰其蔀，日中见斗，遇其夷主，吉。",
   "来章，有庆誉，吉。",
   "丰其屋，蔀其家，窥其户，阒其无人，三岁不觌，凶。"
  ],
  "yaoti": [
   "初九",
   "六二",
   "九三",
   "九四",
   "六五",
   "上六"
  ],
  "tone": "bian",
  "yi": "雷电皆至，丰盛宜中",
  "baihua": "",
  "metaphor": "",
