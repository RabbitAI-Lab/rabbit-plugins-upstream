 },
 "44": {
  "key": 44,
  "seq": 56,
  "name": "火山旅",
  "upper": {
   "trigram": "离",
   "nature": "火"
  },
  "lower": {
   "trigram": "艮",
   "nature": "山"
  },
  "guaci": "旅：小亨，旅贞吉。",
  "yaoci": [
   "旅琐琐，斯其所取灾。",
   "旅即次，怀其资，得童仆贞。",
   "旅焚其次，丧其童仆，贞厉。",
   "旅于处，得其资斧，我心不快。",
   "射雉一矢亡，终以誉命。",
   "鸟焚其巢，旅人先笑后号啕，丧牛于易，凶。"
  ],
  "yaoti": [
   "初六",
   "六二",
   "九三",
