 "2": {
  "key": 2,
  "seq": 7,
  "name": "地水师",
  "upper": {
   "trigram": "坤",
   "nature": "地"
  },
  "lower": {
   "trigram": "坎",
   "nature": "水"
  },
  "guaci": "师：贞，丈人吉，无咎。",
  "yaoci": [
   "师出以律，否臧凶。",
   "在师中吉，无咎，王三锡命。",
   "师或舆尸，凶。",
   "师左次，无咎。",
   "田有禽，利执言，无咎；长子帅师，弟子舆尸，贞凶。",
   "大君有命，开国承家，小人勿用。"
  ],
  "yaoti": [
   "初六",
   "九二",
   "六三",
   "六四",
   "六五",
   "上六"
  ],
