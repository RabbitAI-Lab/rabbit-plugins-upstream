 "59": {
  "key": 59,
  "seq": 10,
  "name": "天泽履",
  "upper": {
   "trigram": "乾",
   "nature": "天"
  },
  "lower": {
   "trigram": "兑",
   "nature": "泽"
  },
  "guaci": "履：履虎尾，不咥人，亨。",
  "yaoci": [
   "素履，往无咎。",
   "履道坦坦，幽人贞吉。",
   "眇能视，跛能履，履虎尾，咥人，凶；武人为于大君。",
   "履虎尾，愬愬终吉。",
   "夬履，贞厉。",
   "视履考祥，其旋元吉。"
  ],
  "yaoti": [
   "初九",
   "九二",
   "六三",
   "九四",
   "九五",
   "上九"
  ],
