 "54": {
  "key": 54,
  "seq": 57,
  "name": "巽为风",
  "upper": {
   "trigram": "巽",
   "nature": "风"
  },
  "lower": {
   "trigram": "巽",
   "nature": "风"
  },
  "guaci": "巽：小亨，利有攸往，利见大人。",
  "yaoci": [
   "进退，利武人之贞。",
   "巽在床下，用史巫纷若，吉，无咎。",
   "频巽，吝。",
   "悔亡，田获三品。",
   "贞吉，悔亡，无不利，无初有终；先庚三日，后庚三日，吉。",
   "巽在床下，丧其资斧，贞凶。"
  ],
  "yaoti": [
   "初六",
   "九二",
   "九三",
   "六四",
   "九五",
   "上九"
  ],
  "tone": "ping",
  "yi": "随风入微，申命行事",
  "baihua": "巽为风，两风相随，无孔不入。此卦讲「入」与「顺」——风没有形状，却到得了所有缝隙；因为它不争，所以没有挡得住它的。",
  "metaphor": "风不推门，它从门缝里进来。最软的东西，走最远的路。",
  "key_yao": [
   {
    "pos": 0,
    "baihua": "进退犹豫之时，宜以武人之贞自定。",
    "why": "巽是柔卦，第一爻却讲武人的坚定——柔而不弱，是巽的真义。"
   }
  ],
  "ying": {
   "事业": "巽曰「小亨利」。客此刻不求大功，求小成：把一件小事做透，风就进了一道缝。风的功夫不在一阵，在天天吹。",
   "姻缘": "风入人心，是无声的。客若想说什么，别一次说完；慢慢说，像风进缝。硬灌进去的不是情，是穿堂风。",
   "财运": "巽近利市三倍——但那是风的生意：来往、出入、流通。客之财在「转」，不在「囤」。钱像风，动起来才活。",
   "健康": "风主入。客的身子或有「风入」之患：怕冷、游走之痛。但巽也教：呼吸要像风入谷，慢、深、匀。气顺，身自顺。",
   "出行": "两风相随，利有攸往。客可行，宜顺风：顺水路、顺风候、顺人旧路。逆风费力，顺风迟而必达。",
   "失物": "风善入，物进了「缝」。往夹缝、底下、折叠处找——眼睛平时不进的地方。巽曰：入，而后见。",
   "心事": "客的心事像一缕风，绕在心里不散。巽不催客断，教客随：随它进、随它转、随它出。看清楚了，它自己散。"
  },
  "detail_level": 2
 },
 "27": {
  "key": 27,
  "seq": 58,
  "name": "兑为泽",
  "upper": {
   "trigram": "兑",
   "nature": "泽"
  },
  "lower": {
   "trigram": "兑",
   "nature": "泽"
  },
  "guaci": "兑：亨，利贞。",
  "yaoci": [
   "和兑，吉。",
   "孚兑，吉，悔亡。",
   "来兑，凶。",
   "商兑未宁，介疾有喜。",
   "孚于剥，有厉。",
   "引兑。"
  ],
  "yaoti": [
   "初九",
   "九二",
   "六三",
   "九四",
   "九五",
   "上六"
  ],
  "tone": "ji",
  "yi": "丽泽相滋，和悦相通",
  "baihua": "兑为泽，两泽相连，一悦接一悦。此卦讲「悦」与「言」——泽润万物而人乐道之；悦以先人，人忘其劳。",
  "metaphor": "两泽相连，水互流——给的悦与受的悦，原本是同一汪水。",
  "key_yao": [
   {
    "pos": 1,
    "baihua": "悦而得中，刚中而吉，悔亡。",
    "why": "兑是悦卦，吉爻却在「刚中」——悦怕浮，中则实。"
   }
  ],
  "ying": {
   "事业": "兑是言、是悦。客的事此刻宜「说」：谈、讲、疏通。嘴开一点，事成一半。但兑提醒：悦要有实——空口甜言，是无水之泽。",
   "姻缘": "两泽相连，是兑最好的样子。客与那人，像两汪水：通了，就都活。把悦说出口——悦而不言，泽会干。",
   "财运": "泽润物，财自润中来。客之财在「与人悦」：做的生意让人笑，钱自来。兑曰：先悦，后得。",
   "健康": "兑主口、主肺。客的身子或有「口」之患：食不甘，或言太多。方子：慢食、慢言、多笑。悦，是兑最好的药。",
   "出行": "兑曰君子以朋友讲习。客之行宜结伴：两人一路，话半程，悦半程。独行，景再好也少一半。",
   "失物": "泽低而敞，物不藏，是「忘」。问人——兑是言之卦：开口问，比低头找快。有人见过，只是没人说。",
   "心事": "客的心事写着写着，笔尖带了悦。兑看见：客所求的，不过是一个能把这悦说给人听的地方。说吧。泽不拒任何一条溪。"
  },
  "detail_level": 2
 },
 "50": {
