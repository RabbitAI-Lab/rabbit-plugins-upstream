{
 "63": {
  "key": 63,
  "seq": 1,
  "name": "乾为天",
  "upper": {
   "trigram": "乾",
   "nature": "天"
  },
  "lower": {
   "trigram": "乾",
   "nature": "天"
  },
  "guaci": "乾：元亨利贞。",
  "yaoci": [
   "潜龙勿用。",
   "见龙在田，利见大人。",
   "君子终日乾乾，夕惕若厉，无咎。",
   "或跃在渊，无咎。",
   "飞龙在天，利见大人。",
   "亢龙有悔。"
  ],
  "yaoti": [
   "初九",
   "九二",
   "九三",
   "九四",
   "九五",
   "上九"
  ],
  "tone": "ji",
  "yi": "天行刚健，自强不息",
  "baihua": "乾六爻皆阳，像天行不息。从潜龙到亢龙，每一步都有它的时位。此卦不教人猛冲，教人认清「自己此刻在哪一步」。",
  "metaphor": "同一条龙：潜于渊是养，飞于天是成——龙没变，变的是时与位。",
  "key_yao": [
   {
    "pos": 0,
    "baihua": "时机未到，宜潜藏蓄势，不可轻动。",
    "why": "乾的第一爻先讲「勿用」——一切开始之前，先学会等。"
   },
   {
    "pos": 5,
    "baihua": "居高位而不知退，必有悔吝。",
    "why": "乾的最后一爻不是吉——先生把这一爻留给所有站在高处的人。"
   }
  ],
  "ying": {
   "事业": "客问事业。乾曰「君子终日乾乾」——但注意，乾乾之前还有「潜龙勿用」。若客此刻在潜龙之时，别硬飞；若在飞龙之时，别自缚。",
   "姻缘": "乾是全阳，刚得很。感情里最怕只有刚没有柔。此卦提醒客：做对方的天，也要学会做云——天容云来去，才是天的度量。",
   "财运": "乾不言财，言「与时偕行」。财如潮水，涨时不必狂喜，退时不必惊慌。此卦给客的不是发财法，是等潮的定力。",
   "健康": "全阳者气盛，气盛者易耗。乾之戒在「亢龙有悔」——身子若是一张拉满的弓，学着松半分弦。",
   "出行": "天行健，行者亦当健。但乾亦曰「或跃在渊」——可进可退，先试水深再动身，路就稳了。",
   "失物": "乾为天，物不失于外，失于「藏」。潜龙在渊，不必急寻；时机一到，它自己露面。真正丢的，多半是客的心神。",
   "心事": "客把这句话写下来的时候，手是稳的。乾不答是与不是，只问一句：你此刻在第几爻？潜、见、跃、飞——各有其时。知位，心就定了。"
  },
  "detail_level": 2,
  "yong": "见群龙无首，吉。"
 },
 "0": {
  "key": 0,
  "seq": 2,
  "name": "坤为地",
  "upper": {
   "trigram": "坤",
   "nature": "地"
  },
  "lower": {
   "trigram": "坤",
   "nature": "地"
  },
  "guaci": "坤：元亨，利牝马之贞。君子有攸往，先迷后得主。利西南得朋，东北丧朋。安贞吉。",
  "yaoci": [
   "履霜，坚冰至。",
   "直方大，不习无不利。",
   "含章可贞，或从王事，无成有终。",
   "括囊，无咎无誉。",
   "黄裳，元吉。",
   "龙战于野，其血玄黄。"
  ],
  "yaoti": [
   "初六",
   "六二",
   "六三",
   "六四",
   "六五",
   "上六"
  ],
  "tone": "ji",
  "yi": "地势厚重，以德载物",
  "baihua": "坤六爻皆阴，像大地沉默承载万物。它不争先，却从不缺席。此卦教人「顺」与「承」的大用——柔不是弱，是另一种力。",
  "metaphor": "天给命令，地来成全——地从不说「这是我的功劳」，可万物都从它身上长出来。",
  "key_yao": [
   {
    "pos": 0,
    "baihua": "脚下踩到霜，便知坚冰将至。",
    "why": "坤的第一爻讲征兆——所有大事，都起于一个不起眼的小迹象。"
   },
   {
    "pos": 5,
    "baihua": "阴盛极而与阳争，两败俱伤。",
    "why": "最柔的卦里藏着一爻「战」——柔也有柔的边界，过界则争。"
   }
  ],
  "ying": {
   "事业": "坤曰「先迷后得主」。客此刻若在做辅佐之事，把辅佐做透，功自然归你；若硬要抢先，便是履霜求冰——急不得。",
   "姻缘": "坤是地，德在承载。但承载不是吞声。此卦告诉客：做厚土，也要做长草木的厚土——有生长的承载，才是活的承载。",
   "财运": "坤不求快财，求积财。地不择土，故能成其大。客之财在「不择」：小钱、慢钱、长钱，都接得住。",
   "健康": "地德在静。坤给客的身子开两个字：养、藏。别扰动阳气，别耗散阴精；像冬天的地，捂着，开春自有力气。",
   "出行": "坤曰「利西南」——往暖处去、往熟人处去。路上多随人、少带头；随顺，是这一程的护身符。",
   "失物": "地载万物，物不失，是「放」。坤曰西南得朋——往熟悉的、温热的地方找；别去生冷的角落翻。",
   "心事": "客的心事写在纸上，字却沉得像土。坤不催客动，先教客承：承得住，才动得了。承稳了，路自己出来。"
  },
  "detail_level": 2,
  "yong": "利永贞。"
 },
 "17": {
  "key": 17,
  "seq": 3,
  "name": "水雷屯",
  "upper": {
   "trigram": "坎",
   "nature": "水"
  },
  "lower": {
   "trigram": "震",
   "nature": "雷"
  },
  "guaci": "屯：元亨利贞，勿用有攸往，利建侯。",
  "yaoci": [
   "磐桓，利居贞，利建侯。",
   "屯如邅如，乘马班如，匪寇婚媾；女子贞不字，十年乃字。",
   "即鹿无虞，惟入于林中；君子几不如舍，往吝。",
   "乘马班如，求婚媾，往吉，无不利。",
   "屯其膏，小贞吉，大贞凶。",
   "乘马班如，泣血涟如。"
  ],
  "yaoti": [
   "初九",
   "六二",
   "六三",
   "六四",
   "九五",
   "上六"
  ],
  "tone": "bian",
  "yi": "万物始生，艰难破土",
  "baihua": "",
  "metaphor": "",
  "key_yao": [],
  "ying": {},
  "detail_level": 0
 },
 "34": {
  "key": 34,
  "seq": 4,
  "name": "山水蒙",
  "upper": {
   "trigram": "艮",
   "nature": "山"
  },
  "lower": {
   "trigram": "坎",
   "nature": "水"
  },
  "guaci": "蒙：亨。匪我求童蒙，童蒙求我。初筮告，再三渎，渎则不告。利贞。",
  "yaoci": [
   "发蒙，利用刑人，用说桎梏，以往吝。",
   "包蒙吉，纳妇吉，子克家。",
   "勿用取女，见金夫，不有躬，无攸利。",
   "困蒙，吝。",
   "童蒙，吉。",
   "击蒙，不利为寇，利御寇。"
  ],
  "yaoti": [
   "初六",
   "九二",
   "六三",
   "六四",
   "六五",
   "上九"
  ],
  "tone": "ping",
  "yi": "山下出泉，求师启蒙",
  "baihua": "",
  "metaphor": "",
  "key_yao": [],
  "ying": {},
  "detail_level": 0
 },
 "23": {
  "key": 23,
  "seq": 5,
  "name": "水天需",
  "upper": {
   "trigram": "坎",
   "nature": "水"
  },
  "lower": {
   "trigram": "乾",
   "nature": "天"
  },
  "guaci": "需：有孚，光亨，贞吉，利涉大川。",
  "yaoci": [
   "需于郊，利用恒，无咎。",
   "需于沙，小有言，终吉。",
   "需于泥，致寇至。",
   "需于血，出自穴。",
   "需于酒食，贞吉。",
   "入于穴，有不速之客三人来，敬之终吉。"
  ],
  "yaoti": [
   "初九",
   "九二",
   "九三",
   "六四",
   "九五",
   "上六"
  ],
  "tone": "ji",
  "yi": "云上于天，蓄势待雨",
  "baihua": "",
  "metaphor": "",
  "key_yao": [],
  "ying": {},
  "detail_level": 0
