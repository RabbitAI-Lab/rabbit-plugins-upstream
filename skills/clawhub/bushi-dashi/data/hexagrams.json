  },
  "lower": {
   "trigram": "离",
   "nature": "火"
  },
  "guaci": "既济：亨小，利贞。初吉终乱。",
  "yaoci": [
   "曳其轮，濡其尾，无咎。",
   "妇丧其茀，勿逐，七日得。",
   "高宗伐鬼方，三年克之，小人勿用。",
   "繻有衣袽，终日戒。",
   "东邻杀牛，不如西邻之禴祭，实受其福。",
   "濡其首，厉。"
  ],
