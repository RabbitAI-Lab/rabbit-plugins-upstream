 "4": {
  "key": 4,
  "seq": 15,
  "name": "地山谦",
  "upper": {
   "trigram": "坤",
   "nature": "地"
  },
  "lower": {
   "trigram": "艮",
   "nature": "山"
  },
  "guaci": "谦：亨，君子有终。",
  "yaoci": [
   "谦谦君子，用涉大川，吉。",
   "鸣谦，贞吉。",
   "劳谦，君子有终，吉。",
   "无不利，撝谦。",
   "不富以其邻，利用侵伐，无不利。",
   "鸣谦，利用行师，征邑国。"
  ],
  "yaoti": [
   "初六",
   "六二",
   "九三",
   "六四",
   "六五",
   "上六"
  ],
