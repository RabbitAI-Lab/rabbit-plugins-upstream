 "58": {
  "key": 58,
  "seq": 6,
  "name": "天水讼",
  "upper": {
   "trigram": "乾",
   "nature": "天"
  },
  "lower": {
   "trigram": "坎",
   "nature": "水"
  },
  "guaci": "讼：有孚窒惕，中吉，终凶。利见大人，不利涉大川。",
  "yaoci": [
   "不永所事，小有言，终吉。",
   "不克讼，归而逋，其邑人三百户，无眚。",
   "食旧德，贞厉，终吉；或从王事，无成。",
   "不克讼，复即命，渝安贞，吉。",
   "讼，元吉。",
   "或锡之鞶带，终朝三褫之。"
  ],
  "yaoti": [
   "初六",
   "九二",
   "六三",
   "九四",
   "九五",
   "上九"
  ],
  "tone": "xiong",
  "yi": "天水相违，争讼将起",
  "baihua": "",
  "metaphor": "",
