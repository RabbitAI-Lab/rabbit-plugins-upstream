 "8": {
  "key": 8,
  "seq": 16,
  "name": "雷地豫",
  "upper": {
   "trigram": "震",
   "nature": "雷"
  },
  "lower": {
   "trigram": "坤",
   "nature": "地"
  },
  "guaci": "豫：利建侯行师。",
  "yaoci": [
   "鸣豫，凶。",
   "介于石，不终日，贞吉。",
   "盱豫，悔；迟有悔。",
   "由豫，大有得；勿疑，朋盍簪。",
