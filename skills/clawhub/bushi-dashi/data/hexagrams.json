 "56": {
  "key": 56,
  "seq": 12,
  "name": "天地否",
  "upper": {
   "trigram": "乾",
   "nature": "天"
  },
  "lower": {
   "trigram": "坤",
   "nature": "地"
  },
  "guaci": "否：否之匪人，不利君子贞。大往小来。",
  "yaoci": [
   "拔茅茹，以其汇，贞吉亨。",
   "包承，小人吉，大人否亨。",
   "包羞。",
   "有命无咎，畴离祉。",
   "休否，大人吉；其亡其亡，系于苞桑。",
   "倾否，先否后喜。"
  ],
  "yaoti": [
   "初六",
   "六二",
   "六三",
   "九四",
   "九五",
   "上九"
  ],
  "tone": "xiong",
  "yi": "天地不交，其道闭塞",
