 "55": {
  "key": 55,
  "seq": 9,
  "name": "风天小畜",
  "upper": {
   "trigram": "巽",
   "nature": "风"
  },
  "lower": {
   "trigram": "乾",
   "nature": "天"
  },
  "guaci": "小畜：亨，密云不雨，自我西郊。",
  "yaoci": [
   "复自道，何其咎，吉。",
   "牵复，吉。",
   "舆说辐，夫妻反目。",
   "有孚，血去惕出，无咎。",
   "有孚挛如，富以其邻。",
   "既雨既处，尚德载，妇贞厉；月几望，君子征凶。"
  ],
  "yaoti": [
   "初九",
   "九二",
   "九三",
   "六四",
   "九五",
   "上九"
  ],
  "tone": "ping",
  "yi": "风行天上，密云不雨",
  "baihua": "",
