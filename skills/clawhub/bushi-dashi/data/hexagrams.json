 "16": {
  "key": 16,
  "seq": 8,
  "name": "水地比",
  "upper": {
   "trigram": "坎",
   "nature": "水"
  },
  "lower": {
   "trigram": "坤",
   "nature": "地"
  },
  "guaci": "比：吉。原筮元永贞，无咎。不宁方来，后夫凶。",
  "yaoci": [
   "有孚比之，无咎；有孚盈缶，终来有它，吉。",
   "比之自内，贞吉。",
   "比之匪人。",
   "外比之，贞吉。",
   "显比，王用三驱，失前禽，邑人不诫，吉。",
   "比之无首，凶。"
  ],
  "yaoti": [
   "初六",
   "六二",
   "六三",
   "六四",
   "九五",
   "上六"
  ],
  "tone": "ji",
  "yi": "水附于地，亲比相辅",
