 "18": {
  "key": 18,
  "seq": 29,
  "name": "坎为水",
  "upper": {
   "trigram": "坎",
   "nature": "水"
  },
  "lower": {
   "trigram": "坎",
   "nature": "水"
  },
  "guaci": "习坎：有孚维心亨，行有尚。",
  "yaoci": [
   "习坎，入于坎窞，凶。",
   "坎有险，求小得。",
   "来之坎坎，险且枕，入于坎窞，勿用。",
   "樽酒簋贰，用缶，纳约自牖，终无咎。",
   "坎不盈，祗既平，无咎。",
   "系用徽纆，寘于丛棘，三岁不得，凶。"
  ],
  "yaoti": [
   "初六",
   "九二",
   "六三",
   "六四",
   "九五",
   "上六"
  ],
  "tone": "xiong",
  "yi": "水洊至，重险当前",
  "baihua": "坎为水，两水相叠，一险未平一险又起。此卦不讳言险，它直说：你此刻在水里。但水有水的路——流而不盈，行而不失信。",
  "metaphor": "水遇到崖就成瀑，遇到谷就成湖——它从不跟地形争，却从未停下走路。",
  "key_yao": [
   {
    "pos": 1,
    "baihua": "险中不求大得，先求小得脱身。",
    "why": "坎的中爻教人把目标放小——险境里，活着就是最大的得。"
   }
  ],
  "ying": {
   "事业": "坎是险。客的事此刻像在水里走。不求有功，先求不沉。水教人：别乱扑腾，顺着流踩稳；踩到浅处，再起身。",
   "姻缘": "两水相叠，情深似潭。深是好事，但坎提醒：深水寒。客若把心藏太深、话太冷，对方摸不到底。给一点光进去。",
   "财运": "水主流，不主聚。客之财此刻像峡中水：进得多，漏得也多。先堵漏，再谈引水。坎不许财，许「不失」。",
   "健康": "坎主肾、主耳、主忧。客的身子或有「寒湿」之患。方子两个字：温、行。水怕停怕冷，温而行，险自平。",
   "出行": "坎曰利涉大川——但先备舟楫。客可行，慎选水路、慎选同行、慎选时节。水不淹谨慎的人，只试冒失的人。",
   "失物": "水善藏，物进了「低暗湿」处。往水边、地面、角落找。坎曰：藏者不失，水退自见。",
   "心事": "客的心事像夜渡一条河。坎不告诉客岸在哪，只说：别乱扑腾，别丢手里那件东西。踩着水，一步一停，岸自己到。"
  },
  "detail_level": 2
 },
 "45": {
  "key": 45,
  "seq": 30,
  "name": "离为火",
  "upper": {
   "trigram": "离",
   "nature": "火"
  },
  "lower": {
   "trigram": "离",
   "nature": "火"
  },
  "guaci": "离：利贞，亨。畜牝牛，吉。",
  "yaoci": [
   "履错然，敬之无咎。",
   "黄离，元吉。",
   "日昃之离，不鼓缶而歌，则大耋之嗟，凶。",
   "突如其来如，焚如，死如，弃如。",
   "出涕沱若，戚嗟若，吉。",
   "王用出征，有嘉折首，获匪其丑，无咎。"
  ],
  "yaoti": [
   "初九",
   "六二",
   "九三",
   "九四",
   "六五",
   "上九"
  ],
  "tone": "ping",
  "yi": "明两相继，附丽正道",
  "baihua": "离为火，两火相明，一光接一光。但火没有自己的身子——它必须附于木、附于油、附于什么，才烧得起来。此卦讲「附」与「明」。",
  "metaphor": "灯之明，不是芯的功劳，也不是油的功劳，是两者不相弃的功劳。",
  "key_yao": [
   {
    "pos": 1,
    "baihua": "附丽而得中道，如黄离之吉。",
    "why": "火最怕烧得野；中道是它的灯罩——罩住，光才久。"
   }
  ],
  "ying": {
   "事业": "离是明。客的才此刻像火，看得见。但离提醒：火要有附。附在一件值得的事上、一个稳的人上，火才烧得久；烧空，只是一瞬亮。",
   "姻缘": "两火相明，情亮如昼。好。但离亦曰：火近则灼。客若爱得太亮太烫，给对方留一点荫——有荫的亮，才是暖。",
   "财运": "火主明，不主藏。客之财此刻像手里的灯：照路是它的用，囤油不是。该花的照亮，该省的添芯，财自有义。",
   "健康": "离主心、主目。客的身子或有「火旺」之患：心烦、眼干、眠浅。方子一个字：润。火怕燥，润则明而不烈。",
   "出行": "离为南方之卦，利向明。客可行，宜往亮处去、见亮人。夜里留一盏灯，心里留一盏——火护惜火的人。",
   "失物": "火善照，物不失，是「掩」。点灯再找一遍：高处、明处、近热处。离曰：明复，物自现。",
   "心事": "客的心事像一盏灯焰：亮，但有点晃。离不吹它，也不添油，只说：看清它附在什么上。附对了，晃只是风。"
  },
  "detail_level": 2
 },
