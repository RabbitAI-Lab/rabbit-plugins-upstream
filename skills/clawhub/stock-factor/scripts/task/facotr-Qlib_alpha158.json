    "factor_dict":{
        "KMID": "ac=d['close']*d['adj_factor']; ao=d['open']*d['adj_factor']; out=(ac-ao)/ao",
        "KLEN": "ac=d['close']*d['adj_factor']; ao=d['open']*d['adj_factor']; ah=d['high']*d['adj_factor']; al=d['low']*d['adj_factor']; out=(ah-al)/ao",
        "KMID2": "ac=d['close']*d['adj_factor']; ao=d['open']*d['adj_factor']; ah=d['high']*d['adj_factor']; al=d['low']*d['adj_factor']; out=(ac-ao)/(ah-al+1e-12)",
        "KUP": "ac=d['close']*d['adj_factor']; ao=d['open']*d['adj_factor']; ah=d['high']*d['adj_factor']; out=(ah-np.maximum(ao,ac))/ao",
