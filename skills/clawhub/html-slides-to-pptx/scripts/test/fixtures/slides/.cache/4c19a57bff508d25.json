pha":100},"border":{"hex":"E5E5E0","width":1},"radius":0,"shadow":false,"z":22},{"kind":"shape","shape":"rect","rect":{"x":100,"y":724,"w":8,"h":126},"fill":{"hex":"F39800","alpha":100},"border":null,"radius":0,"shadow":false,"z":23},{"kind":"text","rect":{"x":140,"y":748,"w":150,"h":69},"runs":[{"text":"03","color":"F39800","bold":true,"size":60}],"align":"left","valign":"middle","letterSpacing":-2,"lineHeightPx":69,"singleLine":true,"vertical":false,"fontFace":"Inter","z":24},{"kind":"text","rect":{"x":320,"y":762,"w":200,"h":43.1875},"runs":[{"text":"行动","color":"0A2C63","bold":true,"size":36}],"align":"left","valign":"middle","letterSpacing":0,"lineHeightPx":43.199999999999996,"singleLine":true,"vertical":false,"fontFace":"Noto Sans SC","z":25},{"kind":"text","rect":{"x":548,"y":752,"w":920,"h":33.796875},"runs":[{"text":"找到你的\"高杠杆用法\"","color":"0A2C63","bold":true,"size":26}],"align":"left","valign":"middle","letterSpacing":0,"lineHeightPx":33.800000000000004,"singleLine":true,"vertical":false,"fontFace":"Noto Sans SC","z":26},{"kind":"text","rect":{"x":548,"y":793.796875,"w":920,"h":30},"runs":[{"text":" 会议纪要 · 报告初稿 · 数据分析 · 邮件起草 · 信息调研——把重复工作外包给 AI。 ","color":"5A5A5A","bold":false,"size":20}],"align":"left","valign":"middle","letterSpacing":0,"lineHeightPx":30,"singleLine":true,"vertical":false,"fontFace":"Noto Sans SC","z":27},{"kind":"text","rect":{"x":1490,"y":760,"w":310,"h":55},"runs":[{"text":"2.4","color":"F39800","bold":true,"size":50},{"text":"×","color":"F39800","bold":true,"size":28}],"align":"right","valign":"middle","letterSpacing":0,"lineHeightPx":55.00000000000001,"singleLine":true,"vertical":false,"fontFace":"Inter","z":28},{"kind":"text","rect":{"x":1490,"y":819,"w":310,"h":24},"runs":[{"text":"AI 增强团队生产力提升","color":"8A8A8A","bold":false,"size":16}],"align":"right","valign":"middle","letterSpacing":0,"lineHeightPx":null,"singleLine":true,"vertical":false,"fontFace":"Noto Sans SC","z":29},{"kind":"shape","shape":"rect","rect":{"x":100,"y":864,"w":1722,"h":128},"fill":{"hex":"FFFFFF","alpha":100},"border":{"hex":"E5E5E0","width":1},"radius":0,"shadow":false,"z":30},{"kind":"shape","shape":"rect","rect":{"x":100,"y":864,"w":8,"h":126},"fill":{"hex":"0A2C63","alpha":100},"border":null,"radius":0,"shadow":false,"z":31},{"kind":"text","rect":{"x":140,"y":888,"w":150,"h":69},"runs":[{"text":"04","color":"0A2C63","bold":true,"size":60}],"align":"left","valign":"middle","letterSpacing":-2,"lineHeightPx":69,"singleLine":true,"vertical":false,"fontFace":"Inter","z":32},{"kind":"text","rect":{"x":320,"y":902,"w":200,"h":43.1875},"runs":[{"text":"边界","color":"0A2C63","bold":true,"size":36}],"align":"left","valign":"middle","letterSpacing":0,"lineHeightPx":43.199999999999996,"singleLine":true,"vertical":false,"fontFace":"Noto Sans SC","z":33},{"kind":"text","rect":{"x":548,"y":892,"w":920,"h":33.796875},"runs":[{"text":"把 AI 当\"聪明但需要指导的实习生\"","color":"0A2C63","bold":true,"size":26}],"align":"left","valign":"middle","letterSpacing":0,"lineHeightPx":33.800000000000004,"singleLine":true,"vertical":false,"fontFace":"Noto Sans SC","z":34},{"kind":"text","rect":{"x":548,"y":933.796875,"w":920,"h":30},"runs":[{"text":" 始终审核后再分享 · 保护敏感数据 · 保持批判性思维——它会\"一本正经地胡说八道\"。 ","color":"5A5A5A","bold":false,"size":20}],"align":"left","valign":"middle","letterSpacing":0,"lineHeightPx":30,"singleLine":true,"vertical":false,"fontFace":"Noto Sans SC","z":35},{"kind":"text","rect":{"x":1490,"y":896,"w":310,"h":28.59375},"runs":[{"text":"审核 · 保密 · 标注","color":"0A2C63","bold":true,"size":22}],"align":"right","valign":"middle","letterSpacing":0,"lineHeightPx":28.6,"singleLine":true,"vertical":false,"fontFace":"Noto Sans SC","z":36},{"kind":"text","rect":{"x":1490,"y":928.59375,"w":310,"h":24},"runs":[{"text":"人机协作的三条纪律","color":"8A8A8A","bold":false,"size":16}],"align":"right","valign":"middle","letterSpacing":0,"lineHeightPx":null,"singleLine":true,"vertical":false,"fontFace":"Noto Sans SC","z":37},{"kind":"text","rect":{"x":100,"y":1016,"w":1720,"h":37},"runs":[{"text":" 主动的人放大 AI · 被动的人被 AI 甩开 ","color":"13489D","bold":true,"size":26}],"align":"center","valign":"middle","letterSpacing":1,"lineHeightPx":null,"singleLine":true,"vertical":false,"fontFace":"Noto Sans SC","z":38}],"notes":"【核心逻辑】第一页讲的是\"世界变了\"，这一页要回答的是\"所以我该怎么做\"。给新员工的建议，最忌讳空洞——所以我按\"心态→素养→行动→边界\"四步阶梯来讲：先安顿情绪、再补基本功、再给具体动作、最后划红线。中间那句金句是整场分享的记忆锚点，如果大家什么都忘了，请记住这一句。\n\n【开场金句 · 30秒】我先把今天最重要的一句话放在这里——\"AI 从工具变成同事，你不是被替代，你是被放大。\"看到刚才那些数据，很多人会紧张：AI 这么强，我会不会被淘汰？我想告诉大家的是：AI 不是来抢你饭碗的，它是来给你装外骨骼的。研究显示，只有 8% 的企业因为 AI 减员，绝大多数是在用 AI 增强员工，而不是取代员工。\n\n【第一步 · 心态 · 30秒】所以第一步是心态。你的核心竞争力是什么？是创造力、是判断力、是跟客户建立信任的能力、是理解业务战略的能力——这些恰恰是 AI 做不好的。积极使用 AI 的员工，工作满意度反而提升了 23%，因为他们把琐碎工作交出去了，留下的都是有意思的事。\n\n【第二步 · 素养 · 30秒】第二步是素养。就像过去 20 年\"会用电脑\"从加分项变成基本功，接下来\"会用 AI\"也一样。你不需要成为工程师，但你必须理解三件事：AI 擅长什么、它在哪里容易出错、怎么负责任地用它。LinkedIn 数据显示，AI 相关岗位是全球增长最快的——无论你在哪个岗位，主动学 AI，你的职业曲线会陡得多。\n\n【第三步 · 行动 · 40秒】第三步最重要——今天就动手。别等培训、别等制度、别等别人先用。从最小的地方开始：开完会让 AI 帮你写纪要、写报告让 AI 出初稿、做分析让 AI 先跑一遍逻辑、发英文邮件让 AI 润色。问自己一个问题：\"我每天有哪些重复动作，可以交给 AI？\"数据显示，用 AI 增强工作流的团队，生产力提升 2.4 倍。这不是\"节省一点时间\"，这是能不能跟上团队节奏的问题。\n\n【第四步 · 边界 · 30秒】第四步是边界，也是最容易被忽略的。AI 会\"一本正经地胡说八道\"——它可以给你写一份看起来完美的报告，但里面的数据可能是编的。所以三条纪律：第一，AI 生成的内容必须自己审核后再对外发送；第二，公司和客户的敏感数据不能随便贴进 AI；第三，AI 辅助的内容要明确标注。把 AI 当成一个聪明但刚入职的实习生——很有想法，但你得盯着他。\n\n【收尾金句 · 15秒】最后送大家一句话：主动的人放大 AI，被动的人被 AI 甩开。今天开始，选一个具体的场景用起来。谢谢大家。","canvasBg":"FAFAF7"}