# Copy to `.env` and fill in real values. Never commit real keys.
# These are read by call_tcm.py at startup. The LLM never sees them.
# May share the same AK/SK as the skin-pro skill (same RageHealth account).

TCM_AK=replace_with_16_byte_access_key
TCM_SK=replace_with_16_or_24_or_32_byte_secret_key
