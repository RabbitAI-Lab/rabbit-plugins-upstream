{
  "name": "@hjs-foundation/jep-guard",
  "version": "3.0.0",
  "description": "Local authenticated policy gate and signed audit events for OpenClaw",
  "main": "dist/sdk/index.js",
  "types": "dist/sdk/index.d.ts",
  "bin": {
    "jep-guard": "bin/jep-guard"
  },
  "files": [
    "dist/",
    "bin/",
    "scripts/",
    "schemas/",
    "skill.yaml",
    "openclaw.hooks.js",
    "README.md",
    "LICENSE",
    "transport.js"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli/index.js daemon --mode full",
    "dev": "ts-node src/cli/index.ts",
    "test": "jest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "commander": "12.1.0",
    "inquirer": "8.2.7",
    "tweetnacl": "1.0.3",
    "canonicalize": "2.1.0"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/uuid": "9.0.8",
    "typescript": "5.9.3",
    "ts-node": "10.9.2",
    "jest": "29.7.0",
    "ts-jest": "29.4.12",
    "@types/jest": "29.5.14",
    "@types/inquirer": "8.2.12"
  },
  "peerDependencies": {
    "openclaw": ">=1.0.0"
  },
  "keywords": [
    "jep",
    "guard",
    "causal-gate",
    "skill-os",
    "audit",
    "openclaw",
    "aegis",
    "agent",
    "accountability",
    "security"
  ],
  "license": "MIT-0",
  "repository": "https://github.com/hjs-foundation/jep-guard",
  "homepage": "https://clawhub.ai/hjs-foundation/jep-guard",
  "bugs": "https://github.com/hjs-foundation/jep-guard/issues",
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  }
