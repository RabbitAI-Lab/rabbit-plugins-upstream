# iran-chem-database — example environment file
#
# Copy to .env and fill in. NEVER commit the real .env (it is gitignored).
#   cp .env.example .env
#
# Any config.yaml value can also be overridden with IRANCHEM__SECTION__KEY.

# ---------------------------------------------------------------------------
# Database (required) — substituted into config.yaml `database.password`
# ---------------------------------------------------------------------------
DB_PASSWORD=change-this-to-a-long-random-password

# Optional: full override of the Redis URL used by Celery.
# IRANCHEM__REDIS__URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Supplier discovery (optional)
# ---------------------------------------------------------------------------
# SerpAPI / Google CSE key used to discover new supplier domains.
# Leave empty to disable discovery; crawling configured sources still works.
SEARCH_API_KEY=

# ---------------------------------------------------------------------------
# AI normalization hop chain (all optional)
# ---------------------------------------------------------------------------
# src/utils/ai_hopchain.py normalises Persian/English listing text into a
# molecule identity. It tries the local Arena router first, then these
# providers in order, with failover. Every AI result is independently
# confirmed against PubChem — the models never invent rows.
#
# NOTE: enabling these sends CRAWLED LISTING TEXT to third-party APIs.
# Leave them blank to keep all listing text on this machine.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
LLM7_API_KEY=
LLM7_BASE_URL=

# Path to the local Arena router script (checked before any cloud provider).
# ICDB_ROUTER=/home/user/tools/router.py

# ---------------------------------------------------------------------------
# Caching (optional)
# ---------------------------------------------------------------------------
# Override the on-disk PubChem resolver cache, which makes re-parses free.
# ICDB_PUBCHEM_CACHE=data/seed_export/pubchem_cache.json
