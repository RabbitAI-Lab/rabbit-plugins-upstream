{
  "family": "suspicious-download",
  "version": 1,
  "rules": [
    {
      "id": "dl-00",
      "re": "(?:zip|7z|rar)\\b[^\\n]{0,500}\\s[-]?P\\b|unzip\\b[^\\n]{0,500}-P\\b|7z\\s+x[^\\n]{0,500}-p\\w",
      "label": "密码保护的压缩包（隐藏载荷）",
      "sev": "P1",
      "flags": "I"
    },
    {
      "id": "dl-01",
      "re": "(?:curl|wget)[^\\n]{0,500}https?://\\d{1,3}(?:\\.\\d{1,3}){3}(?!\\d)",
      "label": "从裸 IP 下载",
      "sev": "P1",
      "flags": "I"
    },
    {
      "id": "dl-02",
      "re": "curl[^\\n]{0,500}-k\\b|wget[^\\n]{0,500}--no-check-certificate",
      "label": "跳过证书校验下载",
      "sev": "P2",
      "flags": "I"
    },
    {
      "id": "dl-03",
      "re": "(?:curl|wget)[^\\n]{0,500}\\|(?:sudo|tee)\\b",
      "label": "下载并写入系统路径",
      "sev": "P1",
      "flags": "I"
    },
    {
      "id": "dl-04",
      "re": "npx\\s+(?:-y|--yes)\\b",
      "label": "npx --yes 跳过确认自动下载执行",
      "sev": "P1",
      "flags": "I"
    }
  ]
}
