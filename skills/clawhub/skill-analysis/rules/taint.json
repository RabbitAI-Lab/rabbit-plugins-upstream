{
  "family": "taint",
  "version": 1,
  "description": "污点/数据流分析：敏感源（凭据文件/环境变量/密钥）→ 外传汇点（HTTP/套接字/写文件/进 shell）的组合检测。更新源/汇表无需改引擎代码。",
  "sources": [
    {
      "id": "src-ssh",
      "label": "SSH 私钥文件",
      "re": "~?/?\\.ssh|id_rsa|id_ed25519|id_ecdsa"
    },
    {
      "id": "src-env",
      "label": ".env 凭据文件",
      "re": "\\.env\\b|\\.git-credentials|~?/?\\.npmrc"
    },
    {
      "id": "src-cloudcred",
      "label": "云凭据文件",
      "re": "\\.aws/credentials|~?/?\\.config/gcloud|\\.config/az"
    },
    {
      "id": "src-secretkey",
      "label": "密钥/令牌关键词",
      "re": "API_?KEY|ACCESS[_-]?KEY|SECRET|PASSWORD|TOKEN"
    },
    {
      "id": "src-envvar",
      "label": "环境变量读取",
      "re": "os\\.environ|getenv\\s*\\(|process\\.env"
    },
    {
      "id": "src-browsercred",
      "label": "浏览器凭据/存储库",
      "re": "Login Data(?:\\s+For\\s+Profile)?|Local State|\\bCookies\\b|Web Data|~\\.mozilla/firefox|key4\\.db|logins\\.json"
    },
    {
      "id": "src-dpapi",
      "label": "DPAPI/系统凭据解密",
      "re": "CryptUnprotectData|win32crypt|\\bDPAPI\\b|crypt\\.unprotect"
    }
  ],
  "sinks": [
    {
      "id": "snk-http",
      "label": "HTTP 外传",
      "re": "curl[^\\n]{0,500}-(?:X\\s+POST|d\\b|data|F\\b|T\\b)|requests\\.(?:post|put|patch)|httpx\\.(?:post|put|patch)|urllib[^\\n]{0,500}(?:request|urlopen)|fetch\\s*\\([^)]*(?:method\\s*:|POST|PUT)"
    },
    {
      "id": "snk-socket",
      "label": "套接字/邮件发送",
      "re": "socket\\.(?:send|sendto|sendall)|smtplib|SMTP"
    },
    {
      "id": "snk-write",
      "label": "写文件",
      "re": "open\\s*\\([^)]*[\\\"']w|write_text|writeBytes|fs\\.writeFile|shutil\\.copy|tee\\b|>(?!\\s*(?:/dev/null|&?\\d)\\b)[^\\n]{0,500}\\S"
    },
    {
      "id": "snk-shell",
      "label": "管道进 shell",
      "re": "\\|\\s*(?:sh|bash)\\b|popen|system\\s*\\("
    },
    {
      "id": "snk-ws",
      "label": "WebSocket 持久外传",
      "re": "websockets\\s*\\.\\s*(?:connect|client)|websocket\\s*\\.\\s*(?:create_connection|connect)|ws_connect\\s*\\(|wss?://[^\\s'\\\"]*?(?:/ws|socket)"
    }
  ]
}
