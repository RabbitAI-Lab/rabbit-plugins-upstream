{
  "family": "secret-read",
  "version": 2,
  "rules": [
    {
      "id": "sec-00",
      "re": "\\.env\\b",
      "label": "读取 .env 文件",
      "flags": "I"
    },
    {
      "id": "sec-01",
      "re": "~?/?\\.ssh\\b|id_rsa|id_ed25519|id_ecdsa",
      "label": "访问 SSH 私钥",
      "flags": "I"
    },
    {
      "id": "sec-02",
      "re": "\\.aws/credentials|~/\\.config/gcloud|\\.git-credentials|~/\\.npmrc",
      "label": "访问云/包凭据文件",
      "flags": "I"
    },
    {
      "id": "sec-03",
      "re": "\\b(?:AWS|GCP|AZURE|GOOGLE|OPENAI)_[A-Z_]*(?:KEY|SECRET|TOKEN|ACCESS)\\b",
      "label": "引用云服务密钥",
      "flags": "I"
    },
    {
      "id": "sec-04",
      "re": "(?:SECRET|PASSWORD|TOKEN)\\s*=\\s*[\\\"']",
      "label": "疑似硬编码凭据(赋值)",
      "flags": "I"
    },
    {
      "id": "sec-05",
      "re": "os\\.environ\\b|getenv\\s*\\(|process\\.env\\b",
      "label": "读取环境变量(可能含密钥)",
      "flags": "I"
    },
    {
      "id": "sec-06",
      "re": "\\.kube/config|kubeconfig|kubectl\\s+config\\s+view|/var/run/secrets/kubernetes\\.io|KUBECONFIG\\b",
      "label": "访问 Kubernetes 集群凭据（kubeconfig）",
      "flags": "I"
    },
    {
      "id": "sec-07",
      "re": "\\.docker/config\\.json|docker\\s+config\\.json|\\.docker/config\\b|docker\\s+login\\s+-p|podman.*auth\\.json",
      "label": "访问 Docker/容器镜像仓库凭据",
      "flags": "I"
    },
    {
      "id": "sec-08",
      "re": "\\.git-credentials|\\.netrc\\b|_netrc\\b|\\.pypirc\\b|\\.gem/credentials",
      "label": "访问包管理器/Git 凭据存储（npm/PyPI/Gem/netrc）",
      "flags": "I"
    },
    {
      "id": "sec-09",
      "re": "Login Data(?:\\s+For\\s+Profile)?|Local State|\\bCookies\\b|Web Data|History\\.db|~\\.mozilla/firefox|key4\\.db|logins\\.json|AppData[^\\n]{0,60}(?:Chrome|Edge|Chromium)[^\\n]{0,60}(?:User Data|Default)",
      "label": "访问浏览器凭据/存储库(Login Data/Cookies/Local State 等)",
      "flags": "I"
    },
    {
      "id": "sec-10",
      "re": "CryptUnprotectData|win32crypt|\\bDPAPI\\b|CryptProtectData|crypt\\.unprotect|unprotect\\s*\\(|GetDataProtection",
      "label": "浏览器/系统凭据解密原语(DPAPI/win32crypt)",
      "flags": "I"
    }
  ]
}
