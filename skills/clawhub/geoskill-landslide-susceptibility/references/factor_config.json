{
  "version": "1.0.0",
  "description": "滑坡易发性评价因子配置",
  "factor_names": [
    "slope",
    "aspect",
    "curvature",
    "flow_acc",
    "lithology",
    "dist_fault",
    "rainfall",
    "dist_road"
  ],
  "factor_descriptions": {
    "slope": "坡度 (度)",
    "aspect": "坡向 (度)",
    "curvature": "曲率",
    "flow_acc": "汇流累积量",
