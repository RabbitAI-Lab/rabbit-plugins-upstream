{
  "imports": [],
  "mcpServers": {
    "maverick-trello": {
      "baseUrl": "https://mcp.trello.com/v1",
      "transport": "http",
      "auth": "refreshable_bearer",
      "refresh": {
        "tokenEndpoint": "https://auth.atlassian.com/oauth/token",
        "clientIdEnv": "MAVERICK_TRELLO_MCP_CLIENT_ID",
        "clientAuthMethod": "none",
        "resource": "https://mcp.trello.com/v1"
      }
    }
  }
}
