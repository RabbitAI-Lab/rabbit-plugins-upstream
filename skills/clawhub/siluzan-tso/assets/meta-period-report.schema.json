{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "siluzan-tso/meta-period-report.schema.json",
  "title": "MetaPeriodReport",
  "description": "Meta/Facebook 周期分析报告 JSON（对齐运营 HTML / Excel 五 Sheet）",
  "type": "object",
  "properties": {
    "meta": {
      "type": "object",
      "properties": {
        "accountName": { "type": "string" },
        "accountId": { "type": "string" },
        "campaignName": { "type": "string" },
        "periodLabel": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "resultType": { "type": "string" },
        "attributionSetting": { "type": "string" },
        "currency": { "type": "string" },
        "generatedAt": { "type": "string" }
      }
    },
    "kpis": {
      "type": "object",
      "properties": {
        "spend": { "type": "number" },
        "results": { "type": "number" },
        "costPerResult": { "type": "number" },
        "reach": { "type": "number" },
        "impressions": { "type": "number" },
        "frequency": { "type": "number" },
        "resultType": { "type": "string" },
        "attributionSetting": { "type": "string" }
      }
    },
    "fourQuestions": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["title", "verdict", "bullets", "action"],
        "properties": {
          "title": {
            "type": "string",
            "enum": ["钱花得值不值？", "谁真的想买？", "广告还新鲜吗？", "用户为什么不留资？"]
          },
          "verdict": { "type": "string" },
          "bullets": { "type": "array", "items": { "type": "string" } },
          "action": { "type": "string" }
        }
      }
    },
    "recommendations": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["title", "items"],
        "properties": {
          "title": { "type": "string" },
          "tag": { "type": "string" },
          "items": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "sections": {
      "type": "object",
      "properties": {
        "daily": { "$ref": "#/$defs/insightSection" },
        "country": { "$ref": "#/$defs/insightSection" },
        "campaigns": { "$ref": "#/$defs/insightSection" },
        "audience": { "$ref": "#/$defs/insightSection" }
      }
    },
    "tables": { "type": "object" },
    "charts": { "type": "object" }
  },
  "$defs": {
    "insightSection": {
      "type": "object",
      "properties": {
        "insight": {
          "type": "object",
          "properties": {
            "analysis": { "type": "array", "items": { "type": "string" } },
            "advice": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    }
  }
}
