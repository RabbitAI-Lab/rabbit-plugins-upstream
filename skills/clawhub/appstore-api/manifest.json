{
  "manifest_kind": "replynodes/social-data-skills/appstore-api-package-manifest",
  "manifest_version": 1,
  "name": "appstore-api",
  "title": "App Store Public Reads (ReplyNodes)",
  "description": "Read-only App Store API for iOS app metadata and ASO research through ReplyNodes prepaid credits using one long-lived Bearer fetcher key.",
  "version": "2.0.1",
  "contract_version": "v1",
  "platform": "ios",
  "mode": "readonly",
  "license": "Apache-2.0",
  "entrypoint": "SKILL.md",
  "install_doc": "INSTALL.md",
  "publication_doc": "PUBLICATION.md",
  "required_agents": [
    "OpenClaw",
    "Hermes",
    "ChatGPT",
    "Claude",
    "generic HTTP",
    "MCP agents"
  ],
  "search_terms": [
    "app store api",
    "appstore",
    "ios",
    "ios app metadata",
    "app lookup",
    "app search",
    "related apps",
    "app metadata",
    "public app data"
  ],
  "surface_status": [
    "All nine reviewed public read methods are exposed as stable capability identifiers in the manifest: app, list, search, developer, privacy, suggest, similar, reviews, and ratings.",
    "Each route uses the provider method name and exact option names; app-shaped results are normalized into the public App contract and raw provider records never cross the public gateway.",
    "No availability, uptime, latency, or success-rate figure is claimed; example payloads are illustrative fixtures.",
    "Package access uses prepaid credits only: one long-lived fetcher key is sent as Authorization: Bearer YOUR_FETCHER_KEY"
  ],
  "source_of_truth": {
    "catalog": "services/social-data-skills/catalog/catalog_appstore.json",
    "capability_matrix": "services/appstore-fetcher/internal/capabilities/capabilities.go",
    "normalized_contract": "services/appstore-fetcher/internal/contract/contract.go",
    "generator": "services/social-data-skills/catalog/generate_appstore.py"
  },
  "distribution": {
    "published_to_registry": false,
    "note": "Canonical package source for the prepaid-credit release; external publication is gated on a live package-mode capability response."
  },
  "capabilities": [
    {
      "capability": "app",
      "mcp_tool": "appstore_app",
      "operation": "app",
      "method": "GET",
      "path": "/v1/appstore/apps/{id}",
      "auth_required": true,
      "summary": "Look up one public App Store application",
      "implemented_in": "services/appstore-fetcher/provider-runtime and services/replynodes-fetcher/internal/appstoreadapter"
    },
    {
      "capability": "list",
      "mcp_tool": "appstore_list",
      "operation": "list",
      "method": "GET",
      "path": "/v1/appstore/list",
      "auth_required": true,
      "summary": "List applications from a storefront collection",
      "implemented_in": "services/appstore-fetcher/provider-runtime and services/replynodes-fetcher/internal/appstoreadapter"
    },
    {
      "capability": "search",
      "mcp_tool": "appstore_search",
      "operation": "search",
      "method": "GET",
      "path": "/v1/appstore/search",
      "auth_required": true,
      "summary": "Search public App Store applications by term",
      "implemented_in": "services/appstore-fetcher/provider-runtime and services/replynodes-fetcher/internal/appstoreadapter"
    },
    {
      "capability": "developer",
      "mcp_tool": "appstore_developer",
      "operation": "developer",
      "method": "GET",
      "path": "/v1/appstore/developer",
      "auth_required": true,
      "summary": "List applications by developer",
      "implemented_in": "services/appstore-fetcher/provider-runtime and services/replynodes-fetcher/internal/appstoreadapter"
    },
    {
      "capability": "privacy",
      "mcp_tool": "appstore_privacy",
      "operation": "privacy",
      "method": "GET",
      "path": "/v1/appstore/privacy",
      "auth_required": true,
      "summary": "Read public App Store privacy details",
      "implemented_in": "services/appstore-fetcher/provider-runtime and services/replynodes-fetcher/internal/appstoreadapter"
    },
    {
      "capability": "suggest",
      "mcp_tool": "appstore_suggest",
      "operation": "suggest",
      "method": "GET",
      "path": "/v1/appstore/suggest",
      "auth_required": true,
      "summary": "Suggest public App Store search terms",
      "implemented_in": "services/appstore-fetcher/provider-runtime and services/replynodes-fetcher/internal/appstoreadapter"
    },
    {
      "capability": "similar",
      "mcp_tool": "appstore_similar",
      "operation": "similar",
      "method": "GET",
      "path": "/v1/appstore/apps/{id}/similar",
      "auth_required": true,
      "summary": "List apps related to an application",
      "implemented_in": "services/appstore-fetcher/provider-runtime and services/replynodes-fetcher/internal/appstoreadapter"
    },
    {
      "capability": "reviews",
      "mcp_tool": "appstore_reviews",
      "operation": "reviews",
      "method": "GET",
      "path": "/v1/appstore/reviews",
      "auth_required": true,
      "summary": "Read a page of public app reviews",
      "implemented_in": "services/appstore-fetcher/provider-runtime and services/replynodes-fetcher/internal/appstoreadapter"
    },
    {
      "capability": "ratings",
      "mcp_tool": "appstore_ratings",
      "operation": "ratings",
      "method": "GET",
      "path": "/v1/appstore/ratings",
      "auth_required": true,
      "summary": "Read public app ratings",
      "implemented_in": "services/appstore-fetcher/provider-runtime and services/replynodes-fetcher/internal/appstoreadapter"
    }
  ],
  "unsupported_capabilities": [
    {
      "name": "version_history",
      "status": "unsupported",
      "reason": "not_supported_by_pinned_provider",
      "notes": "No version_history method exists in the pinned provider source."
    },
    {
      "name": "writes_auth_private",
      "status": "unsupported",
      "reason": "read_only_policy",
      "notes": "Writes and authenticated/private operations are excluded by the domain read-only policy."
    }
  ],
