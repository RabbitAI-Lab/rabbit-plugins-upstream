    "/v1/appstore/search": {
      "get": {
        "operationId": "appstore_search",
        "summary": "Search public App Store applications by term",
        "description": "Search the Apple App Store by term. Returns matching iOS apps with metadata; use it to resolve an app name to an App Store ID or bundle ID.",
        "tags": [
          "appstore"
        ],
        "parameters": [
          {
            "name": "term",
            "in": "query",
            "required": true,
            "description": "Search term.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "num",
            "in": "query",
            "required": false,
            "description": "Number of results; values outside 1..50 are rejected.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Result page.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "Two-letter storefront code.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "lang",
            "in": "query",
            "required": false,
            "description": "Language code.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "idsOnly",
            "in": "query",
            "required": false,
