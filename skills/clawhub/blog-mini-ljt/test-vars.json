  "test_cases": [
    {
      "id": "TC-01",
      "name": "health-check",
      "command": "python3 scripts/blog-mini-ljt.py health-check",
      "expected": "{\"status\":\"ok\",\"service\":\"blog-api\",\"version\":\"1.0.0\"}",
      "method": "GET",
      "category": "readonly",
      "description": "检查 API 可达性"
    },
    {
      "id": "TC-02",
      "name": "capability-list",
      "command": "python3 scripts/blog-mini-ljt.py capability-list",
      "expected": "{\"capability\":\"capability-list\",\"skill\":\"blog-mini-ljt\",\"subcommand_count\":30}",
      "method": "GET",
      "category": "readonly",
      "description": "列出本 skill 所有能力项"
    },
    {
      "id": "TC-03",
      "name": "list-articles",
