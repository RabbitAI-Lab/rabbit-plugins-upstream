#!/usr/bin/env bash
# Agent Relay — Inbox Fallback Poller
# Runs as a cron job to catch messages that webhook delivery missed.
# Reads the inbox, deduplicates, and re-submits via webhook.
#
# Setup:
#   1. Export: RELAY_API_KEY, RELAY_BASE_URL, RELAY_HOOK_TOKEN, RELAY_HOOK_URL
#   2. Schedule as: cron every 2 min → run this script
#   3. Seen IDs are tracked in .webhook_seen (dedup state file)
#
# Usage: ./poll-inbox-fallback

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SEEN_FILE="${RELAY_SEEN_FILE:-$SCRIPT_DIR/.webhook_seen}"
API_KEY="${RELAY_API_KEY:-}"
BASE_URL="${RELAY_BASE_URL:-}"
HOOK_TOKEN="${RELAY_HOOK_TOKEN:-}"
HOOK_URL="${RELAY_HOOK_URL:-}"

if [ -z "$API_KEY" ] || [ -z "$BASE_URL" ] || [ -z "$HOOK_TOKEN" ] || [ -z "$HOOK_URL" ]; then
  echo "ERROR: Set RELAY_API_KEY, RELAY_BASE_URL, RELAY_HOOK_TOKEN, and RELAY_HOOK_URL"
  exit 1
fi

touch "$SEEN_FILE"

RESP=$(curl -sf -H "Authorization: Bearer $API_KEY" "$BASE_URL/relay/inbox" 2>/dev/null || true)
if [ -z "$RESP" ] || [ "$RESP" = "[]" ]; then
  exit 0
fi

echo "$RESP" | python3 -c "
import json, sys, subprocess

seen = set()
try:
    with open('$SEEN_FILE') as f:
        seen = set(line.strip() for line in f if line.strip())
except FileNotFoundError:
    pass

messages = json.load(sys.stdin)
new_count = 0
for msg in messages:
    mid = msg.get('id', '')
    if mid and mid not in seen:
        seen.add(mid)
        payload = json.dumps({'source': 'agent-relay', 'message': msg})
        r = subprocess.run([
            'curl', '-sf', '-X', 'POST', '$HOOK_URL',
            '-H', 'Authorization: Bearer $HOOK_TOKEN',
            '-H', 'Content-Type: application/json',
            '-d', payload
        ], capture_output=True, timeout=30, text=True)
        if r.returncode == 0:
            new_count += 1

with open('$SEEN_FILE', 'w') as f:
    for mid in sorted(seen):
        f.write(mid + '\n')

if new_count:
    print(f'Re-submitted {new_count} undelivered message(s) via webhook')
" 2>/dev/null || true

exit 0
