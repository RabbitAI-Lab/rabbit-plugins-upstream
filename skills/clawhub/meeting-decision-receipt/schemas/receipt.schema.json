{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MeetingDecisionReceipt",
  "description": "Source-grounded decisions, commitments, open loops, confirmation copy, and safety state for one meeting.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meeting",
    "close_status",
    "summary",
    "decisions",
    "commitments",
    "open_loops",
    "confirmation_message",
    "safety"
  ],
  "properties": {
    "meeting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "date", "source_type", "participants"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 120},
        "date": {
          "oneOf": [
            {"type": "string", "format": "date"},
            {"type": "null"}
          ]
        },
        "source_type": {
          "type": "string",
          "description": "Input already supplied as text or an authorized readable document. transcript means an existing transcript; this Skill does not convert audio or video into text.",
          "enum": ["transcript", "smart_minutes", "notes", "discussion_thread", "local_file"]
        },
        "participants": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 80}
        },
        "source_label": {"type": ["string", "null"], "maxLength": 160}
      }
    },
    "close_status": {
      "type": "string",
      "enum": ["closed", "needs_confirmation", "no_clear_decision", "insufficient_evidence"]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confirmed_decisions",
        "provisional_decisions",
        "conditional_decisions",
        "explicit_commitments",
        "unconfirmed_assignments",
        "tentative_intents",
        "open_loops"
      ],
      "properties": {
        "confirmed_decisions": {"type": "integer", "minimum": 0},
        "provisional_decisions": {"type": "integer", "minimum": 0},
        "conditional_decisions": {"type": "integer", "minimum": 0},
        "explicit_commitments": {"type": "integer", "minimum": 0},
        "unconfirmed_assignments": {"type": "integer", "minimum": 0},
        "tentative_intents": {"type": "integer", "minimum": 0},
        "open_loops": {"type": "integer", "minimum": 0}
      }
    },
    "decisions": {
      "type": "array",
      "items": {"$ref": "#/$defs/decision"}
    },
    "commitments": {
      "type": "array",
      "items": {"$ref": "#/$defs/commitment"}
    },
    "open_loops": {
      "type": "array",
      "items": {"$ref": "#/$defs/openLoop"}
    },
    "confirmation_message": {"type": "string", "minLength": 1, "maxLength": 4000},
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contains_sensitive_content",
        "redactions",
        "redaction_categories",
        "send_requires_confirmation",
        "raw_source_persisted",
        "neutral_language_mode"
      ],
      "properties": {
        "contains_sensitive_content": {"type": "boolean"},
        "redactions": {"type": "integer", "minimum": 0},
        "redaction_categories": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["password", "token", "api_key", "phone", "email", "credential", "other"]
          }
        },
        "send_requires_confirmation": {"const": true},
        "raw_source_persisted": {"const": false},
        "neutral_language_mode": {"type": "boolean"}
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["speaker", "timestamp", "paragraph", "quote"],
      "properties": {
        "speaker": {"type": "string", "minLength": 1, "maxLength": 80},
        "timestamp": {"type": ["string", "null"], "maxLength": 32},
        "paragraph": {"type": ["string", "null"], "maxLength": 32},
        "quote": {"type": "string", "minLength": 1, "maxLength": 240}
      },
      "anyOf": [
        {"properties": {"timestamp": {"type": "string", "minLength": 1}}},
        {"properties": {"paragraph": {"type": "string", "minLength": 1}}}
      ]
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement",
        "status",
        "scope",
        "condition",
        "confidence",
        "current",
        "replaced_by",
        "evidence"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^D-[0-9]{2,3}$"},
        "statement": {"type": "string", "minLength": 1, "maxLength": 500},
        "status": {
          "type": "string",
          "enum": ["confirmed", "provisional", "conditional", "proposed", "deferred", "rejected", "superseded"]
        },
        "scope": {"type": ["string", "null"], "maxLength": 240},
        "condition": {"type": ["string", "null"], "maxLength": 240},
        "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
        "current": {"type": "boolean"},
        "replaced_by": {
          "oneOf": [
            {"type": "string", "pattern": "^D-[0-9]{2,3}$"},
            {"type": "null"}
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "conditional"}}},
          "then": {"properties": {"condition": {"type": "string", "minLength": 1}}}
        },
        {
          "if": {"properties": {"status": {"const": "superseded"}}},
          "then": {
            "properties": {
              "current": {"const": false},
              "replaced_by": {"type": "string"}
            }
          }
        }
      ]
    },
    "commitment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "task",
        "owner",
        "owner_kind",
        "type",
        "due_original",
        "due_resolved",
        "dependencies",
        "acceptance_criteria",
        "missing_fields",
        "confidence",
        "evidence"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^C-[0-9]{2,3}$"},
        "task": {"type": "string", "minLength": 1, "maxLength": 500},
        "owner": {"type": ["string", "null"], "maxLength": 80},
        "owner_kind": {"type": "string", "enum": ["person", "team", "unknown"]},
        "type": {
          "type": "string",
          "enum": [
            "explicit_commitment",
            "accepted_assignment",
            "unacknowledged_assignment",
            "implied_assignment",
            "tentative_intent",
            "conditional_commitment",
            "unowned"
          ]
        },
        "due_original": {"type": ["string", "null"], "maxLength": 80},
        "due_resolved": {
          "oneOf": [
            {"type": "string", "format": "date"},
            {"type": "null"}
          ]
        },
        "dependencies": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 240}
        },
        "acceptance_criteria": {"type": ["string", "null"], "maxLength": 500},
        "missing_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["owner", "task", "due", "dependencies", "acceptance_criteria", "confirmation"]
          }
        },
        "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "unowned"}}},
          "then": {
            "properties": {
              "owner": {"type": "null"},
              "owner_kind": {"const": "unknown"},
              "missing_fields": {"contains": {"const": "owner"}}
            }
          }
        },
        {
          "if": {"properties": {"type": {"enum": ["unacknowledged_assignment", "implied_assignment"]}}},
          "then": {"properties": {"missing_fields": {"contains": {"const": "confirmation"}}}}
        },
        {
          "if": {"properties": {"type": {"const": "conditional_commitment"}}},
          "then": {"properties": {"dependencies": {"minItems": 1}}}
        }
      ]
    },
    "openLoop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "topic", "missing", "risk", "related_items"],
      "properties": {
        "id": {"type": "string", "pattern": "^O-[0-9]{2,3}$"},
        "topic": {"type": "string", "minLength": 1, "maxLength": 240},
        "missing": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "owner",
              "task",
              "due",
              "dependencies",
              "dependency_owner",
              "dependency_due",
              "acceptance_criteria",
              "confirmation",
              "decision",
              "final_approver",
              "source_evidence"
            ]
          }
        },
        "risk": {"type": "string", "minLength": 1, "maxLength": 500},
        "related_items": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[DCO]-[0-9]{2,3}$"}
        }
      }
    }
  }
}
