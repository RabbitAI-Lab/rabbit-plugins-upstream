# ===== 意图识别 Skill 配置 =====

# --- LLM 配置（OpenAI 兼容协议，支持 GLM/DeepSeek/通义/Kimi 等） ---
# 留空则进入 mock 模式（本地规则模拟意图识别，便于开发联调）
INTENT_LLM_BASE_URL=
INTENT_LLM_API_KEY=
INTENT_LLM_MODEL=glm-4-flash
INTENT_LLM_TIMEOUT_SECONDS=5

# --- 降级模式：conservative=LLM失败直接拦截(金融平台推荐) / loose=放行清洗后query并打标 ---
INTENT_DEGRADE_MODE=conservative

# --- 输入长度限制 ---
INTENT_MAX_QUERY_LENGTH=2000

# --- 平台能力边界（注入 LLM System Prompt） ---
INTENT_PLATFORM_BOUNDARY=本平台仅做ETF/行业/指数投研信息分析，不提供买卖建议、不做个股荐股，不能预测涨跌，不提供投资决策。
