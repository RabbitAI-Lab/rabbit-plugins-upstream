{
  "bilibili": {
    "cookie": "",
    "_说明": "登录 bilibili.com -> F12 -> Network -> 刷新页面 -> 点任意 api.bilibili.com 请求 -> 复制 Request Headers 里的 Cookie 整段。可选但推荐（提升稳定性）。"
  },
  "tieba": {
    "cookie": "",
    "_说明": "登录 tieba.baidu.com -> 同样操作复制 Cookie。必需！否则贴吧接口返回 403 安全验证。"
  },
  "_推荐": "用 python scripts/config_cookies.py 配置（自动验证有效性后写入本文件）；也可用环境变量 BILI_COOKIE / TIEBA_COOKIE 代替"
}
