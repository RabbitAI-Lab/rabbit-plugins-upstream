{
  "variant_id": "relay_06_window",
  "role": "upstream",
  "version": "1.1.1",
  "input_name": "capacity_request",
  "output_name": "capacity_window",
  "input_schema": {
    "type": "object",
    "required": [
      "date",
      "time",
      "timezone"
    ],
    "properties": {
      "date": {
        "type": "string",
        "format": "date"
      },
      "time": {
        "type": "string",
        "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
      },
      "timezone": {
        "type": "string",
        "enum": [
          "Asia/Shanghai",
          "UTC"
        ]
      }
    },
    "additionalProperties": false
  },
  "output_schema": {
    "type": "string",
    "format": "date-time",
    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:Z|[+-][0-9]{2}:[0-9]{2})$"
  },
  "effect": null
}
