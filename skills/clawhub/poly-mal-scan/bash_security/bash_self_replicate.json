[
  {
    "id": "SR-R001",
    "名称": "复制脚本自身到新路径(变量源)",
    "威胁类型": "自我复制",
    "源特征": ["$0", "$BASH_SOURCE", "${BASH_SOURCE[0]}", "${BASH_SOURCE}"],
    "命令特征": ["cp", "install", "cat", "tee", "dd", "mv"],
    "级别": 3,
    "描述": "将当前脚本自身($0 / $BASH_SOURCE)复制到其它路径,实现传播/持久化",
    "参考": "T1105"
  },
  {
    "id": "SR-R002",
    "名称": "将自身内容回写新文件",
    "威胁类型": "自我复制",
    "源特征": ["cat $0", "cat $BASH_SOURCE", "tee $0", "< $0", "dd if=$0", "dd if=$BASH_SOURCE"],
    "命令特征": ["cat", "tee", "dd"],
    "级别": 3,
    "描述": "通过 cat/tee/dd 把自身文件内容写入另一个文件,完成自我复制",
    "参考": "T1105"
  },
  {
    "id": "SR-R003",
    "名称": "向启动项/定时任务复制自身",
    "威胁类型": "自我复制",
    "源特征": ["$0", "$BASH_SOURCE"],
    "目标路径特征": [".bashrc", ".profile", "/etc/cron", "/etc/systemd/system", "/etc/init.d", "/etc/rc.local", ".ssh/"],
    "级别": 4,
    "描述": "把自身复制进启动项/计划任务等持久化位置,开机或定时复活",
    "参考": "T1547"
  },
  {
    "id": "SR-R004",
    "名称": "通过 curl/wget 自我下载传播",
    "威胁类型": "自我复制",
    "源特征": ["$0", "$BASH_SOURCE", "$(basename $0)"],
    "命令特征": ["curl -o", "wget -O"],
    "级别": 3,
    "描述": "将自身 URL/文件名拼出后下载到新主机或路径,横向复制自身",
    "参考": "T1105"
  }
