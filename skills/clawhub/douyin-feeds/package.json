{
  "name": "douyin-feeds",
  "version": "1.4.0",
  "description": "每日自动扫描抖音相关作品，按互动量（点赞/分享/评论）筛选最火内容，智能聚类后生成精美日报。支持关键词搜索、博主作品、视频评论、实时热榜，输出结构化 JSON。用于选题、对标账号、评论舆情和热搜追踪。",
  "keywords": [
    "douyin",
    "search",
    "hot",
    "keyword",
    "content-analysis",
    "competitor-analysis"
  ],
  "author": "um-why",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=16.14.0"
  },
  "scripts": {
    "search": "node src/douyin/search-cli.js",
    "post": "node src/douyin/post-cli.js",
    "comment": "node src/douyin/comment-cli.js",
    "hot": "node src/douyin/hot-cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/um-why/douyin-search-openclaw.git"
  }
}