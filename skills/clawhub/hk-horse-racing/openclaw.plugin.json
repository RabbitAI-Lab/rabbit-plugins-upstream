{
  "id": "hk-horse-racing",
  "name": "HK Horse Racing",
  "description": "Fetches HKJC race cards from the public racing page, adds WIN/PLA odds when available, filters SB horses, and recommends top picks. Also fetches official race results and dividends.",
  "version": "1.2.4",
  "tools": [
    {
      "name": "fetchRaceCard",
      "description": "Fetch race card for a given date (default: today) with runner details, available WIN/PLA odds, and recommendations",
      "input": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "description": "Date in YYYY-MM-DD format (default: today in HKT)"
          },
          "classFilter": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Optional list of class strings to filter (e.g., [\"Class 4\"])"
          },
          "language": {
            "type": "string",
            "enum": ["en"],
            "description": "Output language. Only English supported. Default: 'en'."
          },
          "excludeHorseNos": {
            "type": "array",
            "items": { "type": "number" },
            "description": "Optional list of horse numbers to exclude from output and recommendations (e.g., [7])."
          },
          "excludeBarriers": {
            "type": "array",
            "items": { "type": "number" },
            "description": "Optional list of barrier numbers to exclude from output and recommendations (e.g., [7])."
          },
          "raceNo": {
            "type": "number",
            "description": "Optional: fetch only this specific race number. If omitted, returns all races for the date."
          },
          "advancedScoring": {
            "type": "boolean",
            "description": "Enable advanced scoring: includes trainer/jockey bonuses, barrier effectiveness, weight penalty, and light weight bonus. Default: false."
          },
          "tjBonusWeight": {
            "type": "number",
            "description": "Weight for trainer/jockey combo bonus when advancedScoring=true. Range 0-0.3. Default: 0.15."
          },
          "barrierBonusWeight": {
            "type": "number",
            "description": "Weight for barrier effectiveness bonus when advancedScoring=true. Range 0-0.2. Default: 0.12."
          },
          "newsBoost": {
            "type": "boolean",
            "description": "When advancedScoring=true, also fetch news sentiment for each horse via Brave search (slower). Default: false."
          },
          "lightWeightBonus": {
            "type": "number",
            "description": "Bonus for horses with weight < 120lb when advancedScoring=true. Range 0-0.2. Default: 0.05."
          }
        },
        "required": []
      },
      "output": {
        "type": "object",
        "properties": {
          "meeting": {
            "type": "object",
            "properties": {
              "venue": { "type": "string" },
              "date": { "type": "string" },
              "weather": { "type": "string" },
              "trackCondition": { "type": "string" }
            }
          },
          "races": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "raceNo": { "type": "number" },
                "distance": { "type": "number" },
                "class": { "type": "string" },
                "going": { "type": "string" },
                "horses": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "horseNo": { "type": "number" },
                      "horseName": { "type": "string" },
                      "horseId": { "type": "string" },
                      "weight": { "type": "number" },
                      "jockey": { "type": "string" },
                      "jockeyAllowance": { "type": "number" },
                      "trainer": { "type": "string" },
                      "pastRuns": { "type": "array", "items": { "type": "number" } },
                      "gear": { "type": "array", "items": { "type": "string" } },
                      "winOdds": { "type": "number" },
                      "placeOdds": { "type": "number" }
                    }
                  }
                },
                "recommendations": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "horseName": { "type": "string" },
                      "reason": { "type": "string" },
                      "winProbability": { "type": "number" }
                    }
                  }
                }
              }
            }
          },
          "source": { "type": "string" },
          "oddsSource": { "type": "string" },
          "timestamp": { "type": "string" }
        }
      }
    },
    {
      "name": "fetchRaceResults",
      "description": "Fetch official race placings, final WIN odds, and dividends for a date (default: latest available results)",
      "input": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "description": "Date in YYYY-MM-DD format. Omit to fetch the latest available results."
          },
          "raceNo": {
            "type": "number",
            "description": "Optional race number. If omitted, returns all races for that date."
          }
        },
        "required": []
      },
      "output": {
        "type": "object",
        "properties": {
          "date": { "type": "string" },
          "venue": { "type": "string" },
          "races": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "raceNo": { "type": "number" },
                "raceId": { "type": "number" },
                "raceName": { "type": "string" },
                "class": { "type": "string" },
                "distance": { "type": "number" },
                "going": { "type": "string" },
                "results": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "position": { "type": "string" },
                      "horseNo": { "type": "number" },
                      "horseName": { "type": "string" },
                      "horseId": { "type": "string" },
                      "jockey": { "type": "string" },
                      "trainer": { "type": "string" },
                      "actualWeight": { "type": "number" },
                      "declaredHorseWeight": { "type": "number" },
                      "barrier": { "type": "number" },
                      "lengthsBehind": { "type": "string" },
                      "runningPosition": { "type": "string" },
                      "finishTime": { "type": "string" },
                      "winOdds": { "type": "number" }
                    }
                  }
                },
                "dividends": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "pool": { "type": "string" },
                      "winningCombination": { "type": "string" },
                      "dividend": { "type": "number" }
                    }
                  }
                }
              }
            }
          },
          "source": { "type": "string" },
          "timestamp": { "type": "string" }
        }
      }
    }
  ],
  "runtime": "node",
  "main": "skill.js",
  "installCommand": "npm install",
  "requiredEnvVars": []
}