{
  "variant_id": "relay_15_match_threshold",
  "role": "downstream",
  "version": "1.1.1",
  "input_name": "match_threshold",
  "output_name": "reconciliation_summary",
  "input_schema": {
    "type": "number",
    "minimum": 0.5,
    "maximum": 1.0,
    "multipleOf": 0.01
  },
  "output_schema": {
    "type": "object",
    "required": [
      "summary_id",
      "threshold",
      "matched_count",
      "matched_invoice_ids"
    ],
    "properties": {
      "summary_id": {
        "type": "string",
        "pattern": "^reconcile_[0-9a-f]{12}$"
      },
      "threshold": {
        "type": "number",
        "minimum": 0.5,
        "maximum": 1.0,
        "multipleOf": 0.01
      },
      "matched_count": {
        "type": "integer",
        "minimum": 0
      },
      "matched_invoice_ids": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^INV-[0-9]{4}$"
        },
        "uniqueItems": true
      }
    },
    "additionalProperties": false
  },
  "effect": "reconciliation_summary"
}
