# Copy to `.env` and fill in real values. Never commit real keys.
# These are read by call_skin_pro.py at startup. The LLM never sees them.
# May share the same AK/SK values as tcm-face-tongue (same RageHealth account).
# Variable names differ: this skill reads SKIN_PRO_AK / SKIN_PRO_SK.

SKIN_PRO_AK=replace_with_16_byte_access_key
SKIN_PRO_SK=replace_with_16_or_24_or_32_byte_secret_key
