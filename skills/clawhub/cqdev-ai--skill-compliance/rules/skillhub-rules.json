{
  "$schema": "SkillHub Compliance Rules v1.0",
  "description": "SkillHub上架合规检查规则库，基于中国相关法律法规。适用于国内AI应用市场（如腾讯SkillHub、百度智能体等）的开发者上架合规自查。",
  "version": "1.1.0",
  "last_updated": "2026-07-19",
  "maintainer": "ChengQian (成乾)",
  "notes": "本规则库仅供参考，不构成法律意见。实际合规要求以监管部门最新政策为准。规则匹配基于关键词扫描，误报率和漏报率无法完全消除。",
  "categories": {
    "FINANCE": "金融敏感用语 — 涉及证券投资咨询、荐股、收益承诺等受监管领域",
    "DISCLAIMER": "免责声明检查 — 金融/合规类技能必须具有显眼位置的法律及投资免责声明",
    "EXAGGERATION": "极限词/夸大描述 — 广告法禁止的绝对化用语和不正当对比",
    "SECURITY": "安全红线 — 可能导致任意代码执行的危险调用",
    "RECOMMENDATIONS": "综合建议 — 文档完整性等最佳实践",
    "PRIVACY": "数据隐私与个人信息保护 — 涉及个人信息收集、处理、出境的合规要求，基于《个人信息保护法》及配套法规",
    "REGULATORY": "监管合规 — 涵盖 ICP 备案、AIGC 标识、算法备案、未成年人保护等专项监管要求"
  },
  "severity_levels": {
    "critical": 30,
    "high": 15,
    "medium": 5,
    "low": 2
  },
  "scoring_model": {
    "base_score": 100,
    "redline_penalty": "一票否决 — 任何 redline=true 的规则触发即判定为 REJECT，score=0",
    "deduction": "按照 severity 级别扣分，优先级 crit(30) > high(15) > medium(5) > low(2)",
    "conclusion_thresholds": {
      "PASS": "score >= 70 且无 redline 触发",
      "NEEDS_FIX": "score >= 40 且 < 70 且无 redline 触发",
      "REJECT": "score < 40 或任意 redline=true 规则触发"
    }
  },
  "rules": [
    {
      "id": "FIN-001",
      "name": "证券投资推荐",
      "category": "FINANCE",
      "severity": "high",
      "redline": true,
      "description": "检测到明确的证券买卖推荐用语，如推荐买入/卖出、目标价预测等。未经批准的证券投资咨询行为受《证券法》严格监管",
      "behavioral": false,
      "patterns": [
        "推荐买入",
        "推荐卖出",
        "买入评级",
        "卖出评级",
        "目标价",
        "看到.*元",
        "翻倍",
        "涨停预期",
        "建议买入",
        "建议卖出",
        "强烈推荐买入",
        "强烈推荐卖出",
        "买点出现",
        "卖点出现"
      ],
      "scan_targets": [
        "docs",
        "scripts"
      ],
      "exclude_patterns": [
        "用户输入",
        "用户提供",
        "不构成投资建议",
        "仅供参考",
        "用户自行决定"
      ],
      "legal_source": "《证券法》（2019年修订，2020年3月1日施行）第一百六十条：未经国务院证券监督管理机构批准，任何单位和个人不得从事证券投资咨询业务。",
      "authority_type": "law"
    },
    {
      "id": "FIN-002",
      "name": "保证收益承诺",
      "category": "FINANCE",
      "severity": "high",
      "redline": true,
      "description": "检测到收益率保证、保本承诺等保证性用语。对未来收益作出保证性承诺属于《广告法》禁止行为",
      "behavioral": false,
      "patterns": [
        "稳赚",
        "保本",
        "无风险",
        "100%.*收益",
        "guaranteed.*return",
        "risk[- ]?free",
        "保证收益",
        "保底收益",
        "固定收益.*%",
        "每年.*%",
        "月收益.*%",
        "稳赚不赔",
        "零风险",
        "绝对安全"
      ],
      "scan_targets": [
        "docs",
        "scripts"
      ],
      "exclude_patterns": [
        "历史收益率",
        "历史年化",
        "过去",
        "仅供参考",
        "不保证未来收益",
        "查看历史",
        "回溯测试",
        "回测",
        "模拟收益",
        "假设",
        "假设性"
      ],
      "legal_source": "《广告法》（2015年修订，2021年修正，2021年修正生效）第二十五条：招商等有投资回报预期的商品或者服务广告，不得对未来效果、收益或者与其相关的情况作出保证性承诺。",
      "authority_type": "law"
    },
    {
      "id": "FIN-003",
      "name": "投资建议用语",
      "category": "FINANCE",
      "severity": "medium",
      "redline": false,
      "description": "检测到通常用于投资建议的敏感词汇，虽不直接构成荐股，但需谨慎使用并添加适当免责声明",
      "behavioral": false,
      "patterns": [
        "投资建议",
        "理财建议",
        "资产配置建议",
        "炒股",
        "炒股票",
        "必涨",
        "必跌",
        "一定会涨",
        "一定会跌",
        "强烈买入",
        "强烈卖出",
        "增持",
        "减持",
        "加仓",
        "减仓",
        "建仓",
        "抄底",
        "逃顶"
      ],
      "scan_targets": [
        "docs"
      ],
      "exclude_patterns": [
        "用户输入",
        "用户提供",
        "用户自行",
        "不构成投资建议",
        "技术分析",
        "数据分析",
        "合规检查",
        "analysis tool",
        "分析工具",
        "分析功能",
        "分析模块"
      ],
      "legal_source": "《关于加强证券期货信息传播管理的若干规定》第六条：传播证券期货信息，必须遵守国家有关规定，不得传播虚假信息",
      "authority_type": "regulation"
    },
    {
      "id": "FIN-004",
      "name": "需资质用语",
      "category": "FINANCE",
      "severity": "medium",
      "redline": false,
      "description": "检测到需要特定资质才能使用的专业金融服务术语，开发者若无相应资质不应使用这些表述",
      "behavioral": false,
      "patterns": [
        "证券咨询",
        "投资顾问",
        "基金管理",
        "证券投资咨询",
        "持牌",
        "证监会",
        "监管备案",
        "正规金融机构",
        "资产管理",
        "理财规划师",
        "证券分析师"
      ],
      "scan_targets": [
        "docs"
      ],
      "exclude_patterns": [
        "查看.*证监会",
        "证监会.*公告",
        "证券法",
        "符合.*监管",
        "非持牌",
        "不涉及.*证券咨询",
        "不涉及.*投资顾问",
        "学习参考",
        "教育",
        "教学"
      ],
      "legal_source": "《证券法》第一百六十条：未经国务院证券监督管理机构批准，任何单位和个人不得从事证券投资咨询业务",
      "authority_type": "law"
    },
    {
      "id": "FIN-005",
      "name": "走势分析声明要求",
      "category": "FINANCE",
      "severity": "low",
      "redline": false,
      "description": "检测到技术分析/走势分析类用语，虽不一定违规但建议在显眼位置添加风险提示声明，明确工具仅供学习和研究参考",
      "behavioral": false,
      "patterns": [
        "走势分析",
        "技术分析",
        "K线分析",
        "趋势分析",
        "行情分析",
        "收益率",
        "回报率",
        "年化",
        "技术指标",
        "均线分析",
        "MACD",
        "RSI",
        "布林带",
        "股票分析",
        "股票预测",
        "股价预测",
        "市场预测"
      ],
      "scan_targets": [
        "docs"
      ],
      "exclude_patterns": [
        "风险趋势分析",
        "审计趋势分析",
        "历史风险趋势",
        "数据趋势分析",
        "销售趋势",
        "用户趋势",
        "业绩趋势",
        "财务趋势",
        "历史年化收益",
        "过去",
        "仅供参考"
      ],
      "legal_source": "《证券、期货投资咨询管理暂行办法》（1998年4月1日施行）第三条：从事证券、期货投资咨询业务，必须依照本办法的规定，取得中国证监会的业务许可。",
      "self_describing": true,
      "self_describing_markers": [
        "版本",
        "version",
        "minOpenClawVersion",
        "版本号"
      ],
      "authority_type": "regulation"
    },
    {
      "id": "DISC-001",
      "name": "投资免责声明缺失",
      "category": "DISCLAIMER",
      "severity": "high",
      "redline": false,
      "description": "检测到金融建议类用语但缺少必要的投资免责声明。根据《证券、期货投资咨询管理暂行办法》第二十四条，证券投资咨询机构及其人员不得对投资行为作出确定性判断。",
      "behavioral": true,
      "depends_on": [
        "FIN-001",
        "FIN-002",
        "FIN-003",
        "FIN-005"
      ],
      "look_for": [
        "不构成投资建议",
        "不构成任何投资建议",
        "仅供参考.*不构成投资建议",
        "投资风险.*自行承担",
        "风险提示.*投资",
        "本工具.*不构成投资建议",
        "免责声明.*投资"
      ],
      "scan_targets": [
        "docs"
      ],
      "exclude_patterns": [],
      "legal_source": "《证券、期货投资咨询管理暂行办法》（1998年4月1日施行）第二十四条：证券投资咨询机构及其投资咨询人员，不得对投资行为作出确定性判断。",
      "authority_type": "regulation"
    },
    {
      "id": "DISC-002",
      "name": "法律免责声明缺失",
      "category": "DISCLAIMER",
      "severity": "high",
      "redline": false,
      "description": "合规检查类技能缺少必要的法律免责声明。涉及法律合规自动化的技能建议添加免责声明，明确工具仅为辅助参考用途",
      "behavioral": true,
      "depends_on": [],
      "look_for": [
        "不构成法律建议",
        "不构成任何法律建议",
        "法律意见.*咨询律师",
        "仅供参考.*不构成法律",
        "免责声明.*法律",
        "本工具.*仅供参考.*不构成法律",
        "as-is",
        "as is",
        "provided without warranty",
        "not intended as legal advice",
        "for reference only"
      ],
      "scan_targets": [
        "docs"
      ],
      "exclude_patterns": [],
      "legal_source": "《律师法》第十四条：没有取得律师执业证书的人员，不得以律师名义从事法律服务业务",
      "authority_type": "law"
    },
    {
      "id": "DISC-003",
      "name": "通用免责声明缺失",
      "category": "DISCLAIMER",
      "severity": "medium",
      "redline": false,
      "description": "未在显眼位置发现免责声明。最佳实践建议在README或SKILL.md开头部分添加免责声明，声明工具责任范围",
      "behavioral": true,
      "depends_on": [],
      "look_for": [
        "免责声明",
        "免责",
        "Disclaimer",
        "disclaimer",
        "limitation of liability",
        "ALL WARRANTIES",
        "NO WARRANTY",
        "使用风险.*自行承担",
        "后果自负"
      ],
      "scan_targets": [
        "docs"
      ],
      "exclude_patterns": [],
      "legal_source": "《民法典》第一千一百六十五条：行为人因过错侵害他人民事权益造成损害的，应当承担侵权责任",
      "authority_type": "law"
    },
    {
      "id": "EXA-001",
      "name": "绝对化用语",
      "category": "EXAGGERATION",
      "severity": "medium",
      "redline": false,
      "description": "检测到《广告法》禁止的绝对化用语，如行业第一、最好等。在SkillHub上架的应用即使不构成商业广告，也可能被平台要求整改",
      "behavioral": false,
      "patterns": [
        "最.*的",
        "第[一二三四五六七八九十].*的",
        "全网(唯一|最好|第一|领先|首创)",
        "唯一.*的",
        "(遥遥领先|行业领先|领先.*水平)",
        "(无与伦比|无可替代|无以伦比)",
        "(最佳|最优|最强|最好|顶级|卓越)",
        "(顶尖|标杆|标杆级|旗舰级)",
        "(首创|独创|率先|首家)"
      ],
      "scan_targets": [
        "docs"
      ],
      "exclude_patterns": [
        "第三方工具",
        "最大输出",
        "最大范围内",
        "最佳时机",
        "最小输入",
        "最大程度",
        "最高标准",
        "最佳路径",
        "尽最大努力",
        "最低限度",
        "最佳性价比",
        "最大值",
        "最小化",
        "最佳实践",
        "第三方数据",
        "第三方库",
        "最大可能性",
        "第三方平台",
        "最大化",
        "最佳方案",
        "第三方模块",
        "第三方服务",
        "在法律允许的最大范围内",
        "最小值",
        "最小必要",
        "第三方API"
      ],
      "legal_source": "《广告法》（2015年修订，2021年修正）第九条：广告不得使用国家级、最高级、最佳等用语。",
      "authority_type": "law"
    },
    {
      "id": "EXA-002",
      "name": "贬低性对比表述",
      "category": "EXAGGERATION",
      "severity": "medium",
      "redline": false,
      "description": "检测到与其他产品或服务进行对比并暗示自身更优的表述。即使未直接点名，此类对比也可能被认定为不正当竞争",
      "behavioral": false,
      "patterns": [
        "比.*(好|强|优秀|专业|厉害|先进|高效|稳定|可靠|优越|出色)",
        "优于.*",
        "胜于.*",
        "碾压.*",
        "吊打.*",
        "完胜.*",
        "完爆.*"
      ],
      "scan_targets": [
        "docs"
      ],
      "exclude_patterns": [
        "by",
        "BY",
        "比较好",
        "相比.*更",
        "比较分析",
        "对比分析",
        "优势对比",
        "by comparing",
        "compare with",
        "comparison",
        "百分比",
        "比例",
        "比率",
        "同比增长",
        "环比增长",
        "比上",
        "比前一"
      ],
      "legal_source": "《广告法》（2015年修订，2021年修正）第十三条：广告不得贬低其他生产经营者的商品或者服务。",
      "authority_type": "law"
    },
    {
      "id": "EXA-003",
      "name": "虚假或引人误解的描述",
      "category": "EXAGGERATION",
      "severity": "high",
      "redline": false,
      "description": "检测到可能构成虚假宣传的描述用语。SkillHub平台要求技能描述真实准确，不得夸大功能或误导用户",
      "behavioral": false,
      "patterns": [
        "自动.*全自动",
        "无需任何操作",
        "完全无人值守",
        "100%.*准确",
        "零错误",
        "绝对准确",
        "完全取代",
        "完全替代.*人类",
        "与.*完全相同",
        "完美.*解决"
      ],
      "scan_targets": [
        "docs"
      ],
      "exclude_patterns": [
        "尽可能",
        "尽量",
        "在.*条件下",
        "特定场景",
        "限定范围",
        "取决于",
        "视.*而定"
      ],
      "legal_source": "《广告法》（2015年修订，2021年修正）第四条：广告不得含有虚假或者引人误解的内容，不得欺骗、误导消费者。",
      "authority_type": "law"
    },
    {
      "id": "SEC-001",
      "name": "危险代码执行",
      "category": "SECURITY",
      "severity": "critical",
      "redline": true,
      "description": "检测到 subprocess、eval、exec、os.system 等危险调用。SkillHub 平台安全规范明确禁止可能导致任意代码执行的系统调用",
      "behavioral": false,
      "patterns": [
        "subprocess\\.(Popen|call|run|check_call|check_output|getstatusoutput|getoutput)",
        "\\beval\\s*\\(",
        "\\bexec\\s*\\(",
        "os\\.system\\s*\\(",
        "os\\.popen\\s*\\(",
        "os\\.execl\\s*\\(",
        "os\\.execle\\s*\\(",
        "os\\.execlp\\s*\\(",
        "os\\.execv\\s*\\(",
        "os\\.execve\\s*\\(",
        "os\\.execvp\\s*\\(",
        "os\\.fork\\s*\\(",
        "shutil\\.rmtree\\s*\\(",
        "__import__\\s*\\(",
        "compile\\s*\\(",
        "pty\\.spawn\\s*\\(",
        "ctypes\\.(CDLL|windll|cdll|LibraryLoader)"
      ],
      "scan_targets": [
        "scripts"
      ],
      "exclude_patterns": [
        "subprocess.*被注释",
        "subprocess.*commanded",
        "#.*subprocess",
        "#.*eval",
        "#.*exec",
        "被注释.*subprocess",
        "不建议.*subprocess",
        "不应.*subprocess"
      ],
      "legal_source": "SkillHub 平台安全规范第3条：禁止使用可能执行任意代码的系统调用",
      "authority_type": "platform_policy"
    },
    {
      "id": "SEC-002",
      "name": "动态代码执行（警告）",
      "category": "SECURITY",
      "severity": "high",
      "redline": false,
      "description": "检测到动态代码执行相关的潜在危险模式，如 importlib、动态导入、反射调用等。虽不完全等同于 eval/exec，但在特定上下文中可能构成安全风险",
      "behavioral": false,
      "patterns": [
        "importlib\\.import_module\\s*\\(",
        "__import__\\s*\\(",
        "getattr.*import",
        "load_module",
        "execfile",
        "runpy",
        "code\\.Interact",
        "code\\.compile_command"
      ],
      "scan_targets": [
        "scripts"
      ],
      "exclude_patterns": [
        "PYTHONDONTWRITEBYTECODE",
        "__import__.*builtin"
      ],
      "legal_source": "SkillHub 平台安全规范：慎用动态模块加载机制",
      "authority_type": "platform_policy"
    },
    {
      "id": "SEC-003",
      "name": "网络请求（需声明）",
      "category": "SECURITY",
      "severity": "high",
      "redline": false,
      "description": "检测到网络请求相关调用。国内平台对涉及网络通信的技能有更高的合规要求，需在功能描述中如实声明网络行为",
      "behavioral": false,
      "patterns": [
        "requests\\.(get|post|put|delete|head|options|request|Session)",
        "urllib\\.(request|parse)\\.(urlopen|urlretrieve)",
        "http\\.(client|server)",
