# 复制本文件为 .env 并填入真实值（不要提交 .env 到 git）

# ===== 微信支付侧（商户平台获取）=====
MCH_ID=1900000001
APP_ID=wx8888888888888888
SERIAL_NO=5157F09EFDC096DE15EBE81A47057A72XXXXXXXX
PRIVATE_KEY_PATH=/path/to/apiclient_key.pem
MCH_APIV3_KEY=你的32位APIv3密钥

# ===== SkillHub 开发者密钥（商户后台一键生成）=====
SKILLHUB_DEVELOPER_ID=sh-XXXXXXXX
SKILLHUB_PUB_KEY_ID=PUB_KEY_XXXXXXXX
SKILLHUB_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----
MIIE......
-----END PRIVATE KEY-----

# ===== Skill 信息（必须与 SkillHub 后台 Slug 一致）=====
SKILL_ID=pediatric-health-record
SKILL_VERSION=1.0.0

# ===== 公网回调地址（https）=====
PAY_NOTIFY_URL=https://你的域名/api/pay/notify
REFUND_NOTIFY_URL=https://你的域名/api/refund/notify

# ===== 服务端口 =====
PORT=8080

# ===== 本地联调：设为 1 跳过真实微信/SkillHub 调用 =====
MOCK=1
