{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kamroncorp/propaymun-information-architecture-skill/blob/main/schema/product-sitemap.schema.json",
  "title": "ProPaymun Product Sitemap",
  "description": "A traceable product/UX destination structure derived from an IA Reference Lock or minimum semantic substrate.",
  "type": "object",
  "required": ["meta", "destinations", "links"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["title", "artifact_type", "artifact_version", "status", "language", "direction", "scope", "source"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "artifact_type": {"const": "product-sitemap"},
        "artifact_version": {"const": "1.0"},
        "status": {"enum": ["draft", "proposed", "reviewed", "approved"]},
        "language": {"type": "string", "minLength": 2},
        "direction": {"enum": ["ltr", "rtl", "vertical"]},
        "scope": {"type": "string", "minLength": 1},
        "decision_purpose": {"type": "string"},
        "source": {
          "type": "object",
          "required": ["type", "reference_id", "version", "readiness"],
          "properties": {
            "type": {"enum": ["ia-reference-lock", "minimum-semantic-substrate"]},
            "reference_id": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1},
            "readiness": {"enum": ["not-ready", "provisional", "reviewable", "approved"]}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "destinations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "purpose", "destination_kind", "parent_id", "semantic_refs", "access_scope", "evidence_status"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "destination_kind": {"enum": ["root", "hub", "collection", "detail", "workspace", "utility", "external"]},
          "parent_id": {"type": ["string", "null"]},
          "semantic_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "access_scope": {"type": "string", "minLength": 1},
          "entry_contexts": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "route": {"type": ["string", "null"]},
          "evidence_status": {"enum": ["Provided", "Observed", "Confirmed", "Inferred", "Proposed", "Unknown"]}
        },
        "additionalProperties": true
      }
    },
    "views": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "destination_id", "evidence_status"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "destination_id": {"type": "string", "minLength": 1},
          "evidence_status": {"enum": ["Provided", "Observed", "Confirmed", "Inferred", "Proposed", "Unknown"]}
        },
        "additionalProperties": true
      }
    },
    "states": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "destination_id", "evidence_status"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "destination_id": {"type": "string", "minLength": 1},
          "evidence_status": {"enum": ["Provided", "Observed", "Confirmed", "Inferred", "Proposed", "Unknown"]}
        },
        "additionalProperties": true
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "destination_ids", "semantic_refs", "evidence_status"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "destination_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "semantic_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "evidence_status": {"enum": ["Provided", "Observed", "Confirmed", "Inferred", "Proposed", "Unknown"]}
        },
        "additionalProperties": true
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "from", "to", "type", "evidence_status"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "from": {"type": "string", "minLength": 1},
          "to": {"type": "string", "minLength": 1},
          "type": {"enum": ["cross-link", "contextual-entry", "external-boundary"]},
          "label": {"type": "string"},
          "evidence_status": {"enum": ["Provided", "Observed", "Confirmed", "Inferred", "Proposed", "Unknown"]}
        },
        "additionalProperties": true
      }
    },
    "assumptions": {"type": "array"},
    "unknowns": {"type": "array"},
    "validation": {"type": "array"}
  },
  "additionalProperties": true
}
