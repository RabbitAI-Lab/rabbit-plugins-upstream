{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kamroncorp/propaymun-information-architecture-skill/blob/main/schema/user-flow.schema.json",
  "title": "ProPaymun Stateful User Flow",
  "description": "A traceable goal-directed flow derived from an IA Reference Lock or minimum semantic substrate.",
  "type": "object",
  "required": ["meta", "actors", "steps", "transitions", "entry_step_id", "success_conditions"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["title", "artifact_type", "artifact_version", "status", "language", "direction", "scope", "goal", "source"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "artifact_type": {"const": "user-flow"},
        "artifact_version": {"const": "1.0"},
        "status": {"enum": ["draft", "proposed", "reviewed", "approved"]},
        "language": {"type": "string", "minLength": 2},
        "direction": {"enum": ["ltr", "rtl", "vertical"]},
        "scope": {"type": "string", "minLength": 1},
        "goal": {"type": "string", "minLength": 1},
        "trigger": {"type": "string"},
        "preconditions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "source": {
          "type": "object",
          "required": ["type", "reference_id", "version", "readiness"],
          "properties": {
            "type": {"enum": ["ia-reference-lock", "minimum-semantic-substrate"]},
            "reference_id": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1},
            "readiness": {"enum": ["not-ready", "provisional", "reviewable", "approved"]}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "actors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "evidence_status"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "evidence_status": {"enum": ["Provided", "Observed", "Confirmed", "Inferred", "Proposed", "Unknown"]}
        },
        "allOf": [
          {
            "if": {"properties": {"type": {"enum": ["action", "handoff"]}}, "required": ["type"]},
            "then": {"required": ["actor_id"], "properties": {"actor_id": {"type": "string", "minLength": 1}}}
          }
        ],
        "additionalProperties": true
      }
    },
    "steps": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "type", "label", "semantic_refs", "evidence_status"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "type": {"enum": ["action", "system-response", "decision", "state", "success", "failure", "recovery", "cancellation", "exit", "handoff"]},
          "label": {"type": "string", "minLength": 1},
          "actor_id": {"type": ["string", "null"]},
          "semantic_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "state_before": {"type": ["string", "null"]},
          "state_after": {"type": ["string", "null"]},
          "permission_condition": {"type": ["string", "null"]},
          "terminal": {"type": "boolean"},
          "evidence_status": {"enum": ["Provided", "Observed", "Confirmed", "Inferred", "Proposed", "Unknown"]}
        },
        "additionalProperties": true
      }
    },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "from", "to", "kind", "evidence_status"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "from": {"type": "string", "minLength": 1},
          "to": {"type": "string", "minLength": 1},
          "kind": {"enum": ["main", "alternative", "error", "recovery", "cancel"]},
          "condition": {"type": "string", "minLength": 1},
          "evidence_status": {"enum": ["Provided", "Observed", "Confirmed", "Inferred", "Proposed", "Unknown"]}
        },
        "additionalProperties": true
      }
    },
    "entry_step_id": {"type": "string", "minLength": 1},
    "success_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "assumptions": {"type": "array"},
    "unknowns": {"type": "array"},
    "validation": {"type": "array"}
  },
  "additionalProperties": true
}
