          }
        },
        "required": [
          "cue"
        ],
        "additionalProperties": true
      }
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "selected_route": {
        "type": "string"
      },
      "candidate_routes": {
        "type": "array",
