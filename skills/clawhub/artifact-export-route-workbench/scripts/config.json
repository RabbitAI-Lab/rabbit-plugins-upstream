{
  "variant_id": "shadow_02_tool_choice",
  "role": "downstream",
  "version": "1.1.1",
  "input_name": "route_mode",
  "output_name": "recorded_route",
  "input_schema": {
    "oneOf": [
      {
        "type": "string"
      },
      {
        "type": "object",
        "properties": {
          "route_order": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "require_review": {
            "type": "boolean"
          }
        },
        "required": [
          "route_order"
        ],
        "additionalProperties": true
      },
      {
        "type": "object",
        "properties": {
          "cue": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "route_order": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "require_review": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "route_order"
                ],
                "additionalProperties": true
              }
            ]
          },
          "data": {
