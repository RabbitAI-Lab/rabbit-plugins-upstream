  "steps": [
    {
      "id": "s1",
      "vp": "vp-fin",
      "state": "",
      "tag": "STEP 1 / 10 · 先立论",
      "h2": "AMD 不是一个追赶者",
      "paragraphs": [
        "2026 年 7 月 24 日，AMD 收于 <span class=\"num\">$580.91</span>，市值 <span class=\"num\">约 9,300 亿美元</span>——比 2014 年苏姿丰接手时的不到 30 亿美元涨了 300 多倍。但\"追赶英伟达\"不回答任何问题。要回答的是：<b>它体内那四块表，分别走到第几幕了？</b>",
        "右侧是最近 14 个财季的报表：单季营收从 <span class=\"num\">55.99 亿</span> 美元（2022Q4）到 <span class=\"num\">102.53 亿</span> 美元（2026Q1），三年不到两倍；GAAP 毛利率从 43% 抬到 <b>52.8%</b>，远低于英伟达的 75%。这不是一条平滑的成长曲线——中间嵌着 <span class=\"dn\">2023Q1 库存洗澡单季净亏 1.4 亿美元</span>，也嵌着 <span class=\"dn\">2025Q2 MI308 减记毛利率跌至 39.8%</span>。",
        "周期从来不缺，缺的是<b>分开读表</b>的纪律。"
      ],
      "figure": {
        "alt": "AMD 苏姿丰与 Zen 架构",
        "caption": "苏姿丰博士——2014 年接手濒临破产的 AMD，12 年后把它带到 9,300 亿美元市值。Zen 架构是转折点。（Wikimedia Commons）",
        "src": ""
      }
    },
    {
      "id": "s2",
      "vp": "vp-seg",
      "state": "",
      "tag": "STEP 2 / 10 · 结构切换",
      "h2": "一家 CPU 公司，如何变成\"半个 AI 芯片厂\"",
      "paragraphs": [
        "FY2022，数据中心只占营收 26%，游戏+客户端合计过半；FY2026E，数据中心 <span class=\"num\">232 亿</span> 美元、占比 <b>56%</b>，客户端 116 亿占 28%，游戏 29 亿占 7%。十年里它完成了两次身份切换：CPU 跟随者 → 异构计算挑战者 → AI 第二选择。",
        "每一次身份切换，都伴随一次旧需求的出清：<span class=\"dn\">2018 矿难股价 -45%</span>、<span class=\"dn\">2022 PC 透支+熊市 -66%</span>。这是理解今天的钥匙——<b>AMD 的周期性来自客户端和游戏，AI 是新的稳定锚</b>。",
        "所以今天的问题不是\"AI 能不能赶上英伟达\"，而是：<b>56% 占比的数据中心新结构，能否在 MI400 周期里把 AI 加速器份额从 8% 抬到 15%？</b>"
      ],
      "figure": {
        "alt": "AMD EPYC 数据中心处理器",
        "caption": "AMD EPYC 服务器处理器——让 AMD 在数据中心 CPU 市场份额从 2017 年的 0.8% 抬到 2026 年的约 33%，正面反超 Intel。（Wikimedia Commons）",
        "src": ""
      }
    },
    {
      "id": "s3",
      "vp": "vp-wall",
      "state": "",
      "tag": "STEP 3 / 10 · 幸存者牌桌",
      "h2": "这个行业的出清，AMD 是两次幸存者",
      "paragraphs": [
        "第一波（1980–2006）：x86 + 图形卡混战——<b>Cyrix 被并购</b>、IBM 卖掉 PC、Motorola 分拆 Freescale、3dfx 破产资产卖给英伟达、ATI 被 AMD 以 54 亿美元收购。AMD 自己是这一波的幸存者兼并购者——<b>靠收购 ATI 完成 CPU+GPU 双线布局</b>。",
        "第二波（2016–2026）：AI 芯片创业潮——Graphcore 卖身软银、Habana 并入 Intel，<b>连英特尔自己都要靠英伟达 50 亿美元入股续命</b>；而 AMD 靠 MI300 站上了桌，2025 年还入股 Anthropic 50 亿美元绑定大客户。",
        "右侧这堵墙可以按结局筛选。<b>读旧周期之前，先认清谁后来没了——AMD 两次都在桌。</b>"
      ],
      "figure": {
        "alt": "ATI Radeon 显卡与 AMD 收购",
        "caption": "2006 年 AMD 以 54 亿美元收购 ATI——这一步让 AMD 成为唯一拥有 CPU+GPU 双线的公司，也为今天的 MI300 铺了路。（Wikimedia Commons）",
        "src": ""
      }
    },
    {
      "id": "s4",
      "vp": "vp-kline",
      "state": "full",
      "tag": "STEP 4 / 10 · 周期年表",
      "h2": "一条股价，半个世纪",
      "paragraphs": [
        "1972 年 9 月 IPO，发行价 $15.50（拆股复权约 <span class=\"num\">$0.20</span>）。54 年里它\"死\"过至少四次：<span class=\"dn\">1989 80486 衰退 -88%</span>、<span class=\"dn\">1995 濒临破产 -28%</span>、<span class=\"dn\">2002 互联网泡沫 -90%</span>、<span class=\"dn\">2008 金融危机 -75%</span>——以及最近的 <span class=\"dn\">2022 PC 透支 -66%</span>。",
        "右侧是上市以来的完整月线（对数轴，<b>涨红跌绿</b>）。2010 年以前的数据不可机读——<b>只画点、不连线，缺口本身就是证据</b>。事件 E0–E14 钉在图上，列表在图下方。",
        "注意一个细节：苏姿丰 2014 年接手时股价 $3，Zen 架构 2017 年发布后股价 $14——<b>三次\"假死\"之后的复苏，每次都是技术代际切换</b>。"
      ],
      "figure": null
    },
    {
      "id": "s5",
      "vp": "vp-kline",
      "state": "focus",
      "tag": "STEP 5 / 10 · 两轮\"假顶\"",
      "h2": "它已经死过两次，尸体上有线索",
      "paragraphs": [
        "<b>2018.09–12</b>：加密矿潮顶点 $32.72，ETH 崩盘后渠道显卡堆积，股价 <span class=\"dn\">-45%</span>。<b>2021.11–2022.10</b>：疫情透支 + 库存 155 天，股价 <span class=\"dn\">-66%</span>。右侧镜头推进到 2016–2023，看两次崩盘的形状。",
        "两次出清的共同指纹：<b>需求脉冲 → 渠道库存 → 减记 → 两个季度出清 → 新叙事接棒</b>。快、深、不留情面。",
        "今天的悬念只有一个：如果 AI capex 也误判一次，AMD 的出清会以同样方式完成吗？不同之处在于——<b>这一次 AMD 的 AI 敞口仅 15%，而英伟达是 90%；份额挑战者的下行风险更小</b>。"
      ],
      "figure": null
    },
    {
      "id": "s6",
      "vp": "vp-hf",
      "state": "",
      "tag": "STEP 6 / 10 · 领先指标",
      "h2": "读价的人，比读表的人早到",
      "paragraphs": [
        "AMD 的报表是滞后指标。真正的领先信号是<b>云厂 capex 指引</b>（领先 DC 收入 2–4 季）和 <b>GPU 现货租金</b>（领先毛利率 1–2 季）。",
        "2026 年 4 月财报季，四大云厂把 2026 年 capex 指引集体上修到约 <span class=\"num\">7,250 亿</span> 美元（<span class=\"up\">+77%</span>），AMD 作为第二大受益者订单簿投出的票清清楚楚。但另一面：<b>AMD MI300 系列年化收入约 50 亿美元，仅占四大 capex 的 0.7%</b>——蛋糕很大，但 AMD 切到的那块仍小。",
        "而 MI300X 租金约 $1.5-2.0/小时（H100 约 $1.8-2.2），AMD 卡溢价低于英伟达——<b>代际更替的常态，还是份额抢夺的先兆？</b>这正是信号卡要盯的。"
      ],
      "figure": {
        "alt": "AMD MI300X AI 加速器",
        "caption": "AMD Instinct MI300X——2023 年 12 月发布，8 个 XCD + 8 个 I/O die，正面挑战英伟达 H100，是 AMD 站上 AI 牌桌的入场券。（Wikimedia Commons）",
        "src": ""
      }
    },
    {
      "id": "s7",
      "vp": "vp-inv",
      "state": "",
      "tag": "STEP 7 / 10 · 供给纪律测谎仪",
      "h2": "库存天数：现在读数多少？",
      "paragraphs": [
        "PC 透支时，库存天数冲到 <span class=\"num\">155 天</span>（2023Q4）；矿难后压到 <span class=\"num\">119 天</span>；2026Q1 回到约 <span class=\"num\">150 天</span>——官方解释是 MI400 备料期。阈值写在图上：<b>180 天</b>。超过它且没有换机理由，就是需求证伪。",
        "供给瓶颈也在迁移：2023 年卡的是 CoWoS 封装，2025–26 年卡的是<b>HBM3e 和 CoWoS-L 产能分配</b>——AMD 拿到了 TSMC 的份额，但远低于英伟达。",
        "供给纪律的测谎仪从来不撒谎，只是读数的人经常迟到。"
      ],
      "figure": {
        "alt": "AMD EPYC 服务器处理器晶圆",
        "caption": "TSMC 5nm/3nm 制程的 EPYC 处理器晶圆——AMD 作为 fabless 设计商，制程依赖台积电，这是它与 Intel 制程双垄断时代的根本不同。（Wikimedia Commons）",
        "src": ""
      }
    },
    {
      "id": "s8",
      "vp": "vp-score",
      "state": "",
      "tag": "STEP 8 / 10 · 历史类比打分卡",
      "h2": "哪段历史最像今天？",
      "paragraphs": [
        "被引用最多的是\"<b>2000–2002 英伟达自身</b>\"：GPU 周期出清，3dfx 破产、ATI 被自己收购——AMD 是这一波的幸存者兼并购者。相似度确实最高，但 AMD 当时是 CPU 厂商靠收购转型，今天是 AI 周期的第二选择，份额 8% vs 英伟达 80%。",
        "更像的其实是<b>它自己的 2018 矿潮</b>：需求结构中 GPU 占比高，一次事件性脉冲就把股价砍半——AMD 亲历过，知道渠道库存的危险。",
        "右侧打分卡逐维对照五个历史窗口，并保留三张<b>被排除的诱人类比</b>作为负对照——形状相似，从来不等于机制相似。"
      ],
      "figure": {
        "alt": "AMD 历史股价周期",
        "caption": "AMD 54 年股价（对数轴）——四次濒死、四次复苏，每一次都靠技术代际切换爬回桌：K5→Athlon→Zen→MI300。（公司 IR）",
        "src": ""
      }
    },
    {
      "id": "s9",
      "vp": "vp-clock",
      "state": "",
      "tag": "STEP 9 / 10 · 现在到第几幕",
      "h2": "四块表，四个位置",
      "paragraphs": [
        "<b>数据中心 AI</b>：第二幕\"重新扩张\"后段——MI300 系列 AI 加速器年化收入约 50 亿，份额 8% vs 英伟达 80%。<b>客户端</b>：交付洪峰消化（AI PC 升级周期）。<b>游戏</b>：供需再平衡（PS5/Xbox 周期末段）。<b>嵌入式</b>：早期上行（赛灵思整合协同尚未充分释放）。",
        "位置由订单簿投票：云厂 capex 指引强，MI400 2026 下半年量产，CoWoS-L 产能分配到位。但 AMD 的 AI 份额仍小——<b>第二幕的故事能否走到第三幕，取决于 MI400 能否真正对标 Rubin</b>。",
        "点击右侧图例，看每个子板块的判定语。"
      ],
      "figure": {
        "alt": "AMD 四大业务板块",
        "caption": "AMD 四大业务板块：数据中心 AI / 客户端 Client / 游戏 Gaming / 嵌入式 Embedded——各有各的周期位置，偶尔同向，从不合流。（公司 IR）",
        "src": ""
      }
    },
    {
      "id": "s10",
      "vp": "vp-signal",
      "state": "",
      "tag": "STEP 10 / 10 · 监控仪表盘",
      "h2": "八个信号，八个证伪点",
      "paragraphs": [
        "监控不能共用一个仪表盘。右侧八张卡，每张都写了<b>现值、阈值、时滞、证伪点</b>——触发任何一个，不等于周期反转；2018 矿难和 2022 库存，都是\"租金 + 库存 + capex\"三个信号共振之后才成立的。",
        "其中两个信号最容易被误读：<b>毛利率</b>——MI400 爬坡期短暂低于 48% 有豁免先例（连续两季为限）；<b>库存天数</b>——MI400 备料期上升到 150 天不算违规，但超过 180 天就必须给出解释。",
        "把这张表存下来，每个财报季对一次。"
      ],
      "figure": {
        "alt": "AMD 监控仪表盘",
        "caption": "八个监测信号——云厂 capex、GPU 租金、库存天数、CoWoS 供给、DC 收入指引、ASIC 替代、毛利率、MI400 节奏——每个信号独立配阈值与证伪点。",
        "src": ""
      }
    }
  ],
  "outro": {
    "h2": "那么，AMD 现在到第几幕了？",
    "p": "2026 年 7 月 24 日，AMD 收于 <span class=\"num\">$580.91</span>，市值 <span class=\"num\">约 9,300 亿美元</span>——比 2014 年苏姿丰接手时涨了 300 多倍。但\"追赶英伟达\"不回答任何问题。要回答的是：<b>它体内那四块表，分别走到第几幕了？</b> 数据中心在第二幕后段、客户端在交付洪峰消化、游戏在供需再平衡、嵌入式在早期上行——四块表的指针很少同步，这正是 AMD 与英伟达最大的不同。",
    "verdict": "AMD 的真正风险不是\"AI 能不能赶上英伟达\"，而是：当 MI400 周期需要把份额从 8% 抬到 15% 时，ROCm 生态能否承接 CUDA 的迁移成本。位置由订单簿投票，拐点由信号共振确认——份额挑战者的下行风险更小，但上行天花板也由生态锁定决定。",
    "footgrid": [
      {
        "title": "方法论",
        "body": "industry-cycle-research 框架：分板块，不分整体；K 线即年表；缺口也是证据；订单簿是供给纪律的测谎仪；价格领先报表 1–N 季；形状相似 ≠ 机制相似（保留负对照）；监控不共用一个仪表盘。AMD 案例特别强调：份额挑战者的周期位置与生态垄断者不同步。"
      },
