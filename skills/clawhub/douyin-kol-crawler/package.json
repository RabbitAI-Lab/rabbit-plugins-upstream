{
  "name": "douyin-kol-crawler",
  "version": "1.4.0",
  "description": "抖音作品爬取工具，输入抖音URL或抖音ID，输出抖音账号基础信息和近期作品内容列表（最多10000条）。当用户提到'爬取抖音作品'、'抓取抖音KOL作品'、'抓取抖音博主作品'、'抖音作品列表'、'查看抖音视频'、'抖音内容采集'、'抓取抖音作品'时使用。",
  "keywords": [
    "douyin",
    "search",
    "hot",
    "keyword",
    "content-analysis",
    "competitor-analysis"
  ],
  "author": "um-why",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=16.14.0"
  },
  "scripts": {
    "search": "node src/douyin/search-cli.js",
    "post": "node src/douyin/post-cli.js",
    "comment": "node src/douyin/comment-cli.js",
    "hot": "node src/douyin/hot-cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/um-why/douyin-search-openclaw.git"
  }
}