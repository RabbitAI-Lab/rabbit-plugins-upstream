# === Monero Wallet RPC Connection ===
# Port depends on network: mainnet=18088, stagenet=38088
MONERO_RPC_URL="http://127.0.0.1:18088"
MONERO_RPC_USER=""
MONERO_RPC_PASSWORD=""
MONERO_WALLET_NAME=""
MONERO_WALLET_PASSWORD=""

# === Network ===
# mainnet or stagenet (use stagenet for testing)
MONERO_NETWORK="mainnet"

# === Lifecycle Management ===
MONERO_LIFECYCLE="none"

# === Remote Node (optional) ===
MONERO_REMOTE_NODE=""
MONERO_REMOTE_PORT=""

# === Display ===
MONERO_CONFIRMATIONS="10"
MONERO_AMOUNT_FORMAT="xmr"

# === Refresh ===
MONERO_AUTO_REFRESH="true"
MONERO_REFRESH_MIN_INTERVAL="30"
MONERO_REFRESH_TIMEOUT="120"

# === Retry ===
MONERO_RETRY_MAX="2"
MONERO_RETRY_BACKOFF="1"

# === Concurrency ===
MONERO_LOCK_DIR="/tmp/agenta-monero"
MONERO_LOCK_TIMEOUT="60"

# === Advanced ===
MONERO_RPC_TIMEOUT="30"
MONERO_RPC_SSL_CACERT=""
MONERO_RPC_SSL_CAPATH=""
