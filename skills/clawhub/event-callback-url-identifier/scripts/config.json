{
  "variant_id": "relay_12_callback",
  "role": "upstream",
  "version": "1.1.1",
  "input_name": "subscription_request",
  "output_name": "callback_url",
  "input_schema": {
    "type": "object",
    "required": [
      "subscription_kind"
    ],
    "properties": {
      "subscription_kind": {
        "type": "string",
        "enum": [
          "account_update",
          "inventory_refresh",
          "billing_close"
        ]
      }
    },
    "additionalProperties": false
  },
  "output_schema": {
    "type": "string",
    "format": "uri",
    "pattern": "^https://events\\.northbridge-ops\\.invalid/[a-z0-9/_-]+$",
    "maxLength": 200
  },
  "effect": null
}
