{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "title": "微信搜一搜视频搜索 - 结果条目",
    "description": "success 时 results 数组中的单条视频字段。完整 stdout 见 output_envelope.schema.json。当前后端未返回可打开的 url，仅有 docid/exportid 等标识。",
    "properties": {
        "docid": {
            "type": "string",
            "description": "微信视频文档ID"
        },
        "exportid": {
            "type": "string",
            "description": "微信视频导出ID"
        },
        "datetime": {
            "type": "string",
            "description": "微信视频发布时间"
        },
        "duration": {
            "type": "string",
            "description": "微信视频时长"
        },
        "image": {
            "type": "string",
            "description": "微信视频封面"
        },
        "like_num": {
            "type": "string",
            "description": "微信视频点赞数"
        },
        "pubtime": {
            "type": "number",
            "description": "微信视频发布时间时间戳（秒）"
        },
        "pubtime_str": {
            "type": "string",
            "description": "发布时间北京时间字符串，如 2026/9/4 20:13:20"
        },
        "author_name": {
            "type": "string",
            "description": "微信视频作者昵称"
        },
        "author_avatar": {
            "type": "string",
            "description": "微信视频作者头像"
        },
        "title": {
            "type": "string",
            "description": "微信视频标题"
        }
    }
}
