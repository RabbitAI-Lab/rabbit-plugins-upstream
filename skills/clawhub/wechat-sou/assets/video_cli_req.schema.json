{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "title": "微信搜一搜视频搜索 - 命令行入参",
    "description": "微信搜一搜视频搜索实时搜索视频, 命令行参数入参Schema详解",
    "required": [
        "keyword"
    ],
    "properties": {
        "keyword": {
            "type": "string",
            "description": "搜索关键词",
            "minLength": 2,
            "maxLength": 50
        },
        "sort": {
            "type": "number",
            "description": "排序方式: 0=综合 , 1=最新 , 2=最热",
            "default": 0,
            "enum": [
                0,
                1,
                2
            ]
        },
        "duration": {
            "type": "number",
            "description": "视频时长: 0=不限 , 1=5分钟以下 , 2=5-20分钟, 3=20分钟以上",
            "default": 0,
            "enum": [
                0,
                1,
                2,
                3
            ]
        },
        "limit": {
            "type": "number",
            "description": "搜索数量。技能硬上限 1-10000；包月 Token 实际最多 20",
            "minimum": 1,
            "maximum": 10000,
            "default": 10
        }
    },
    "additionalProperties": false
}
