{
  "name": "douyin-competitor-radar",
  "version": "1.4.2",
  "description": "对比品牌在抖音社媒上的内容表现、互动数据和讨论趋势，可结合历史数据进行分析，输出差异、证据与可执行机会，用于竞品分析、品牌对比、阶段性变化判断、品牌传播复盘和品牌策略优化。另支持单条作品详情与评论需求挖掘。",
  "keywords": [
    "douyin",
    "search",
    "hot",
    "keyword",
    "content-analysis",
    "competitor-analysis"
  ],
  "author": "um-why",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=16.14.0"
  },
  "scripts": {
    "search": "node src/douyin/search-cli.js",
    "post": "node src/douyin/post-cli.js",
    "comment": "node src/douyin/comment-cli.js",
    "detail": "node src/douyin/detail-cli.js",
    "hot": "node src/douyin/hot-cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/um-why/douyin-search-openclaw.git"
  }
