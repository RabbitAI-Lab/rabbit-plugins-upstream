{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/kya/delegation-receipt.schema.json",
  "title": "KYA Delegation Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "decision_id",
    "decision_hash",
    "action_hash",
    "action_id",
    "idempotency_key",
    "tenant_id",
    "subject_id",
    "agent_id",
    "action_type",
    "requested_action",
    "policy_version",
    "required_controls",
    "satisfied_controls",
    "control_evidence_hash",
    "approver_ids",
    "issued_at",
    "expires_at",
    "nonce",
    "one_time_use",
    "signature"
  ],
  "properties": {
    "schema_version": { "const": "2.0" },
    "receipt_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "decision_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "decision_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "action_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "action_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "idempotency_key": { "type": "string", "minLength": 16, "maxLength": 128 },
    "tenant_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "subject_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "agent_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "action_type": { "type": "string", "minLength": 1, "maxLength": 128 },
    "requested_action": { "type": "string", "minLength": 1, "maxLength": 128 },
    "policy_version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "required_controls": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "satisfied_controls": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "control_evidence_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "approver_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "nonce": { "type": "string", "minLength": 32, "maxLength": 128 },
    "one_time_use": { "const": true },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alg", "kid", "value"],
      "properties": {
        "alg": { "const": "HMAC-SHA256" },
        "kid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "value": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
