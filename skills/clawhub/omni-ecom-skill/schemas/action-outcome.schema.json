{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "omni-ecom://schemas/action-outcome-2.0.json",
  "title": "Omni E-commerce Action Outcome Record",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "artifact_type", "contract_name", "contract_version", "created_by_team_version", "legacy_compatibility", "call_key", "connector_call_id", "action_id", "approval_id", "readback_id", "outcome", "reason", "simulated", "resubmission_allowed", "observed_at"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "artifact_type": {"const": "action_outcome_record"},
    "contract_name": {"const": "omni-ecom.action-outcome"},
    "contract_version": {"const": "2.0"},
    "created_by_team_version": {"type": "string", "minLength": 1},
    "legacy_compatibility": {"const": {"read_only_import": ["omni-ecom.action-outcome@1.0"], "current_execution_authority": false}},
    "call_key": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "connector_call_id": {"type": "string", "minLength": 1},
    "action_id": {"type": "string", "minLength": 1},
    "approval_id": {"type": "string", "minLength": 1},
    "readback_id": {"type": "string", "minLength": 1},
    "outcome": {"enum": ["verified", "blocked"]},
    "reason": {"type": "string", "minLength": 1},
    "simulated": {"type": "boolean"},
    "resubmission_allowed": {"const": false},
    "observed_at": {"type": "string", "format": "date-time"}
  }
}
