{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "omni-ecom://schemas/failure-diagnostic-2.0.json",
  "title": "Omni E-commerce Non-authoritative Failure Diagnostic",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "contract_name", "contract_version", "component", "legacy_compatibility", "status", "errors", "checked_at"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "artifact_type": {"const": "failure_diagnostic"},
    "contract_name": {"const": "omni-ecom.failure-diagnostic"},
    "contract_version": {"const": "2.0"},
    "component": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,79}$"},
    "legacy_compatibility": {"const": {"read_only_import": ["omni-ecom.failure-diagnostic@1.0"], "current_authority": false}},
    "status": {"type": "string", "pattern": "_blocked$"},
    "errors": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "checked_at": {"type": "string", "minLength": 1}
  }
}
