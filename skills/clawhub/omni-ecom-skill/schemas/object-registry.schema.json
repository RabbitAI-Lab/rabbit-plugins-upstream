{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "omni-ecom://schemas/object-registry-1.0.json",
  "title": "Omni E-commerce Platform Object Registry",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "client_scope", "platform", "object_type", "platform_id", "label", "status", "seen_at"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "client_scope": { "type": "string", "minLength": 1 },
    "platform": { "type": "string", "minLength": 1 },
    "account_id": { "type": "string" },
    "store_id": { "type": "string" },
    "object_type": { "type": "string", "minLength": 1 },
    "platform_id": { "type": "string", "minLength": 1 },
    "label": { "type": "string", "minLength": 1 },
    "status": { "enum": ["active", "disabled", "unverified", "ambiguous"] },
    "seen_at": { "type": "string", "format": "date-time" }
  }
}
