{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "omni-ecom://schemas/model-route-2.0.json",
  "title": "Observed model route; not a request to change the host model",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "contract_name", "contract_version", "created_by_team_version", "legacy_compatibility", "model_alias", "model_name", "model_version", "prompt_version", "task_class", "role", "host", "agent_task_id", "attempt_id", "observed_at", "terminal_event_hash", "terminal_kind", "source_file", "source_sha256", "evidence_kind", "telemetry_state", "limitations", "quality_result"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "artifact_type": {"const": "model_observation_record"},
    "contract_name": {"const": "omni-ecom.model-observation"},
    "contract_version": {"const": "2.0"},
    "created_by_team_version": {"type": "string", "minLength": 1},
    "legacy_compatibility": {"const": {"read_only_import": ["omni-ecom.model-observation@1.0"], "current_quality_authority": false}},
    "model_alias": {"type": "string", "minLength": 1},
    "model_name": {"type": ["string", "null"]},
    "model_version": {"type": ["string", "null"]},
    "prompt_version": {"type": ["string", "null"]},
    "task_class": {"type": "string", "minLength": 1},
    "role": {"type": "string", "minLength": 1},
    "host": {"enum": ["workbuddy", "codex"]},
    "agent_task_id": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "format": "date-time"},
    "terminal_event_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "terminal_kind": {"enum": ["member_returned", "member_rejected", "member_failed"]},
    "source_file": {"type": "string", "minLength": 1},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence_kind": {"type": "string", "minLength": 1},
    "latency_ms": {"type": ["number", "null"], "minimum": 0},
    "cost": {"type": ["number", "null"], "minimum": 0},
    "currency": {"type": ["string", "null"], "pattern": "^[A-Z]{3}$"},
    "input_tokens": {"type": ["integer", "null"], "minimum": 0},
    "output_tokens": {"type": ["integer", "null"], "minimum": 0},
    "telemetry_state": {"enum": ["unavailable", "recorded", "partial", "invalid"]},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "quality_result": {"type": "object", "additionalProperties": false, "required": ["handoff_status"],
      "properties": {"handoff_status": {"enum": ["accepted", "rejected", "host_failed"]}}}
  }
}
