{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "omni-ecom://schemas/connector-call-1.0.json",
  "title": "Omni E-commerce Connector Call",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "call_id", "connector_id", "platform", "run_id", "client_scope", "action_id", "operation", "target_ids", "mode", "request_hash", "status", "started_at"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "call_id": { "type": "string", "pattern": "^C[A-Za-z0-9._-]{2,80}$" },
    "connector_id": { "type": "string", "minLength": 1 },
    "platform": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,80}$" },
    "client_scope": { "type": "string", "minLength": 1 },
    "action_id": { "type": "string", "minLength": 1 },
    "operation": { "type": "string", "minLength": 1 },
    "target_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "mode": { "enum": ["dry_run", "live"] },
    "request_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "idempotency_key": { "type": "string", "minLength": 1 },
    "status": { "enum": ["proposed", "dry_run", "executed", "failed", "blocked", "readback_pending", "verified"] },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": ["string", "null"], "format": "date-time" },
    "response_code": { "type": ["integer", "null"] },
    "error_class": { "type": ["string", "null"] }
  }
}
