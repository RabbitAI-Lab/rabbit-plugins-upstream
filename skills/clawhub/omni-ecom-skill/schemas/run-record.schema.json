{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "omni-ecom://schemas/run-record-2.0.json",
  "title": "Omni E-commerce Derived Run Status Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "contract_name", "contract_version", "created_by_team_version", "authority", "legacy_compatibility", "run_id", "client_scope", "team_version", "task_type", "runtime_status"],
  "properties": {
    "schema_version": { "const": "2.0" },
    "artifact_type": { "const": "run_status_snapshot" },
    "contract_name": { "const": "omni-ecom.run-record" },
    "contract_version": { "const": "2.0" },
    "created_by_team_version": { "type": "string", "minLength": 1 },
    "authority": { "const": "derived_from_run_journal_sqlite" },
    "legacy_compatibility": {
      "type": "object", "additionalProperties": false,
      "required": ["read_only_import", "current_runtime_authority"],
      "properties": {
        "read_only_import": { "const": ["omni-ecom.run-record@1.0"] },
        "current_runtime_authority": { "const": false }
      }
    },
    "run_id": { "type": "string", "minLength": 3 },
    "client_scope": { "type": "string", "minLength": 1 },
    "team_version": { "type": "string", "minLength": 1 },
    "task_type": { "type": "string", "minLength": 1 },
    "runtime_status": { "type": "object" }
  }
}
