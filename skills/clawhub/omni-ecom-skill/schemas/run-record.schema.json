{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "omni-ecom://schemas/run-record-1.0.json",
  "title": "Omni E-commerce Run Record",
  "type": "object",
  "required": ["schema_version", "run_id", "client_scope", "package_version", "created_at", "status", "paths"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "run_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,80}$" },
    "client_scope": { "type": "string", "minLength": 1 },
    "package_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "created_at": { "type": "string", "format": "date-time" },
    "status": { "enum": ["created", "intake", "data_blocked", "analyzing", "draft_diagnosis", "ready_for_review", "approved", "executed", "verified", "failed"] },
    "paths": {
      "type": "object",
      "required": ["inputs", "outputs", "evidence", "approvals", "artifacts", "events"],
      "additionalProperties": { "type": "string" }
    },
    "input_manifest": { "type": "array" },
    "artifact_refs": { "type": "array" },
    "approval_refs": { "type": "array" },
    "action_refs": { "type": "array" },
    "outcome_refs": { "type": "array" },
    "report_refs": { "type": "array" }
    ,"connector_call_refs": { "type": "array" }
    ,"readback_refs": { "type": "array" }
    ,"model_route_refs": { "type": "array" }
  }
}
