{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "omni-ecom://schemas/action-record-1.0.json",
  "title": "Omni E-commerce Action Record",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "action_id",
    "run_id",
    "client_scope",
    "priority",
    "action",
    "owner",
    "target",
    "acceptance",
    "stop_condition",
    "approval_required",
    "approval_state",
    "status",
    "proposed_at",
    "source_ids"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "action_id": { "type": "string", "pattern": "^A[A-Za-z0-9._-]{2,80}$" },
    "run_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,80}$" },
    "client_scope": { "type": "string", "minLength": 1 },
    "priority": { "enum": ["P0", "P1", "P2"] },
    "action": { "type": "string", "minLength": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "target": { "type": "string", "minLength": 1 },
    "baseline": { "type": "string" },
    "acceptance": { "type": "string", "minLength": 1 },
    "stop_condition": { "type": "string", "minLength": 1 },
    "approval_required": { "type": "boolean" },
    "approval_state": { "enum": ["not_required", "pending", "approved", "rejected"] },
    "status": { "enum": ["proposed", "pending_approval", "approved", "rejected", "scheduled", "executed", "verified", "rolled_back", "blocked"] },
    "proposed_at": { "type": "string", "format": "date-time" },
    "approved_at": { "type": ["string", "null"], "format": "date-time" },
    "executed_at": { "type": ["string", "null"], "format": "date-time" },
    "verified_at": { "type": ["string", "null"], "format": "date-time" },
    "outcome": { "type": ["object", "null"] },
    "source_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "artifact_refs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "events_file": { "type": "string" }
  }
}
