{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "omni-ecom://schemas/review-release-2.0.json",
  "title": "Omni E-commerce Review Release Receipt",
  "type": "object",
  "required": ["schema_version", "artifact_type", "contract_name", "contract_version", "created_by_team_version", "legacy_compatibility", "status", "run_id", "client_scope", "team_version", "report_revision", "manifest_sha256", "review_agent_id", "review_agent_task_id", "review_attempt_id", "review_attestation_sha256", "artifacts", "verified_at"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "artifact_type": {"const": "review_release_receipt"},
    "contract_name": {"const": "omni-ecom.review-release"},
    "contract_version": {"const": "2.0"},
    "created_by_team_version": {"type": "string", "minLength": 1},
    "legacy_compatibility": {"const": {"read_only_import": ["omni-ecom.review-release@1.0"], "current_completion_authority": false}},
    "status": {"const": "review_release_verified"},
    "run_id": {"type": "string", "minLength": 1},
    "client_scope": {"type": "string", "minLength": 1},
    "team_version": {"type": "string", "minLength": 1},
    "report_revision": {"type": "string", "minLength": 1},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "review_agent_id": {"const": "delivery-review"},
    "review_agent_task_id": {"type": "string", "minLength": 1},
    "review_attempt_id": {"type": "string", "minLength": 1},
    "review_attestation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifacts": {"type": "array", "minItems": 1},
    "verified_at": {"type": "string", "minLength": 1}
  }
}
