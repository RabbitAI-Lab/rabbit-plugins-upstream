{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "omni-ecom://schemas/report-package-2.0.json",
  "title": "Omni E-commerce Report Package",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "artifact_type",
    "contract_name",
    "contract_version",
    "created_by_team_version",
    "input_contracts",
    "legacy_compatibility",
    "team_id",
    "team_version",
    "team_version_changes",
    "version_diff",
    "report_revision",
    "task_type",
    "task_profile",
    "review_stage",
    "collaboration_mode",
    "collaboration_status",
    "expert_participation",
    "run_id",
    "client_scope",
    "gate_status",
    "status",
    "title",
    "period",
    "scope",
    "data_gate",
    "claim_ledger",
    "metrics",
    "facts",
    "judgments",
    "actions",
    "missing_data",
    "sources",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "artifact_type": { "const": "report_package" },
    "contract_name": { "const": "omni-ecom.report-package" },
    "contract_version": { "const": "2.0" },
    "created_by_team_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "input_contracts": {
      "type": "object",
      "required": ["handoff", "claim_ledger"],
      "properties": {
        "handoff": { "const": "2.0" },
        "claim_ledger": { "const": "2.0" }
      },
      "additionalProperties": false
    },
    "legacy_compatibility": {
      "type": "object",
      "required": ["read_only_import", "execution_permission_inherited", "approval_inherited"],
      "properties": {
        "read_only_import": { "const": ["omni-ecom.report-package@1.0"] },
        "execution_permission_inherited": { "const": false },
        "approval_inherited": { "const": false }
      },
      "additionalProperties": false
    },
    "team_id": {
      "type": "string",
      "minLength": 1
    },
    "team_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "team_version_label": {
      "type": "string",
      "minLength": 1
    },
    "team_release_name": {
      "type": "string",
      "minLength": 1
    },
    "team_release_date": {
      "type": ["string", "null"]
    },
    "team_previous_version": {
      "type": "string"
    },
    "team_version_changes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "version_diff": {
      "type": "object"
    },
    "collaboration_mode": {
      "enum": [
        "comprehensive",
        "single_point"
      ]
    },
    "report_revision": {
      "type": "string",
      "pattern": "^R[1-9][0-9]*$"
    },
    "task_type": {
      "enum": [
        "store_diagnosis",
        "weekly_report",
        "monthly_report",
        "quarterly_report",
        "annual_report",
        "campaign_review",
        "data_quality_audit",
        "single_topic"
      ]
    },
    "task_profile": {
      "type": "object"
    },
    "review_stage": {
      "enum": [
        "awaiting_delivery_review",
        "not_required"
      ]
    },
    "collaboration_status": {
      "enum": [
        "awaiting_delivery_review",
        "verified_data_gate",
        "single_point"
      ]
    },
    "expert_participation": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": [
          "agent_id",
          "display_name",
          "profession",
          "role",
          "participation_status",
          "agent_task_ids",
          "contribution_summary",
          "handoff_files",
          "handoff_sha256"
        ],
        "properties": {
          "agent_id": {
            "type": "string",
            "minLength": 1
          },
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "profession": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "lead",
              "member"
            ]
          },
          "participation_status": {
            "enum": [
              "contributed",
              "pending_review",
              "not_invoked"
            ]
          },
          "agent_task_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(?:agent-[0-9A-Za-z_-]+|[0-9a-fA-F]{8}(?:-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12})$"
            }
          },
          "agent_view_urls": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "agent_return_statuses": {
            "type": "array",
            "items": {
              "const": "completed"
            }
          },
          "agent_returned_at": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "agent_return_files": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[^/\\\\]+\\.return\\.json$"
            }
          },
          "contribution_summary": {
            "type": "string"
          },
          "handoff_files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "handoff_sha256": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,80}$"
    },
    "client_scope": {
      "type": "string",
      "minLength": 1
    },
    "gate_status": {
      "enum": [
        "PASS",
        "WARN",
        "BLOCKED"
      ]
    },
    "status": {
      "enum": [
        "data_blocked",
        "draft_diagnosis",
        "ready_for_review"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "period": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object"
    },
    "data_gate": {
      "type": "object"
    },
    "stage0": {
      "type": "object",
      "description": "Stage 0 report identification, grouping and coverage status (v1.6.0).",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "stage0_complete",
            "stage0_missing"
          ]
        },
        "report_count": {
          "type": "integer",
          "minimum": 0
        },
        "cluster_count": {
          "type": "integer",
          "minimum": 0
        },
        "chapter_count": {
          "type": "integer",
          "minimum": 0
        },
        "coverage_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "report_inventory_sha256": {
          "type": "string"
        },
        "report_clusters_sha256": {
          "type": "string"
        },
        "chapter_plan_sha256": {
          "type": "string"
        },
        "coverage_sha256": {
          "type": "string"
        }
      }
    },
    "report_inventory": {
      "type": "object",
      "description": "Full inventory of every uploaded report (Stage 0 step 1)."
    },
    "report_clusters": {
      "type": "object",
      "description": "Three-axis grouping result (Stage 0 step 2)."
    },
    "chapter_plan": {
      "type": "object",
      "description": "Dynamic report outline derived from the clusters (Stage 0 step 3)."
    },
    "coverage": {
      "type": "object",
      "description": "Coverage gate result proving no report was dropped (Stage 0 step 4)."
    },
    "claim_ledger": {
      "type": "object",
      "required": [
        "file",
        "sha256",
        "claims_count",
        "claims"
      ],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "claims_count": {
          "type": "integer",
          "minimum": 1
        },
        "verified_count": {
          "type": "integer",
          "minimum": 0
        },
        "derived_count": {
          "type": "integer",
          "minimum": 0
        },
        "unknown_count": {
          "type": "integer",
          "minimum": 0
        },
        "claims": {
          "type": "array",
          "minItems": 1
        }
      }
    },
    "metrics": {
      "type": "array"
    },
    "facts": {
      "type": "array", "items": { "$ref": "#/$defs/narrative_item" }
    },
    "judgments": {
      "type": "array", "items": { "$ref": "#/$defs/narrative_item" }
    },
    "hypotheses": {
      "type": "array", "items": { "$ref": "#/$defs/narrative_item" }
    },
    "actions": {
      "type": "array", "items": { "$ref": "#/$defs/narrative_item" }
    },
    "missing_data": {
      "type": "array"
    },
    "risks": {
      "type": "array"
    },
    "sources": {
      "type": "array"
    },
    "narrative_value_gate": { "type": "object" },
    "artifact_contract_gate": { "type": "object" },
    "provenance": {
      "type": "object"
    }
  },
  "$defs": {
    "narrative_item": {
      "type": "object",
      "properties": {
        "number_bindings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["field", "token", "occurrence", "kind"],
            "properties": {
              "field": { "type": "string", "minLength": 1 },
              "token": { "type": "string", "minLength": 1 },
              "occurrence": { "type": "integer", "minimum": 1 },
              "kind": { "enum": ["claim", "proposal"] },
              "claim_id": { "type": "string", "pattern": "^C-[A-Za-z0-9_-]+$" },
              "label": { "enum": ["target", "threshold", "test_budget", "sample_size"] },
              "basis_claim_ids": { "type": "array", "minItems": 1, "uniqueItems": true,
                "items": { "type": "string", "pattern": "^C-[A-Za-z0-9_-]+$" } },
              "rationale": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
