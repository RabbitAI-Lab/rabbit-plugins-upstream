{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "omni-ecom://schemas/review-attestation-1.0.json",
  "title": "Omni E-commerce Delivery Review Attestation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "agent_id", "agent_task_id", "review_attempt_id", "report_revision", "return_status", "returned_at", "review_status", "reviewed_manifest_sha256", "reviewed_artifacts", "findings", "required_changes", "contribution_summary", "response"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "run_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,80}$" },
    "agent_id": { "const": "delivery-review" },
    "agent_task_id": { "type": "string", "pattern": "^agent-[0-9A-Za-z_-]+$" },
    "review_attempt_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,80}$" },
    "report_revision": { "type": "string", "pattern": "^R[1-9][0-9]*$" },
    "return_status": { "const": "completed" },
    "returned_at": { "type": "string", "minLength": 1 },
    "review_status": { "enum": ["passed", "conditional_pass", "rejected"] },
    "reviewed_manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "reviewed_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "sha256"],
        "properties": {
          "file": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "findings": { "type": "array", "items": { "type": "string" } },
    "required_changes": { "type": "array", "items": { "type": "string" } },
    "contribution_summary": { "type": "string", "minLength": 1 },
    "response": { "type": "object" }
  }
}
