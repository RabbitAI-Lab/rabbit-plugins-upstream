{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "omni-ecom://schemas/review-attestation-2.0.json",
  "title": "Omni E-commerce Delivery Review Attestation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "contract_name", "contract_version", "created_by_team_version", "legacy_compatibility", "run_id", "agent_id", "agent_task_id", "review_attempt_id", "report_revision", "return_status", "returned_at", "review_status", "reviewed_manifest_sha256", "reviewed_artifacts", "findings", "required_changes", "contribution_summary", "response"],
  "properties": {
    "schema_version": { "const": "2.0" },
    "artifact_type": { "const": "review_attestation" },
    "contract_name": { "const": "omni-ecom.review-attestation" },
    "contract_version": { "const": "2.0" },
    "created_by_team_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z]+(?:\\.[0-9A-Za-z-]+)*)?$" },
    "legacy_compatibility": { "const": {"read_only_import": ["omni-ecom.review-attestation@1.0"], "current_completion_authority": false} },
    "run_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,80}$" },
    "agent_id": { "const": "delivery-review" },
    "agent_task_id": { "type": "string", "pattern": "^(?:agent-[0-9A-Za-z_-]+|[0-9a-fA-F]{8}(?:-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12})$" },
    "review_attempt_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,80}$" },
    "review_result_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "report_revision": { "type": "string", "pattern": "^R[1-9][0-9]*$" },
    "return_status": { "const": "completed" },
    "returned_at": { "type": "string", "minLength": 1 },
    "review_status": { "enum": ["passed", "conditional_pass", "rejected"] },
    "reviewed_manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "reviewed_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "sha256"],
        "properties": {
          "file": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "findings": { "type": "array", "items": { "type": "string" } },
    "required_changes": { "type": "array", "items": { "type": "string" } },
    "contribution_summary": { "type": "string", "minLength": 1 },
    "response": { "type": "object" }
  }
}
