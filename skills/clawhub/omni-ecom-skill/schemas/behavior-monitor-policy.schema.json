{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "omni-ecom://schemas/behavior-monitor-policy-2.0.json",
  "title": "Omni E-commerce Behavior Monitor Policy Record",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "artifact_type", "contract_name", "contract_version", "created_by_team_version", "legacy_compatibility", "policy_id", "revision", "sha256"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "artifact_type": {"const": "behavior_monitor_policy_record"},
    "contract_name": {"const": "omni-ecom.behavior-monitor-policy"},
    "contract_version": {"const": "2.0"},
    "created_by_team_version": {"type": "string", "minLength": 1},
    "legacy_compatibility": {"const": {"read_only_import": ["omni-ecom.behavior-monitor-policy@1.0"], "current_quality_authority": false}},
    "policy_id": {"type": "string", "minLength": 1},
    "revision": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "previous_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
  }
}
