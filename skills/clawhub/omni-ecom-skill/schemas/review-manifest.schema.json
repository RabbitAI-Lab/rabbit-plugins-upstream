{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "omni-ecom://schemas/review-manifest-1.0.json",
  "title": "Omni E-commerce Immutable Review Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "run_id", "client_scope", "team_version", "report_revision", "created_at", "artifacts", "sources", "manifest_sha256"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "status": { "const": "awaiting_delivery_review" },
    "run_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,80}$" },
    "client_scope": { "type": "string", "minLength": 1 },
    "team_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "report_revision": { "type": "string", "pattern": "^R[1-9][0-9]*$" },
    "created_at": { "type": "string", "minLength": 1 },
    "artifacts": { "$ref": "#/$defs/files" },
    "sources": { "$ref": "#/$defs/files" },
    "manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "$defs": {
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "path", "sha256", "bytes"],
        "properties": {
          "file": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
