{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "omni-ecom://schemas/normalized-report-2.0.json",
  "title": "Omni E-commerce Normalized Report Bundle",
  "type": "object",
  "required": ["schema_version", "artifact_type", "contract_name", "contract_version", "created_by_team_version", "legacy_compatibility", "run_id", "client_scope", "team_version", "normalized_schema", "source_manifest", "rows", "warnings"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "artifact_type": {"const": "normalized_report_bundle"},
    "contract_name": {"const": "omni-ecom.normalized-report"},
    "contract_version": {"const": "2.0"},
    "created_by_team_version": {"type": "string", "minLength": 1},
    "legacy_compatibility": {"const": {"read_only_import": ["omni-ecom.normalized-report@1.0"], "current_numeric_authority": false}},
    "run_id": {"type": "string", "minLength": 3},
    "client_scope": {"type": "string", "minLength": 1},
    "team_version": {"type": "string", "minLength": 1},
    "normalized_schema": {"const": "ecom-period-metrics-2.0"},
    "source_manifest": {
      "type": "object",
      "required": ["file_name", "size_bytes", "sha256", "platform", "selected_sheets", "available_sheets"],
      "properties": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    },
    "rows": {"type": "array"},
    "warnings": {"type": "array"}
  }
}
