{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "omni-ecom://schemas/credential-ref-1.0.json",
  "title": "Omni E-commerce Credential Reference",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "credential_id", "provider", "secret_ref", "scope", "expires_at", "status"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "credential_id": { "type": "string", "pattern": "^CR[A-Za-z0-9._-]{2,80}$" },
    "provider": { "type": "string", "minLength": 1 },
    "secret_ref": { "type": "string", "minLength": 1 },
    "scope": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
    "expires_at": { "type": ["string", "null"], "format": "date-time" },
    "status": { "enum": ["unverified", "active", "expired", "revoked"] }
  }
}
