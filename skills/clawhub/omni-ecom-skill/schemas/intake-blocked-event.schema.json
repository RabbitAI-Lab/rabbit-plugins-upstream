    "artifact_type": {"const": "intake_blocked_event"},
    "contract_name": {"const": "omni-ecom.intake-blocked-event"},
    "contract_version": {"const": "2.0"},
    "created_by_team_version": {"type": "string", "minLength": 1},
    "legacy_compatibility": {"const": {"read_only_import": ["omni-ecom.intake-blocked-event@1.0"], "current_completion_authority": false}},
    "receipt_file": {"type": "string", "minLength": 1},
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reason_code": {"const": "no_supported_files"},
    "report_generated": {"const": false}
  }
}
