{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "omni-ecom://schemas/intake-blocked-event-2.0.json",
  "title": "Omni E-commerce Zero-input Terminal Audit Event",
  "type": "object",
