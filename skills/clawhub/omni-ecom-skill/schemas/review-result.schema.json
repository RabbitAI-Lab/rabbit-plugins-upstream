{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "omni-ecom://schemas/review-result-2.0.json",
  "title": "Omni E-commerce Native Reviewer Result",
  "type": "object",
  "required": ["schema_version", "artifact_type", "contract_name", "contract_version", "created_by_team_version", "legacy_compatibility", "run_id", "client_scope", "agent_id", "agent_version", "review_attempt_id", "report_revision", "return_status", "returned_at", "review_status", "reviewed_manifest_sha256", "reviewed_artifacts", "findings", "required_changes", "contribution_summary"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "artifact_type": {"const": "review_result"},
    "contract_name": {"const": "omni-ecom.review-result"},
    "contract_version": {"const": "2.0"},
    "created_by_team_version": {"type": "string", "minLength": 1},
    "legacy_compatibility": {"const": {"read_only_import": ["omni-ecom.review-result@1.0"], "current_completion_authority": false}},
    "run_id": {"type": "string", "minLength": 1},
    "client_scope": {"type": "string", "minLength": 1},
    "agent_id": {"const": "delivery-review"},
    "agent_version": {"type": "string", "minLength": 1},
    "review_attempt_id": {"type": "string", "minLength": 1},
    "report_revision": {"type": "string", "minLength": 1},
    "return_status": {"const": "completed"},
    "returned_at": {"type": "string", "minLength": 1},
    "review_status": {"enum": ["passed", "conditional_pass", "rejected"]},
    "reviewed_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reviewed_artifacts": {"type": "array", "minItems": 1},
    "findings": {"type": "array"},
    "required_changes": {"type": "array"},
    "contribution_summary": {"type": "string", "minLength": 1}
  }
}
