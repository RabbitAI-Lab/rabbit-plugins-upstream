{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "omni-ecom://schemas/pdf-delivery-2.0.json",
  "title": "Chart-led PDF delivery receipt",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "artifact_type",
    "contract_name",
    "contract_version",
    "created_by_team_version",
    "legacy_compatibility",
    "status",
    "team_version",
    "report_revision",
    "report_file",
    "report_sha256",
    "chart_count",
    "page_count",
    "blank_pages",
    "verified_at"
  ],
  "properties": {
    "schema_version": { "const": "2.0" },
    "artifact_type": { "const": "pdf_delivery_receipt" },
    "contract_name": { "const": "omni-ecom.pdf-delivery" },
    "contract_version": { "const": "2.0" },
    "created_by_team_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z]+(?:\\.[0-9A-Za-z-]+)*)?$" },
    "legacy_compatibility": {
      "const": {"read_only_import": ["omni-ecom.pdf-delivery@1.0"], "current_completion_authority": false}
    },
    "status": { "const": "pdf_render_verified" },
    "team_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z]+(?:\\.[0-9A-Za-z-]+)*)?$" },
    "report_revision": { "type": "string", "pattern": "^R[1-9][0-9]*$" },
    "report_file": { "const": "report.pdf" },
    "report_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "chart_count": { "type": "integer", "minimum": 3 },
    "page_count": { "type": "integer", "minimum": 1, "maximum": 120 },
    "page_limit": { "type": "integer", "minimum": 17, "maximum": 120 },
    "blank_pages": { "type": "array", "maxItems": 0 },
    "verified_at": { "type": "string", "minLength": 1 }
  }
}
