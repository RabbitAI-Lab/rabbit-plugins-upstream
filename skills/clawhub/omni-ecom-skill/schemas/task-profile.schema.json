{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "omni-ecom://schemas/task-profile-1.0.json",
  "title": "Omni E-commerce Task Profiles",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "default_task_type", "profiles"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "default_task_type": { "type": "string", "minLength": 1 },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["display_name", "default_title", "period_grain", "comparison_expectation", "decision_focus", "default_collaboration_mode", "required_delivery", "minimum_charts"],
        "properties": {
          "display_name": { "type": "string", "minLength": 1 },
          "default_title": { "type": "string", "minLength": 1 },
          "period_grain": { "type": "string", "minLength": 1 },
          "comparison_expectation": { "type": "string", "minLength": 1 },
          "decision_focus": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "default_collaboration_mode": { "enum": ["comprehensive", "single_point"] },
          "required_delivery": { "type": "array", "minItems": 4, "items": { "type": "string", "minLength": 1 } },
          "minimum_charts": { "type": "integer", "minimum": 3 }
        }
      }
    }
  }
}
