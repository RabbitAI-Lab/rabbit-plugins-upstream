{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "omni-ecom://schemas/completion-receipt-1.0.json",
  "title": "Omni E-commerce Formal Delivery Completion Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "run_id", "client_scope", "team_version", "report_revision", "task_type", "collaboration_mode", "review_required", "claim_guard_status", "public_output_guard_status", "expert_activity", "artifacts", "completed_at"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "status": { "const": "formal_delivery_complete" },
    "run_id": { "type": "string", "minLength": 1 },
    "client_scope": { "type": "string", "minLength": 1 },
    "team_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "report_revision": { "type": "string", "pattern": "^R[1-9][0-9]*$" },
    "task_type": { "type": "string", "minLength": 1 },
    "collaboration_mode": { "enum": ["comprehensive", "single_point"] },
    "review_required": { "type": "boolean" },
    "review_attempt_id": { "type": "string" },
    "review_agent_task_id": { "type": "string" },
    "claim_guard_status": { "const": "claim_guard_passed" },
    "public_output_guard_status": { "const": "public_output_guard_passed" },
    "expert_activity": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["agent_id", "participation_status", "agent_task_ids", "contribution_summary"],
        "properties": {
          "agent_id": { "type": "string", "minLength": 1 },
          "participation_status": { "enum": ["contributed", "not_invoked"] },
          "agent_task_ids": { "type": "array", "items": { "type": "string" } },
          "contribution_summary": { "type": "string" }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "sha256", "bytes"],
        "properties": {
          "file": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "bytes": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "release_receipt_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "completed_at": { "type": "string", "minLength": 1 }
  }
}
