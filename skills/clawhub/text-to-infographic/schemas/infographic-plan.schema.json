{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Infographic Plan",
  "type": "object",
  "required": ["version", "meta", "layout", "blocks"],
  "properties": {
    "version": { "const": "1.0" },
    "meta": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "title": { "type": "string", "maxLength": 40 },
        "subtitle": { "type": "string", "maxLength": 60 },
        "goal": { "type": "string" },
        "source_note": { "type": "string" },
        "footer": { "type": "string" }
      }
    },
    "layout": {
      "enum": ["flywheel", "fishbone", "sankey", "pyramid", "timeline", "dashboard"]
    },
    "visual_system": {
      "type": "object",
      "properties": {
        "palette": { "enum": ["terracotta", "ocean", "forest", "ink", "mono"], "default": "terracotta" },
        "accent": { "type": "string", "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$" }
      }
    },
    "blocks": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
          "title": { "type": "string", "maxLength": 24 },
          "text": { "type": "string", "maxLength": 120 },
          "value": { "type": ["string", "number"] },
          "unit": { "type": "string" },
          "time": { "type": "string" },
          "metric": { "type": "string" },
          "group": { "type": "string" },
          "role": { "enum": ["head", "cause", "stage", "step"] },
          "source_ref": { "type": "string" }
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "label": { "type": "string" },
          "weight": { "type": "number", "minimum": 0 }
        }
      }
    }
  }
}
