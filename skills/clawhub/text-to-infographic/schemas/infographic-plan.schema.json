{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://text-to-infographic.local/schemas/infographic-plan.schema.json",
  "title": "TextToInfographic Plan v0.5.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "infographic_id",
    "intent",
    "chart_family",
    "language",
    "audience",
    "message",
    "layout",
    "blocks"
  ],
  "properties": {
    "infographic_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "intent": {
      "type": "string",
      "enum": [
        "explain",
        "summarize",
        "compare",
        "diagnose",
        "plan",
        "dashboard",
        "persuade"
      ]
    },
    "chart_family": {
      "type": "string",
      "enum": [
        "flywheel",
        "fishbone",
        "pyramid",
        "sankey",
        "roadmap",
        "dashboard",
        "process",
        "comparison",
        "custom"
      ]
    },
    "language": {
      "type": "string"
    },
    "audience": {
      "type": "string"
    },
    "source_summary": {
      "type": "string"
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "core_takeaway"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "core_takeaway": {
          "type": "string"
        },
        "cta": {
          "type": "string"
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layout_mode",
        "coordinate_system",
        "aspect_ratio",
        "reading_order"
      ],
      "properties": {
        "layout_mode": {
          "type": "string",
          "enum": [
            "radial",
            "spine-branch",
            "pyramid",
            "flow",
            "timeline",
            "grid",
            "dashboard",
            "freeform"
          ]
        },
        "coordinate_system": {
          "type": "string",
          "enum": [
            "cartesian",
            "polar",
            "hybrid"
          ]
        },
        "aspect_ratio": {
          "type": "string",
          "enum": [
            "1:1",
            "4:5",
            "16:9",
            "9:16",
            "custom"
          ]
        },
        "reading_order": {
          "type": "string",
          "enum": [
            "clockwise",
            "counterclockwise",
            "left-to-right",
            "top-to-bottom",
            "center-out",
            "custom"
          ]
        },
        "density": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        }
      }
    },
    "visual_system": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "theme_id": {
          "type": "string"
        },
        "palette_mode": {
          "type": "string",
          "enum": [
            "brand",
            "mono",
            "duo",
            "triad",
            "custom"
          ]
        },
        "emphasis_style": {
          "type": "string",
          "enum": [
            "clean",
            "editorial",
            "playful",
            "technical",
            "luxury"
          ]
        },
        "premium_style": {
          "type": "string",
          "enum": [
            "data-journal",
            "night-ops"
          ]
        },
        "brand_colors": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 5
        }
      }
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "block_id",
          "block_type",
          "title",
          "content",
          "visual_role"
        ],
        "properties": {
          "block_id": {
            "type": "string"
          },
          "block_type": {
            "type": "string",
            "enum": [
              "title",
              "summary",
              "stage",
              "cause",
              "effect",
              "metric",
              "node",
              "callout",
              "legend",
              "note",
              "cta",
              "custom"
            ]
          },
          "title": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "visual_role": {
            "type": "string",
            "enum": [
              "primary",
              "secondary",
              "supporting"
            ]
          },
          "group_id": {
            "type": "string"
          },
          "icon_hint": {
            "type": "string"
          },
          "payload": {
            "type": "object"
          },
          "must_include": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "avoid": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "text_budget": {
            "type": "integer",
            "minimum": 0
          },
          "metric_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "claim_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "relation_type"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "relation_type": {
            "type": "string",
            "enum": [
              "flow",
              "cause",
              "contain",
              "compare",
              "loop",
              "depends-on",
              "highlights",
              "custom"
            ]
          },
          "label": {
            "type": "string"
          },
          "weight": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "primary_target": {
          "type": "string",
          "enum": [
            "svg",
            "whiteboard",
            "doc",
            "png",
            "html"
          ]
        },
        "secondary_targets": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "svg",
              "whiteboard",
              "doc",
              "png",
              "html"
            ]
          }
        },
        "doc_mode": {
          "type": "string",
          "enum": [
            "overview-only",
            "overview-plus-links",
            "companion-detail"
          ]
        }
      }
    },
    "data_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "title",
          "source_type"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "title": {
            "type": "string"
          },
          "source_type": {
            "type": "string",
            "enum": [
              "dataset",
              "report",
              "research",
              "survey",
              "api",
              "database",
              "interview",
              "web",
              "internal",
              "derived",
              "other"
            ]
          },
          "publisher": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "citation": {
            "type": "string"
          },
          "published_at": {
            "type": "string"
          },
          "accessed_at": {
            "type": "string"
          },
          "methodology": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metric_id",
          "label",
          "value",
          "period",
          "source_ids"
        ],
        "properties": {
          "metric_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "label": {
            "type": "string"
          },
          "value": {
            "type": "number"
          },
          "display_value": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "period": {
            "type": "string"
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "baseline": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "period"
            ],
            "properties": {
              "value": {
                "type": "number"
              },
              "period": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "source_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "delta": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "unit"
            ],
            "properties": {
              "value": {
                "type": "number"
              },
              "unit": {
                "type": "string",
                "enum": [
                  "absolute",
                  "percent",
                  "percentage-point"
                ]
              },
              "direction": {
                "type": "string",
                "enum": [
                  "up",
                  "down",
                  "flat"
                ]
              }
            }
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "statement",
          "block_ids"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "statement": {
            "type": "string"
          },
          "claim_type": {
            "type": "string",
            "enum": [
              "fact",
              "comparison",
              "trend",
              "causal",
              "interpretation",
              "recommendation"
            ]
          },
          "metric_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "source_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "block_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "qualification": {
            "type": "string"
          }
        }
      }
    },
    "story_arc": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stages"
      ],
      "properties": {
        "thesis_claim_id": {
          "type": "string"
        },
        "stages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stage_id",
              "role",
              "claim_ids"
            ],
            "properties": {
              "stage_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]+$"
              },
              "role": {
                "type": "string",
                "enum": [
                  "hook",
                  "context",
                  "tension",
                  "evidence",
                  "insight",
                  "resolution",
                  "action"
                ]
              },
              "title": {
                "type": "string"
              },
              "claim_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "block_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "annotation_id",
          "text",
          "target_type",
          "target_id"
        ],
        "properties": {
          "annotation_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "text": {
            "type": "string"
          },
          "target_type": {
            "type": "string",
            "enum": [
              "block",
              "metric",
              "claim"
            ]
          },
          "target_id": {
            "type": "string"
          },
          "source_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "annotation_type": {
            "type": "string",
            "enum": [
              "context",
              "methodology",
              "caveat",
              "definition",
              "source-note"
            ]
          }
        }
      }
    }
  }
}
