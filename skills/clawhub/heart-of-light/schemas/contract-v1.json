{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clawhub.ai/orionshaowswmw/heart-of-light/schemas/contract-v1.json",
  "title": "Heart of Light compact response contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "contract_version", "created_at", "status", "decision", "scope", "evidence", "evidence_refs", "uncertainty", "next_action", "human_review_required", "no_claims_beyond_evidence"],
  "properties": {
    "schema": {"const": "heart-of-light.contract.v1"},
    "contract_version": {"const": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["draft", "verified", "needs_review", "blocked", "complete"]},
    "decision": {"type": "string", "minLength": 1},
    "scope": {"type": "string"},
    "evidence": {"type": "array", "maxItems": 20, "items": {"type": "string", "maxLength": 2000}},
    "evidence_refs": {"type": "array", "maxItems": 20, "items": {"type": "string", "maxLength": 300}},
    "uncertainty": {"type": "string"},
    "next_action": {"type": "string"},
    "human_review_required": {"type": "boolean"},
    "no_claims_beyond_evidence": {"const": true}
  }
}
