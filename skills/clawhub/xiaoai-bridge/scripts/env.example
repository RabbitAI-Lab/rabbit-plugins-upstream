# 小米账号 ID：一串纯数字（不是手机号或邮箱）
# 查看位置：小米账号「个人信息」-「小米 ID」
MI_USER_ID=

# 推荐：passToken 登录，比密码稳定，且不会触发安全验证
# 获取教程：https://github.com/idootop/migpt-next/issues/4
MI_PASS_TOKEN=

# 备选：账号密码（可能触发安全验证，仅在无法获取 passToken 时使用）
# MI_PASSWORD=

# 设备名称 / miotDID / MAC 地址任一即可
# 不确定时可设置 DEBUG=true 后运行 test 命令查看设备列表
MI_DEVICE_ID=

# 触发词前缀：只有以此开头的语音消息才会被处理（默认“请”）
# 配置 JEV_API_KEY 后由 Jev 动态判定转发，本前缀仅作为判定信号与降级后备
# 留空会处理所有语音消息，必须同时设置 XIAOAI_ALLOW_UNFILTERED=true
TRIGGER_PREFIX=请

# ================= Jev 智能判定（可选，v1.3.0+） =================
# Jev 判定模型作为热词触发的上位替代：配置后由判定模型逐条决定
# 语音是否转发给 AI（识别小爱原生能力 vs 需要外部 Agent 的任务）；
# 未配置或服务不可用时自动降级回热词触发。
#
# 平台密钥（sk_ 开头，https://tokenrhythm.studio 获取）：
# 注意：启用即表示同意把语音转写文本发送至 Jev 判定服务用于转发决策
JEV_API_KEY=

# 判定挡位：loose（宽松，倾向转发）/ balanced（均衡，默认）/ strict（严格，仅明确要求时转发）
# JEV_LEVEL=balanced

# 自定义转发概率阈值（0-1），覆盖挡位默认值（loose 0.35 / balanced 0.60 / strict 0.80）
# JEV_DECISION_THRESHOLD=

# 判定请求超时（毫秒），范围 1000-30000，默认 8000
# JEV_TIMEOUT_MS=8000

# Jev 服务地址与模型（一般无需修改；地址仅支持 https）
# JEV_BASE_URL=https://tokenrhythm.studio
# JEV_MODEL=NeoHorse-Jev-4B

# 轮询间隔（毫秒），范围 500-60000，默认 1000
POLL_INTERVAL=1000

# 调试模式：会在 stderr 输出更多连接信息；test 模式可打印设备列表
DEBUG=false

# 可选：会话缓存目录。默认使用当前用户的私有状态目录：
#   Windows  %LOCALAPPDATA%\xiaoai-bridge
#   macOS    ~/Library/Application Support/xiaoai-bridge
#   Linux    $XDG_STATE_HOME/xiaoai-bridge 或 ~/.local/state/xiaoai-bridge
# 该目录会写入包含 passToken 的 .mi.json。
# 目录必须属于当前用户、非符号链接、权限可收紧到 0700，否则程序会拒绝启动。
# XIAOAI_STATE_DIR=

# 危险开关：仅当目录权限无法强制（部分文件系统）或 Windows ACL 无法验证时使用。
# 必须设置在进程环境中；写在 .env 里会被忽略。
# 开启后仍会拒绝符号链接、非目录、属主不符、公共目录、硬链接等硬性检查，
# 且 `node scripts/xiaoai-listen.js check` 仍返回退出码 2 并标注“不安全”。
# XIAOAI_ALLOW_INSECURE_STATE_DIR=false

# 注意：.env 不能设置 LOCALAPPDATA / APPDATA / USERPROFILE / HOME / XDG_STATE_HOME /
# ProgramData / PUBLIC / SystemRoot / windir / TEMP / TMP / TMPDIR /
# XIAOAI_ALLOW_INSECURE_STATE_DIR，这些安全敏感变量只接受进程环境。

# 可选：指定 .env 文件路径（默认 scripts/.env 或技能根目录 .env）。
# XIAOAI_ENV_FILE=

# 可选：debug-fetch.js 是否打印语音转写原文（默认 false）。
# PRINT_TRANSCRIPTS=false
