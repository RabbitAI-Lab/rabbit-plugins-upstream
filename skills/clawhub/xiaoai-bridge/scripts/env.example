# 小米账号 ID：一串纯数字（不是手机号或邮箱）
# 查看位置：小米账号「个人信息」-「小米 ID」
MI_USER_ID=

# 推荐：passToken 登录，比密码稳定，且不会触发安全验证
# 获取教程：https://github.com/idootop/migpt-next/issues/4
MI_PASS_TOKEN=

# 备选：账号密码（可能触发安全验证，仅在无法获取 passToken 时使用）
# MI_PASSWORD=

# 设备名称 / miotDID / MAC 地址任一即可
# 不确定时可设置 DEBUG=true 后运行 test 命令查看设备列表
MI_DEVICE_ID=

# 触发词前缀：只有以此开头的语音消息才会被处理（默认“请”）
# 留空会处理所有语音消息，必须同时设置 XIAOAI_ALLOW_UNFILTERED=true
TRIGGER_PREFIX=请

# 轮询间隔（毫秒），范围 500-60000，默认 1000
POLL_INTERVAL=1000

# 调试模式：会在 stderr 输出更多连接信息；test 模式可打印设备列表
DEBUG=false

# 可选：会话缓存目录。默认使用系统临时目录下的 xiaoai-bridge。
# 该目录会写入包含 passToken 的 .mi.json，请确保仅当前用户可读。
# XIAOAI_STATE_DIR=
