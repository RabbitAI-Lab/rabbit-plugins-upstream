```json
{
  "action": "analyze|query|export|monitor",
  "target": "stock_code|token_address|portfolio_id",
  "params": {
    "time_range": "1d|5d|1m|3m|1y|all",
    "indicators": ["ma5", "ma20", "macd", "rsi", "kdj"],
    "output_format": "json|csv|chart|report"
  },
  "options": {
    "realtime": true,
    "include_fundamentals": false,
    "risk_assessment": true
  }
}
```

