{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:experiment-framework:artifact-index:v1",
  "title": "Axiotic experiment artifact index",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "core_sha256",
    "connectivity",
    "nodes"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 3
    },
    "core_sha256": {
      "type": "string"
    },
    "connectivity": {
      "const": "complete-directed-graph"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "uri",
          "sha256",
          "metadata",
          "links"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "uri": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ]
          },
          "metadata": {
            "type": "object"
          },
          "links": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
