# ============================================================
# qdrant-db 配置示例 —— 复制为 .env 后按实际环境填写
#   cp env.example .env && chmod 600 .env
#
# 读取优先级: 真实环境变量 > 本 .env（代码不内置默认值，缺必填项会报错）
# 语法: shell 风格 KEY=VALUE
#   支持 export 前缀、单/双引号、# 注释、空行; 不做变量展开
# ============================================================

# ---------- Qdrant 向量库 ----------
# Qdrant HTTP 服务地址(必填)
QDRANT_URL=http://127.0.0.1:6333

# collection 名称(必填)
QDRANT_COLLECTION=openclaw

# Qdrant 鉴权 key(若服务未开启鉴权可留空)
QDRANT_API_KEY=

# ---------- Embedding 服务 ----------
# OpenAI 兼容的 embeddings 接口地址(必填)
#   例: http://127.0.0.1:8000/v1 或 https://api.openai.com/v1
EMBEDDING_BASE_URL=http://127.0.0.1:8000/v1

# embeddings 接口的 API key(服务无需鉴权可留空)
EMBEDDING_API_KEY=

# 嵌入模型名(必填,需与库内已有向量同模型/同维度)
EMBEDDING_MODEL=Qwen3-Embedding-0.6B

# 向量维度(建议填写,须与模型输出维度一致;缺失时以实际探测维度为准)
EMBEDDING_DIMS=1024

# ---------- 可选: 运行时临时覆盖示例 ----------
# 不修改 .env,在命令前直接指定环境变量即可临时覆盖:
#   QDRANT_URL=http://192.168.1.10:6333 python3 scripts/kb.py search "关键字"
