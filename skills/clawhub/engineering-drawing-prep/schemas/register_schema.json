{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Engineering Drawing Prep Register",
  "type": "object",
  "required": ["register_id", "date", "items"],
  "properties": {
    "register_id": {
      "type": "string",
      "description": "Unique register identifier"
    },
    "date": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of register generation"
    },
    "source_dir": {
      "type": "string",
      "description": "Path to client_given directory"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "category", "description"],
        "properties": {
          "id": { "type": "string" },
          "category": {
            "type": "string",
            "enum": ["room", "equipment", "lighting", "mep", "gap", "rfi"]
          },
          "description": { "type": "string" },
          "source_file": { "type": "string" },
          "source_sheet": { "type": "string" },
          "quantity": { "type": "number" },
          "unit": { "type": "string" },
          "remarks": { "type": "string" }
        }
      }
    }
  }
}
