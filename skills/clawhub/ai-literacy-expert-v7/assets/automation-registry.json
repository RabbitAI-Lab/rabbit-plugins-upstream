  "lifecycle": {
    "register": "按 assets/self-contained-prompt-template.md 生成 prompt → 向用户展示创建预览 → 用户确认后执行 scheduler-api.sh create → 回填本文件 id/status/enabled",
    "pause": "scheduler-api.sh update --id <id> --status 0（须先 get + 预览 + 确认）",
    "resume": "scheduler-api.sh update --id <id> --status 1（须先 get + 预览 + 确认）",
    "delete": "scheduler-api.sh delete --id <id>（须先 get + 预览 + 确认『确认删除』）→ 本文件 status 置 deleted",
    "constraint": "写操作必须先预览、经用户确认后再执行；automation 会话内严禁调用 automation-task-manager"
  },
