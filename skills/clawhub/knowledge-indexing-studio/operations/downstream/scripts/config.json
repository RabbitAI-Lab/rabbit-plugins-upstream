{
  "variant_id": "cap_02_file_to_log",
  "role": "downstream",
  "version": "1.1.0",
  "input_name": "segmented_note",
  "output_name": "index_update",
  "input_schema": {
    "type": "object",
    "required": [
      "reference",
      "heading",
      "tags",
      "links",
      "content_digest",
      "sections"
    ],
    "properties": {
      "reference": {
        "type": "string",
        "pattern": "^KB-[A-Z0-9-]+$"
      },
      "heading": {
        "type": "string",
        "minLength": 1
      },
      "tags": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true
      },
      "links": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "content_digest": {
        "type": "string",
        "pattern": "^[a-f0-9]{16}$"
      },
      "sections": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [
            "ordinal",
            "heading",
            "content",
            "content_digest"
          ],
          "properties": {
            "ordinal": {
              "type": "integer",
              "minimum": 1
            },
            "heading": {
              "type": "string",
              "minLength": 1
            },
            "content": {
              "type": "string",
              "minLength": 1
            },
            "content_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{16}$"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "required": [
      "index_id",
      "reference",
      "heading",
      "content_digest",
      "indexed_sections",
      "backlinks",
      "dedup_status",
      "duplicates_removed"
    ],
    "properties": {
      "index_id": {
        "type": "string",
        "minLength": 1
      },
      "reference": {
        "type": "string",
        "pattern": "^KB-[A-Z0-9-]+$"
      },
      "heading": {
        "type": "string",
        "minLength": 1
      },
      "content_digest": {
        "type": "string",
        "pattern": "^[a-f0-9]{16}$"
      },
      "indexed_sections": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [
            "section_id",
            "ordinal",
            "heading",
            "content",
            "content_digest"
          ],
          "properties": {
            "section_id": {
              "type": "string",
              "minLength": 1
            },
            "ordinal": {
              "type": "integer",
              "minimum": 1
            },
            "heading": {
              "type": "string",
              "minLength": 1
            },
            "content": {
              "type": "string",
              "minLength": 1
            },
            "content_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{16}$"
            }
          },
          "additionalProperties": false
        }
      },
      "backlinks": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "source_reference",
            "target_reference"
          ],
          "properties": {
            "source_reference": {
              "type": "string",
              "pattern": "^KB-[A-Z0-9-]+$"
            },
            "target_reference": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "dedup_status": {
        "type": "string",
        "enum": [
          "unique",
          "duplicates_removed"
        ]
      },
      "duplicates_removed": {
        "type": "integer",
        "minimum": 0
      }
    },
    "additionalProperties": false
  },
  "effect": "local_knowledge_index_update"
}
