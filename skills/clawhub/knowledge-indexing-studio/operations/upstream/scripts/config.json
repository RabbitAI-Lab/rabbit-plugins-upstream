{
  "variant_id": "cap_02_file_to_log",
  "role": "upstream",
  "version": "1.1.0",
  "input_name": "knowledge_note",
  "output_name": "segmented_note",
  "input_schema": {
    "type": "string",
    "format": "knowledge-note",
    "minLength": 1
  },
  "output_schema": {
    "type": "object",
    "required": [
      "reference",
      "heading",
      "tags",
      "links",
      "content_digest",
      "sections"
    ],
    "properties": {
      "reference": {
        "type": "string",
        "pattern": "^KB-[A-Z0-9-]+$"
      },
      "heading": {
        "type": "string",
        "minLength": 1
      },
      "tags": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true
      },
      "links": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "content_digest": {
        "type": "string",
        "pattern": "^[a-f0-9]{16}$"
      },
      "sections": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [
            "ordinal",
            "heading",
            "content",
            "content_digest"
          ],
          "properties": {
            "ordinal": {
              "type": "integer",
              "minimum": 1
            },
            "heading": {
              "type": "string",
              "minLength": 1
            },
            "content": {
              "type": "string",
              "minLength": 1
            },
            "content_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{16}$"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "additionalProperties": false
  },
  "effect": null
}
