{
  "pipeline_type": "PL-DRAMA",
  "version": "1.2.0",
  "description": "短剧剧本+视频生成管道 - AI生成短剧剧本并自动转化为视频",
  "steps": [
    {
      "name": "剧本大纲生成",
      "tool": "narrato-mcp",
      "action": "director_plan",
      "params": {
        "content_type": "drama",
        "episode_count": 1
      }
    },
    {
      "name": "角色设定",
      "tool": "character-consistency-mcp",
      "action": "generate_consistent_characters",
      "params": {}
    },
    {
      "name": "分集剧本生成",
      "tool": "content-template",
      "action": "generate",
      "params": {
        "template_type": "drama_script",
        "duration": "3min"
      }
    },
    {
      "name": "品牌特质注入",
      "tool": "agency-portal-mcp",
      "action": "portal_get_tenant_brand_profile",
      "params": {}
    },
    {
      "name": "人设特质注入",
      "tool": "pps-mcp",
      "action": "get_persona_profile",
      "params": {}
    },
    {
      "name": "写作风格应用",
      "tool": "agency-portal-mcp",
      "action": "portal_get_tenant_style",
      "params": {}
    },
    {
      "name": "营销注入",
      "tool": "market-copywriter",
      "action": "adapt_platform",
      "params": {
        "platform": "${platform}"
      }
    },
    {
      "name": "SEO优化",
      "tool": "seo-optimizer",
      "action": "optimize",
      "params": {
        "content": "${prev_output.content}"
      }
    },
    {
      "name": "GEO优化",
      "tool": "geo-content-optimizer",
      "action": "optimize",
      "params": {
        "content": "${prev_output.content}"
      }
    },
    {
      "name": "防查重检测",
      "tool": "content-rewriter",
      "action": "detect",
      "params": {
        "content": "${prev_output.content}",
        "platform": "${platform}"
      }
    },
    {
      "name": "内容质量评分",
      "tool": "content-calibrator",
      "action": "score",
      "params": {
        "content": "${prev_output.content}",
        "platform": "${platform}"
      }
    },
    {
      "name": "内容审核",
      "tool": "sensitive-word-mcp",
      "action": "check_sensitive_words",
      "params": {
        "text": "${prev_output.content}"
      }
    },
    {
      "name": "AI声明注入",
      "tool": "inline",
      "action": "inject_ai_declaration",
      "params": {}
    },
    {
      "name": "分镜脚本生成",
      "tool": "narrato-mcp",
      "action": "generate_narration_script",
      "params": {}
    },
    {
      "name": "角色画面生成",
      "tool": "character-consistency-mcp",
      "action": "generate_comic_panel",
      "params": {}
    },
    {
      "name": "分镜转视频",
      "tool": "${engine.image_video}",
      "action": "kling_image_to_video",
      "params": {}
    },
    {
      "name": "配音生成",
      "tool": "${engine.tts}",
      "action": "synthesize",
      "params": {}
    },
    {
      "name": "口型同步",
      "tool": "${engine.lipsync}",
      "action": "generate_lip_sync",
      "params": {}
    },
    {
      "name": "字幕生成",
      "tool": "video-generator",
      "action": "generate_subtitle",
      "params": {
        "subtitle_style": "default",
        "font_size": 24
      }
    },
    {
      "name": "视频合成",
      "tool": "video-generator",
      "action": "compose_video",
      "params": {}
    },
    {
      "name": "合规风控(U19)",
      "tool": "content-qa-guard",
      "action": "check",
      "params": {}
    },
    {
      "name": "平台排版适配",
      "tool": "content-formatter",
      "action": "format",
      "params": {
        "content": "${prev_output.content}",
        "platform": "${platform}",
        "format_level": "auto"
      }
    },
    {
      "name": "保存草稿",
      "tool": "agency-portal-mcp",
      "action": "portal_publish_content",
      "params": {
        "status": "draft"
      }
    },
    {
      "name": "多平台发布",
      "tool": "content-publisher",
      "action": "publish_content",
      "params": {}
    },
    {
      "name": "发布反馈(U13)",
      "tool": "self-growth",
      "action": "learn",
      "params": {
        "category": "publish_feedback",
        "importance": 5
      }
    }
  ]
}
