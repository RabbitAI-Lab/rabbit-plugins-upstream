{
  "pipeline_type": "PL-NEWPROD",
  "version": "1.0.0",
  "description": "新商品内容生成管道",
  "steps": [
    {
      "name": "商品信息拉取",
      "tool": "fishclaw-mcp",
      "action": "get_item_stats",
      "params": {
        "product_id": "all"
      }
    },
    {
      "name": "热点监控",
      "tool": "dailyhot-mcp",
      "action": "get_hot_list",
      "params": {
        "category": "AI服务"
      }
    },
    {
      "name": "选题决策",
      "tool": "content-research-mcp",
      "action": "generate_topic_suggestions",
      "params": {
        "focus": "new_product_promotion"
      }
    },
    {
      "name": "竞品数据采集",
      "tool": "media-crawler-mcp",
      "action": "search_posts",
      "params": {
        "platform": "xiaohongshu",
        "keyword": "${prev_output.topic}",
        "limit": 5
      }
    },
    {
      "name": "文案生成(商品介绍)",
      "tool": "content-template",
      "action": "generate",
      "params": {
        "template_type": "product_intro"
      }
    },
    {
      "name": "品牌特质注入",
      "tool": "agency-portal-mcp",
      "action": "portal_get_tenant_brand_profile",
      "params": {}
    },
    {
      "name": "人设特质注入",
      "tool": "pps-mcp",
      "action": "get_persona_profile",
      "params": {}
    },
    {
      "name": "写作风格应用",
      "tool": "agency-portal-mcp",
      "action": "portal_get_tenant_style",
      "params": {}
    },
    {
      "name": "营销注入",
      "tool": "market-copywriter",
      "action": "adapt_platform",
      "params": {
        "platform": "${platform}"
      }
    },
    {
      "name": "SEO优化",
      "tool": "seo-optimizer",
      "action": "optimize",
      "params": {
        "content": "${prev_output.content}"
      }
    },
    {
      "name": "GEO优化",
      "tool": "geo-content-optimizer",
      "action": "optimize",
      "params": {
        "content": "${prev_output.content}"
      }
    },
    {
      "name": "防查重检测",
      "tool": "content-rewriter",
      "action": "detect",
      "params": {
        "content": "${prev_output.content}",
        "platform": "${platform}"
      }
    },
    {
      "name": "内容质量评分",
      "tool": "content-calibrator",
      "action": "score",
      "params": {
        "content": "${prev_output.content}",
        "platform": "${platform}"
      }
    },
    {
      "name": "内容审核",
      "tool": "sensitive-word-mcp",
      "action": "check_sensitive_words",
      "params": {
        "text": "${prev_output.content}"
      }
    },
    {
      "name": "AI声明注入",
      "tool": "inline",
      "action": "inject_ai_declaration",
      "params": {}
    },
    {
      "name": "配图生成",
      "tool": "flux-mcp",
      "action": "generate_image",
      "params": {
        "prompt": "${prev_output.title}"
      }
    },
    {
      "name": "合规风控(U19)",
      "tool": "content-qa-guard",
      "action": "check",
      "params": {}
    },
    {
      "name": "平台排版适配",
      "tool": "content-formatter",
      "action": "format",
      "params": {
        "content": "${prev_output.content}",
        "platform": "${platform}",
        "format_level": "auto"
      }
    },
    {
      "name": "闲鱼商品发布",
      "tool": "fishclaw-mcp",
      "action": "publish_item",
      "params": {
        "title": "${prev_output.title}",
        "account_id": "default"
      }
    },
    {
      "name": "多平台发布(抖音+小红书+视频号)",
      "tool": "content-publisher",
      "action": "publish_content",
      "params": {
        "platforms": [
          "douyin",
          "xiaohongshu",
          "shipinhao"
        ]
      }
    },
    {
      "name": "排期调度",
      "tool": "content-publisher",
      "action": "schedule_smart",
      "params": {
        "preferred_time": "auto"
      }
    },
    {
      "name": "效果分析(72h后)",
      "tool": "content-analytics",
      "action": "batch",
      "params": {
        "track_window_hours": 72
      }
    },
    {
      "name": "发布反馈(U13)",
      "tool": "self-growth",
      "action": "learn",
      "params": {
        "category": "publish_feedback",
        "importance": 5
      }
    }
  ]
}