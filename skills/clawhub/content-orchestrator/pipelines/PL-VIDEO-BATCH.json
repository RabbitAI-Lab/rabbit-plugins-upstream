{
  "pipeline_type": "PL-VIDEO-BATCH",
  "version": "1.0.0",
  "description": "视频批量生成与发布管道(v3.0 P0-09新增) - 生成视频→批量发布到多平台",
  "source": "docs/wiki/功能映射与清理计划_v3.0.md §15.1 P0-09",
  "user_intent": "生成视频→批量发布",
  "steps": [
    {
      "name": "热点监控",
      "tool": "dailyhot-mcp",
      "action": "get_hot_list",
      "params": {
        "count": 5
      }
    },
    {
      "name": "选题策划",
      "tool": "content-research-mcp",
      "action": "generate_topic_suggestions",
      "params": {
        "content_type": "video",
        "count": 3
      }
    },
    {
      "name": "脚本批量生成",
      "tool": "narrato-mcp",
      "action": "generate_narration_script",
      "params": {
        "batch_size": 3
      }
    },
    {
      "name": "品牌特质注入",
      "tool": "agency-portal-mcp",
      "action": "portal_get_tenant_brand_profile",
      "params": {}
    },
    {
      "name": "人设特质注入",
      "tool": "pps-mcp",
      "action": "get_persona_profile",
      "params": {}
    },
    {
      "name": "写作风格应用",
      "tool": "agency-portal-mcp",
      "action": "portal_get_tenant_style",
      "params": {}
    },
    {
      "name": "营销注入",
      "tool": "market-copywriter",
      "action": "adapt_platform",
      "params": {
        "platform": "${platform}"
      }
    },
    {
      "name": "SEO优化",
      "tool": "seo-optimizer",
      "action": "optimize",
      "params": {
        "content": "${prev_output.content}"
      }
    },
    {
      "name": "GEO优化",
      "tool": "geo-content-optimizer",
      "action": "optimize",
      "params": {
        "content": "${prev_output.content}"
      }
    },
    {
      "name": "防查重检测",
      "tool": "content-rewriter",
      "action": "detect",
      "params": {
        "content": "${prev_output.content}",
        "platform": "${platform}"
      }
    },
    {
      "name": "内容质量评分",
      "tool": "content-calibrator",
      "action": "score",
      "params": {
        "content": "${prev_output.content}",
        "platform": "${platform}"
      }
    },
    {
      "name": "内容审核",
      "tool": "sensitive-word-mcp",
      "action": "check_sensitive_words",
      "params": {
        "text": "${prev_output.content}"
      }
    },
    {
      "name": "AI声明注入",
      "tool": "inline",
      "action": "inject_ai_declaration",
      "params": {}
    },
    {
      "name": "配音生成",
      "tool": "${engine.tts}",
      "action": "synthesize",
      "params": {}
    },
    {
      "name": "画面生成(MPT真实素材)",
      "tool": "moneyprinterturbo-mcp",
      "action": "mpt_generate_video",
      "params": {
        "video_subject": "${prev_output.content}",
        "video_count": 3,
        "video_source": "pexels"
      }
    },
    {
      "name": "视频任务状态轮询",
      "tool": "moneyprinterturbo-mcp",
      "action": "mpt_task_status",
      "params": {
        "task_id": "${prev_output.task_id}"
      }
    },
    {
      "name": "AI风格化视频(Pixelle)",
      "tool": "pixelle-video-mcp",
      "action": "pixelle_generate_video",
      "params": {}
    },
    {
      "name": "字幕生成",
      "tool": "video-generator",
      "action": "generate_subtitle",
      "params": {
        "subtitle_style": "default",
        "font_size": 24
      }
    },
    {
      "name": "AI配图",
      "tool": "flux-mcp",
      "action": "generate_image",
      "params": {
        "prompt": "${prev_output.title}"
      }
    },
    {
      "name": "口型同步",
      "tool": "${engine.lipsync}",
      "action": "generate_lip_sync",
      "params": {}
    },
    {
      "name": "合规风控(U19)",
      "tool": "content-qa-guard",
      "action": "check",
      "params": {}
    },
    {
      "name": "平台排版适配",
      "tool": "content-formatter",
      "action": "format",
      "params": {
        "content": "${prev_output.content}",
        "platform": "${platform}",
        "format_level": "auto"
      }
    },
    {
      "name": "批量多平台发布",
      "tool": "content-publisher",
      "action": "publish_batch",
      "params": {
        "platforms": [
          "douyin",
          "kuaishou",
          "bilibili",
          "shipinhao",
          "xiaohongshu"
        ]
      }
    },
    {
      "name": "发布反馈(U13)",
      "tool": "self-growth",
      "action": "learn",
      "params": {
        "category": "publish_feedback",
        "importance": 5
      }
    }
  ]
}