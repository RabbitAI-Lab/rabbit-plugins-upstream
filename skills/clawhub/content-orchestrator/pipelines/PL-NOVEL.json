{
  "pipeline_type": "PL-NOVEL",
  "version": "1.0.0",
  "description": "小说章节生成管道 - AI辅助生成小说章节内容",
  "steps": [
    {
      "name": "小说初始化",
      "tool": "novel-bridge",
      "action": "init_novel",
      "params": {}
    },
    {
      "name": "大纲生成",
      "tool": "narrato-mcp",
      "action": "director_plan",
      "params": {
        "genre": "${params.genre}",
        "chapter_count": 1
      }
    },
    {
      "name": "角色设定",
      "tool": "character-consistency-mcp",
      "action": "generate_consistent_characters",
      "params": {}
    },
    {
      "name": "章节内容生成",
      "tool": "novel-bridge",
      "action": "generate_chapters",
      "params": {
        "template_type": "novel_chapter",
        "word_count": 3000
      }
    },
    {
      "name": "Truth Files同步",
      "tool": "novel-bridge",
      "action": "sync_truth_files",
      "params": {}
    },
    {
      "name": "标题生成",
      "tool": "title-generator",
      "action": "generate",
      "params": {}
    },
    {
      "name": "品牌特质注入",
      "tool": "agency-portal-mcp",
      "action": "portal_get_tenant_brand_profile",
      "params": {}
    },
    {
      "name": "人设特质注入",
      "tool": "pps-mcp",
      "action": "get_persona_profile",
      "params": {}
    },
    {
      "name": "写作风格应用",
      "tool": "agency-portal-mcp",
      "action": "portal_get_tenant_style",
      "params": {}
    },
    {
      "name": "营销注入",
      "tool": "market-copywriter",
      "action": "adapt_platform",
      "params": {
        "platform": "${platform}"
      }
    },
    {
      "name": "SEO优化",
      "tool": "seo-optimizer",
      "action": "optimize",
      "params": {
        "content": "${prev_output.content}"
      }
    },
    {
      "name": "GEO优化",
      "tool": "geo-content-optimizer",
      "action": "optimize",
      "params": {
        "content": "${prev_output.content}"
      }
    },
    {
      "name": "防查重检测",
      "tool": "content-rewriter",
      "action": "detect",
      "params": {
        "content": "${prev_output.content}",
        "platform": "${platform}"
      }
    },
    {
      "name": "内容质量评分",
      "tool": "content-calibrator",
      "action": "score",
      "params": {
        "content": "${prev_output.content}",
        "platform": "${platform}"
      }
    },
    {
      "name": "内容审核",
      "tool": "sensitive-word-mcp",
      "action": "check_sensitive_words",
      "params": {
        "text": "${prev_output.content}"
      }
    },
    {
      "name": "AI声明注入",
      "tool": "inline",
      "action": "inject_ai_declaration",
      "params": {}
    },
    {
      "name": "合规风控(U19)",
      "tool": "content-qa-guard",
      "action": "check",
      "params": {}
    },
    {
      "name": "平台排版适配",
      "tool": "content-formatter",
      "action": "format",
      "params": {
        "content": "${prev_output.content}",
        "platform": "${platform}",
        "format_level": "auto"
      }
    },
    {
      "name": "保存草稿",
      "tool": "agency-portal-mcp",
      "action": "portal_publish_content",
      "params": {
        "status": "draft"
      }
    },
    {
      "name": "多平台发布",
      "tool": "content-publisher",
      "action": "publish_content",
      "params": {}
    },
    {
      "name": "发布状态回写",
      "tool": "novel-bridge",
      "action": "publish_chapter",
      "params": {}
    },
    {
      "name": "发布反馈(U13)",
      "tool": "self-growth",
      "action": "learn",
      "params": {
        "category": "publish_feedback",
        "importance": 5
      }
    }
  ]
}