{
  "pipeline_type": "PL-DIGITAL-HUMAN",
  "version": "1.0.0",
  "description": "C9流程: 素材采集→人格蒸馏→数字人创建→配音→口型同步→发布",
  "source": "docs/wiki/功能映射与清理计划_v3.0.md §C9 数字人口播",
  "user_intent": "生成数字人口播短视频→发布",
  "steps": [
    {
      "name": "素材采集",
      "tool": "pps-mcp",
      "action": "get_persona_profile",
      "params": {
        "agent_id": "${params.tenant_id}"
      }
    },
    {
      "name": "人格蒸馏",
      "tool": "pps-mcp",
      "action": "get_distill_fingerprint",
      "params": {
        "tenant_slug": "${params.tenant_id}"
      }
    },
    {
      "name": "数字人创建",
      "tool": "character-workshop-mcp",
      "action": "create_manual_character",
      "params": {}
    },
    {
      "name": "文案生成",
      "tool": "content-template",
      "action": "generate",
      "params": {}
    },
    {
      "name": "品牌特质注入",
      "tool": "agency-portal-mcp",
      "action": "portal_get_tenant_brand_profile",
      "params": {}
    },
    {
      "name": "人设特质注入",
      "tool": "pps-mcp",
      "action": "get_persona_profile",
      "params": {}
    },
    {
      "name": "写作风格应用",
      "tool": "agency-portal-mcp",
      "action": "portal_get_tenant_style",
      "params": {}
    },
    {
      "name": "营销注入",
      "tool": "market-copywriter",
      "action": "adapt_platform",
      "params": {
        "platform": "${platform}"
      }
    },
    {
      "name": "SEO优化",
      "tool": "seo-optimizer",
      "action": "optimize",
      "params": {
        "content": "${prev_output.content}"
      }
    },
    {
      "name": "GEO优化",
      "tool": "geo-content-optimizer",
      "action": "optimize",
      "params": {
        "content": "${prev_output.content}"
      }
    },
    {
      "name": "防查重检测",
      "tool": "content-rewriter",
      "action": "detect",
      "params": {
        "content": "${prev_output.content}",
        "platform": "${platform}"
      }
    },
    {
      "name": "内容质量评分",
      "tool": "content-calibrator",
      "action": "score",
      "params": {
        "content": "${prev_output.content}",
        "platform": "${platform}"
      }
    },
    {
      "name": "内容审核",
      "tool": "sensitive-word-mcp",
      "action": "check_sensitive_words",
      "params": {
        "text": "${prev_output.content}"
      }
    },
    {
      "name": "AI声明注入",
      "tool": "inline",
      "action": "inject_ai_declaration",
      "params": {}
    },
    {
      "name": "人设图片生成",
      "tool": "flux-mcp",
      "action": "generate_image",
      "params": {
        "prompt": "${prev_output.title}"
      }
    },
    {
      "name": "配音生成",
      "tool": "${engine.tts}",
      "action": "synthesize",
      "params": {}
    },
    {
      "name": "口型同步",
      "tool": "${engine.lipsync}",
      "action": "generate_lip_sync",
      "params": {}
    },
    {
      "name": "合规风控(U19)",
      "tool": "content-qa-guard",
      "action": "check",
      "params": {}
    },
    {
      "name": "平台排版适配",
      "tool": "content-formatter",
      "action": "format",
      "params": {
        "content": "${prev_output.content}",
        "platform": "${platform}",
        "format_level": "auto"
      }
    },
    {
      "name": "多平台发布",
      "tool": "content-publisher",
      "action": "publish_content",
      "params": {}
    },
    {
      "name": "发布反馈(U13)",
      "tool": "self-growth",
      "action": "learn",
      "params": {
        "category": "publish_feedback",
        "importance": 5
      }
    }
  ]
}