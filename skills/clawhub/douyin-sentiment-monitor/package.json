{
  "name": "douyin-sentiment-monitor",
  "version": "1.3.0",
  "description": "抖音舆情监测助手。针对任意关键词获取抖音作品数据、详情、互动数据、评论数据，基于抖音实时数据，综合分析舆情健康、情感占比、负面信息、事件时间、热度排行、竞品口碑对比与风险建议等，进行分析并输出舆情报告。",
  "keywords": [
    "douyin",
    "search",
    "hot",
    "keyword",
    "content-analysis",
    "competitor-analysis"
  ],
  "author": "um-why",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=16.14.0"
  },
  "scripts": {
    "search": "node src/douyin/search-cli.js",
    "post": "node src/douyin/post-cli.js",
    "comment": "node src/douyin/comment-cli.js",
    "hot": "node src/douyin/hot-cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/um-why/douyin-search-openclaw.git"
  }
}