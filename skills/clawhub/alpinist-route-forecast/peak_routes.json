            "elite": 30,
            "moderate": 60,
            "amateur": 120
          },
          "queue_risk_min": 30,
          "bail_rate": 0.25,
          "notes": "Most parties bail here. Look for 3-piton anchor after first steep pitch. Rightmost gully, NOT the deep couloir on the left."
        }
      },
      {
        "name": "West Ridge Scramble",
        "miles": 0.7,
        "terrain": "technical",
        "ele_ft": [
          8000,
          8600
        ],
