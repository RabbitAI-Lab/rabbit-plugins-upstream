# Git attributes for k12-teacher
# Purpose: Normalize line endings, mark binary assets, and guide GitHub linguist.
# Reference: https://git-scm.com/docs/gitattributes

# Auto-detect text files and normalize to LF inside the repository
* text=auto eol=lf

# Shell scripts must keep LF line endings even on Windows checkouts
*.sh text eol=lf

# Legal documents: keep verbatim, no line-ending conversion
LICENSE text eol=lf
COPYING text eol=lf

# Explicitly mark binary assets (never diff, merge, or convert as text)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.bmp binary
*.ico binary
*.svg binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary

# Downloaded external syllabus documents are opaque blobs
downloads/** -diff

# Linguist overrides: documentation-first repository
*.md linguist-documentation
