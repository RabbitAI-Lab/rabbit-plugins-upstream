# ============================================================
# ai-video-auto-generator — API Key 配置文件
# 复制此文件为 keys.env 并填入你的 Key
# ============================================================
# 从 https://platform.agnes-ai.com 注册获取（免费无限）
AGNES_API_KEY=your_agnes_api_key_here

# 从 https://freesound.org/apiv2/apply/ 注册获取（免费）
FREESOUND_API_KEY=your_freesound_api_key_here

# 从 GitHub Settings → Developer settings → Personal access tokens 创建（需 contents:write 权限）
# 用于图床：上传图片到存储库，返回 raw 公网直链
GITHUB_PAT=your_github_personal_access_token_here

# 火山引擎（小云雀 Seedance 2.0）AK/SK
# 从 https://console.volcengine.com/ 创建 AccessKey（需开通即梦AI/小云雀服务）
# 写入 ~/.xyq-access-key 和 ~/.xyq-secret-key，或设置环境变量 VOLCENGINE_ACCESS_KEY / VOLCENGINE_SECRET_KEY
XYQ_ACCESS_KEY=your_volcengine_access_key_here
XYQ_SECRET_KEY=your_volcengine_secret_key_here
