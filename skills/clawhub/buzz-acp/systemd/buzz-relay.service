[Unit]
Description=Buzz Relay Server
Documentation=https://github.com/block/buzz
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=marvin
WorkingDirectory=/home/marvin/.openclaw/workspace/repos/buzz
EnvironmentFile=/home/marvin/.openclaw/workspace/repos/buzz/.env
ExecStart=/home/marvin/.local/bin/buzz-relay
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=buzz-relay

# Hardening — the relay writes a git pack cache to its working directory
# and may need Docker socket access for media storage. ReadWritePaths
# grants write access to only those paths under ProtectSystem=strict.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=/home/marvin/.openclaw/workspace/repos/buzz

# Give the relay time to connect to Postgres/Redis/MinIO on startup
ExecStartPre=/bin/sleep 3

[Install]
WantedBy=multi-user.target
