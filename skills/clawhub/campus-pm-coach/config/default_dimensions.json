{
  "version": "2.0",
  "scene": "校招/实习 · 互联网产品经理面试",
  "note": "本配置来自《校招产品经理能力评价体系》评分标准，权重合计 100",
  "dimensions": [
    {
      "id": "experience_match",
      "name": "过往经验匹配度",
      "weight": 20,
      "standard": "候选人简历实习经历的工作方向与 JD 的相关性判断（电商、游戏、金融等大方向）；实习经历的实际性工作判断（完整调研→落地PRD→评审→复盘闭环）；候选人当前专业是否为计算机相关。",
      "rules": [
        {
          "type": "industry_match",
          "label": "实习/项目行业方向匹配",
          "weight": 1.5,
          "industries": ["电商", "游戏", "金融", "社交", "内容", "工具", "教育", "医疗", "汽车", "零售", "物流", "出海", "本地生活", "短视频", "直播", "SaaS", "AI", "人工智能", "云计算", "安全"]
        },
        {
          "type": "substance_work",
          "label": "实际性工作闭环（调研→PRD→评审→复盘）",
          "weight": 1.5,
          "flow_keywords": {
            "调研": ["用户调研", "用户访谈", "问卷", "竞品分析", "调研"],
            "产出PRD": ["PRD", "需求文档", "原型", "需求分析", "方案设计"],
            "评审": ["评审", "需求评审", "评审会", "过会"],
            "落地": ["上线", "落地", "发布", "灰度", "推动研发"],
            "复盘": ["复盘", "总结", "沉淀", "报告", "方法论"]
          },
          "required_stages": 3
        },
        {
          "type": "major_relevance",
          "label": "专业是否计算机相关",
          "weight": 1.0,
          "related": ["计算机", "软件", "信息", "电子", "通信", "自动化", "人工智能", "数据", "网络", "数学", "统计", "智能", "数字媒体技术", "信息安全"]
        }
      ]
    },
    {
      "id": "logic_ability",
      "name": "逻辑能力",
      "weight": 30,
      "standard": "简历描述项目是否包含关键点：背景（为什么做）、产出（具体产出物是什么）、价值衡量（怎么衡量产出的价值）、北极星指标（衡量价值的北极星指标）；简历能否看到项目的核心价值与长期目标（roadmap）。",
      "rules": [
        {
          "type": "logic_elements",
          "label": "项目逻辑四要素（背景/产出/价值衡量/北极星指标）",
          "weight": 2.0,
          "elements": {
            "背景（为什么做）": ["背景", "初衷", "痛点", "原因", "为什么", "现状", "问题", "机会", "目标用户"],
            "产出（具体产出物）": ["PRD", "需求文档", "原型", "方案", "上线", "功能", "模块", "产品", "交付", "发布", "落地"],
            "价值衡量（怎么衡量价值）": ["衡量", "指标", "提升", "增长", "降低", "提升率", "效果", "转化率", "留存", "DAU", "GMV", "时长", "活跃", "完成率"],
            "北极星指标（核心衡量）": ["北极星", "北极星指标", "核心指标", "关键指标", "最重要的指标", "第一关键指标", "唯一指标"]
          },
          "min_elements": 3
        },
        {
          "type": "roadmap_presence",
          "label": "核心价值与长期目标（roadmap）",
          "weight": 1.0,
          "keywords": ["roadmap", "路线图", "长期目标", "规划", "阶段", "迭代计划", "版本规划", "愿景", "里程碑", "下一步", "后续计划", "演进", "roadmap（", "Roadmap"]
        }
      ]
    },
    {
      "id": "expression_ability",
      "name": "表达能力",
      "weight": 20,
      "standard": "简历描述是否重复和累赘（无冗余表达）；跨境类行业英语是否可作为工作语言。",
      "rules": [
        {
          "type": "redundancy_check",
          "label": "重复/累赘表达检测",
          "weight": 1.5,
          "padding_words": ["相关", "进行", "能够", "以及", "等等", "较为", "比较", "非常", "大概", "基本上", "差不多", "各种", "之类的", "反正", "其实", "尽量"],
          "max_repeats": 6,
          "min_length": 120
        },
        {
          "type": "english_ability",
          "label": "英语工作语言能力（跨境行业）",
          "weight": 1.0,
          "certs": ["CET-4", "CET-6", "四级", "六级", "雅思", "IELTS", "托福", "TOEFL", "英语", "English", "英文", "专四", "专八", "TEM", "GRE", "GMAT"],
          "cross_border_hint": ["跨境", "出海", "海外", "国际", "英语", "英文", "English", "global"]
        }
      ]
    },
    {
      "id": "ai_exploration",
      "name": "AI 探索能力",
      "weight": 15,
      "standard": "是否通过 AI 落地过一些产品、输出过一些产出，最终实现提效（AI 工具/大模型/AIGC 实际应用）。",
      "rules": [
        {
          "type": "ai_exploration",
          "label": "AI 落地产品与提效证据",
          "weight": 1.0,
          "ai_keywords": ["AI", "人工智能", "大模型", "LLM", "AIGC", "GPT", "ChatGPT", "文心一言", "通义", "豆包", "Kimi", "Midjourney", "Stable Diffusion", "智能体", "Agent", "prompt", "提示词", "RAG", "机器学习", "深度学习", "算法", "自动化", "Copilot", "智能"],
          "output_keywords": ["落地", "上线", "产出", "搭建", "开发", "集成", "接入", "应用", "部署", "交付", "提效", "效率提升", "节省", "降本", "加速", "自动化流程", "辅助", "工作流", "流程"]
        }
      ]
    },
    {
      "id": "pm_quality",
      "name": "产品经理个人素养",
      "weight": 15,
      "standard": "责任心：简历项目是否体现软性素养、不半途而废；创造力：探索新鲜事物并持续进行；逻辑严谨：表达清晰不拖沓、定量与定性结果导向、有规划性思维；热爱：持续体验相关行业产品并有成绩体现。",
      "rules": [
        {
          "type": "soft_quality",
          "label": "软性素养四要素（责任心/创造力/逻辑严谨/热爱）",
          "weight": 1.0,
          "traits": {
            "责任心": ["负责", "全程", "独立", "坚持", "闭环", "完成", "交付", "不半途而废", "跟进到底", "兜底"],
            "创造力": ["创新", "从0到1", "探索", "尝试", "首创", "新玩法", "突破", "差异化", "灵感", "脑暴"],
            "逻辑严谨": ["梳理", "框架", "体系", "结构化", "优先级", "排期", "拆解", "方法论", "流程", "规划", "严谨"],
            "热爱": ["热爱", "兴趣", "长期使用", "深度体验", "忠实用户", "社区活跃", "自驱", "持续关注", "测评", "分享"]
          },
          "min_traits": 3
        }
      ]
    }
  ]
}
