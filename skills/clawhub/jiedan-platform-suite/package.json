{
  "name": "@rascalagnt001/jiedan-platform-suite",
  "version": "1.0.0",
  "description": "7 大第三方出票平台接单 Skill 汇总入口 —— 安装单平台包按需接入。",
  "type": "module",
  "files": [
    "index.mjs",
    "SKILL.md",
    "README.md",
    "openclaw.plugin.json",
    "cinema-agent/**",
    "jiedan-suite.json"
  ],
  "openclaw": {
    "kind": "skill",
    "skill": "SKILL.md",
    "extensions": [
      "./index.mjs"
    ],
    "runtimeTargets": [
      "openclaw",
      "cinema-agent"
    ],
    "compat": {
      "pluginApi": ">=2026.4.5"
    },
    "build": {
      "openclawVersion": "2026.4.5"
    }
  }
}
