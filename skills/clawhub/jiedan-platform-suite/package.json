{
  "name": "@rascalagnt001/jiedan-platform-suite",
  "version": "1.2.7",
  "description": "9 大第三方出票平台接单 Skill 汇总入口 —— openclaw skills install jiedan-platform-suite 一键接入，或按需安装单平台包。",
  "type": "module",
  "files": [
    "index.mjs",
    "SKILL.md",
    "README.md",
    "openclaw.plugin.json",
    "cinema-agent/**",
    "jiedan-suite.json"
  ],
  "openclaw": {
    "kind": "skill",
    "skill": "SKILL.md",
    "extensions": [
      "./index.mjs"
    ],
    "runtimeTargets": [
      "openclaw",
      "cinema-agent"
    ],
    "compat": {
      "pluginApi": ">=2026.4.5"
    },
    "build": {
      "openclawVersion": "2026.4.5"
    }
  }
}
