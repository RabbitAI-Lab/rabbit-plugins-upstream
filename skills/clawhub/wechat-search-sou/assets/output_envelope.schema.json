{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "title": "命令输出信封",
    "description": "文章/视频命令 stdout 的统一结构。成功、空结果、错误都使用本信封。stderr 只有日志，不是本结构。",
    "required": [
        "status",
        "error_code",
        "message",
        "timestamp",
        "request",
        "metadata",
        "results"
    ],
    "properties": {
        "status": {
            "type": "string",
            "enum": ["success", "empty", "error"],
            "description": "success 为有结果；empty 为没有匹配内容，退出码仍为 0；error 为失败"
        },
        "error_code": {
            "type": "string",
            "description": "OK、NO_MATCH、INVALID_KEYWORD、INVALID_ARGS、AUTH_REQUIRED、AUTH_ERROR、PLAN_LIMIT、INSUFFICIENT_BALANCE、RATE_LIMITED、DAILY_LIMIT、TIMEOUT、NETWORK_ERROR、HTTP_5xx、API_ERROR、API_SCHEMA_CHANGED、UNKNOWN，或接口返回的业务码字符串。按 errmsg 判别：14 包月条数；15 余额；2 短时限流；18 日消费上限（CheckDayMoney）"
        },
        "message": {
            "type": "string",
            "description": "给人读的说明"
        },
        "timestamp": {
            "type": "string",
            "description": "输出时间，北京时间，格式如 2026/9/4 20:13:20，月和日不补零"
        },
        "request": {
            "type": "object",
            "description": "本次实际使用的参数。参数尚未解析成功时只有 command",
            "required": ["command"],
            "properties": {
                "command": {
                    "type": "string",
                    "enum": ["article", "video"],
                    "description": "命令名"
                },
                "keyword_raw": {
                    "type": "string",
                    "description": "用户原始关键词"
                },
                "keyword": {
                    "type": "string",
                    "description": "整理空白后实际使用的关键词"
                },
                "sort": {
                    "type": "number",
                    "description": "排序。0 综合，1 最新，2 最热"
                },
                "publishTime": {
                    "type": "number",
                    "description": "文章：发布时间。0 不限，1 最近1天，2 最近7天，3 最近半年"
                },
                "duration": {
                    "type": "number",
                    "description": "视频：时长。0 不限，1 5分钟以下，2 5-20分钟，3 20分钟以上"
                },
                "limit": {
                    "type": "number",
                    "description": "1-10000。包月 Token 实际最多 20"
                }
            }
        },
        "metadata": {
            "type": "object",
            "required": ["skill_version", "runtime_version", "execution_time"],
            "properties": {
                "skill_version": {
                    "type": "string",
                    "description": "技能版本"
                },
                "runtime_version": {
                    "type": "string",
                    "description": "Node.js 版本"
                },
                "execution_time": {
                    "type": "number",
                    "description": "本次执行耗时，毫秒。未捕获异常时为 0"
                },
                "total": {
                    "type": "number",
                    "description": "成功时等于 results 的条数"
                }
            }
        },
        "results": {
            "description": "error 与 empty 时为 null。成功时为数组，条目字段见 article_cli_resp / video_cli_resp",
            "oneOf": [
                {
                    "type": "null"
                },
                {
                    "type": "array",
                    "items": {
                        "type": "object"
                    }
                }
            ]
        }
    }
}
