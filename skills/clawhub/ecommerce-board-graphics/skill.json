{
  "name": "ecommerce-board-graphics",
  "version": "0.1.0",
  "description": "电商UV荧光板产品图处理：输入原图/PSD → 输出A5包边板子 + 紫光灯效果图 + 宣传册。规则来自真实生产多轮迭代，含抠图、内包边、横竖版自适应、紫光发光、宣传册排版全流程。",
  "author": "project-01-电商产品图技能包",
  "license": "proprietary",
  "requires": {
    "python": "3.10+",
    "packages": ["Pillow", "numpy", "psd-tools"]
  },
  "platforms": ["windows"],
  "entry_points": {
    "uv": "scripts/uv_from_cut.py",
    "board": "scripts/make_boards_v2.py",
    "catalog": "scripts/make_catalog.py"
  },
  "references": [
    "references/board-rule.md",
    "references/uv-rule.md"
  ],
  "docs": "README.md"
}
