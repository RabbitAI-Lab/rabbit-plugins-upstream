      "--name",
      "suite-test",
      "--answers",
      "{\"problem\":\"个人投资者需要一个统一工作台，一站式完成信息收集、信息整理、投资组合监控、组合调整\",\"audience\":\"个人投资者（非机构散户）\",\"platform\":\"workbuddy\",\"entry\":\"create\",\"flow\":\"分几个模块独立完成\",\"priority\":\"界面简洁、操作直观、数据准确\",\"example\":\"投资者早上打开工作台看组合涨跌汇总\",\"boundary\":\"不提供投资建议，不代客下单\"}"
    ],
    "checks": {
      "content_not_contains": {
