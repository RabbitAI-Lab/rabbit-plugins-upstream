  },
  {
    "id": "deepen-accept",
    "name": "③深化设计：批量采纳 + 拍板 + 勾验收（deepen）",
    "description": "验证 deepen_blueprint 能一次性完成③深化设计：采纳全部【AI 建议】、给【需用户拍板】字段定向赋值、勾验收 checklist；且不产生「- -」双破折号、不改动 > 开头的说明块。",
    "setup": "proto-deepen-blueprint",
    "command": "deepen",
    "args": [
      "{workdir}/deepen-test",
      "--accept-all",
      "--set",
      "B02.正交性=与 card-generator 是上下游：它按既定模板渲染，本 skill 负责素材整理",
      "--tick",
      "B01,B02,B03,B04,B05,B06,B07,B09,B10"
    ],
    "checks": {
      "files_exist": [
        "{workdir}/deepen-test/01-条件.md"
      ],
      "content_not_contains": {
        "{workdir}/deepen-test/01-条件.md": [
          "- - "
        ],
        "{workdir}/deepen-test/02-事实.md": [
          "- - "
        ]
      },
      "content_contains": {
        "{workdir}/deepen-test/02-事实.md": [
          "与 card-generator 是上下游"
        ],
        "{workdir}/deepen-test/01-条件.md": [
          "☑ 准入四问全部通过"
        ]
      },
      "stdout_contains": [
        "采纳",
        "勾验收",
        "剩余标记"
      ]
    }
  },
  {
    "id": "deepen-scan",
    "name": "③深化设计：只读扫描待决项（deepen 无参数）",
    "description": "不带任何写参数时 deepen 只扫描不改动：统计【AI 建议】/【待拍板】/【未勾】数量，且跳过 > 开头的说明块（否则「标【需用户拍板】的必须…」这句说明会被误计为待拍板项）。",
    "setup": "proto-deepen-blueprint",
    "command": "deepen",
    "args": [
      "{workdir}/deepen-test"
    ],
    "checks": {
      "stdout_contains": [
        "只读扫描",
        "AI建议",
        "待拍板",
        "未勾",
        "合计"
      ]
    }
  },
  {
    "id": "export-allow-gap",
    "name": "④施工蓝图：带缺口导出（export --allow-gap）",
    "description": "B08「真实场景跑过」必须等 skill 落地后才有，硬等 10/10 会让④永远导不出来。验证 --allow-gap 在 IQS ≥ 阈值时放行并把遗留缺口写进产物；同时验证 IQS < 阈值时仍拒绝（见 export-gap-rejected 用例）。",
    "setup": "deepen-ready-blueprint",
    "command": "export",
    "args": [
      "{workdir}/deepen-test",
      "--format",
      "all",
      "--allow-gap"
    ],
    "checks": {
      "files_exist": [
        "{workdir}/deepen-test/brief/summary.md",
        "{workdir}/deepen-test/brief/brief.json"
      ],
      "content_contains": {
        "{workdir}/deepen-test/brief/summary.md": [
          "遗留缺口",
          "带缺口导出"
        ],
        "{workdir}/deepen-test/brief/brief.json": [
          "\"gaps\""
        ]
      },
      "stdout_contains": [
        "带缺口导出",
        "已生成"
      ]
    }
  },
  {
    "id": "export-gap-rejected",
    "name": "④施工蓝图：缺口过多仍拒绝导出（export --allow-gap 阈值）",
    "description": "②初步方案阶段 IQS 仅 86，即便加了 --allow-gap 也应被阈值（默认 90）挡下——否则带缺口导出会退化成「随便导出」。",
    "setup": "proto-deepen-blueprint",
    "command": "export",
    "args": [
      "{workdir}/deepen-test",
      "--format",
      "all",
      "--allow-gap"
    ],
    "expect_exit_code": 1,
    "checks": {
      "stdout_contains": [
        "缺口太多",
        "先补再导出"
      ]
    }
  },
  {
    "id": "export-warn-reason-visible",
    "name": "④施工蓝图：仅警告被拦时，拒绝消息必须回显真实原因（F1）",
    "description": "C7 边界密度属 warnings（不是 errors）：十格全填齐时 errors==0、IQS 100，check 退出码 2。旧行为下 export_brief 取 `error or next_action`——此刻 error 为空，于是把 next_action（「全部 10 格已完成——跑…进入交接落地」）当成拦截原因打印，用户看到的是**拒绝语 + 鼓励语并存**，真实原因一次都没出现。本用例钉住修复后的行为：必须回显 C7 的真实原因，且不得出现那句鼓励语。",
    "setup": "fill-noboundary-blueprint",
    "command": "export",
    "args": [
      "{workdir}/noboundary-test",
      "--format",
      "json",
      "--stdout"
    ],
    "expect_exit_code": 1,
    "checks": {
      "stdout_contains": [
        "无法导出交接产物",
        "C7",
        "边界条目"
      ],
      "stdout_not_contains": [
        "进入交接落地",
        "全部 10 格已完成"
      ]
    }
  },
  {
    "id": "proto-suite-no-cloudbase",
    "name": "②初步方案：suite 触发词不含外部样本案例领域词（proto）",
    "description": "suite 型蓝图（多子域工作台）的触发词建议不应混入 cloudbase 外部样本案例的领域词（auth/数据库/云函数）——触发词必须泛化，否则污染用户触发词、伤 A 维触发可辨。",
