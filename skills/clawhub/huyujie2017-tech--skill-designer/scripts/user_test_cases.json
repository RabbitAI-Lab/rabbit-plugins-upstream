    "args": [
      "--answers",
      "{\"problem\":\"拉 A 股实时行情做量能评分并出 HTML 报告\"}",
      "--json"
    ],
    "checks": {
      "stdout_contains": [
        "\"id\": \"tool\"",
        "外部 API"
      ]
    }
  },
  {
    "id": "proto-draft",
