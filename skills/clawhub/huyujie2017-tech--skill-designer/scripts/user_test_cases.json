  {
    "id": "b09-auto-iqs",
    "name": "只评 BR-5、其余分数机器自动算（b09-summary --json）",
    "description": "验证 IQS 未填时由 check_blueprint 逐格机器算、EVS 由 BR-5 均分换算、综合分按 IQS×EVS/100 推出。",
    "setup": "fill-br5-only-blueprint",
    "command": "b09-summary",
    "args": [
      "{workdir}/br5-test",
      "--json"
    ],
    "checks": {
      "stdout_contains": [
        "\"iqs\": 100",
        "\"iqs_source\": \"机器算\"",
        "\"evs\": 90",
        "\"evs_source\": \"由 BR-5 换算\"",
        "\"overall\": 90",
        "\"overall_source\": \"机器算\""
      ]
    }
  },
  {
    "id": "check-iqs-br5-link",
    "name": "IQS × BR-5 联动：待补格标注涨哪一维（check --json）",
    "description": "验证待补格能标注它支撑的 BR-5 维度（如 B05→T/R/E），使 IQS 缺口与 BR-5 低分可联动定位。",
    "setup": "init-empty-blueprint",
    "command": "check",
    "args": [
      "{workdir}/empty-test"
    ],
    "expect_exit_code": 1,
    "checks": {
      "stdout_contains": [
        "B05(涨T/R/E)",
        "B06(涨T/R/A)",
        "B07(涨C)",
        "B08(涨E)"
      ]
    }
  },
  {
    "id": "structure-list",
