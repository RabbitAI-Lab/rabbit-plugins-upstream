[
  {
    "id": "init-create",
    "name": "从零创建蓝图（init）",
    "description": "验证 Phase 0 三问确认后，init_blueprint 能生成完整蓝图骨架。",
    "command": "init",
    "args": [
      "{workdir}/init-test",
      "--name",
      "init-test",
      "--channel",
      "light",
      "--entry",
      "create"
    ],
    "checks": {
      "files_exist": [
        "{workdir}/init-test/index.md",
        "{workdir}/init-test/01-条件.md",
        "{workdir}/init-test/10-复盘.md"
      ],
      "content_contains": {
        "{workdir}/init-test/index.md": [
          "init-test — 技能蓝图",
          "平台 | workbuddy"
        ]
      }
    }
  },
  {
    "id": "draft-imagine",
    "name": "我拟路径生成草稿（draft）",
    "description": "验证 draft_blueprint 能根据核心回答预填 B01–B10 草稿字段。",
    "command": "draft",
    "args": [
      "{workdir}/draft-test",
      "--name",
      "draft-test",
      "--answers",
      "{\"problem\":\"从会议纪要自动提取行动项\",\"scenario\":\"每次开完会后把纪要粘贴给AI\",\"platform\":\"workbuddy\",\"entry\":\"create\",\"priority\":\"不要漏掉任何行动项\"}"
    ],
    "checks": {
      "files_exist": [
        "{workdir}/draft-test/01-条件.md",
        "{workdir}/draft-test/05-分析.md"
      ],
      "content_contains": {
        "{workdir}/draft-test/01-条件.md": [
          "【AI 建议】",
          "结论：做",
          "（AI 已判定·待复核）"
        ],
        "{workdir}/draft-test/05-分析.md": [
          "输入 I：",
          "输出 O：",
          "【AI 建议】"
        ]
      }
    }
  },
  {
    "id": "check-complete",
    "name": "完整蓝图检查（check）",
    "description": "生成一个已填充字段的蓝图，验证 check_blueprint 返回完整通过，且机器算出的 IQS 为满分。",
    "setup": "fill-check-blueprint",
    "command": "check",
    "args": [
      "{workdir}/check-test",
      "--json"
    ],
    "checks": {
      "stdout_contains": [
        "\"ok\": true",
        "\"exit_code\": 0",
        "\"score\": 100"
      ]
    }
  },
  {
    "id": "check-write-iqs",
    "name": "机器算 IQS 并回填（check --write-iqs）",
    "description": "验证 check_blueprint 能机器算出 IQS 蓝图完备度并回填进 09-结果.md 的「内部质量分」字段。",
    "setup": "fill-check-blueprint",
    "command": "check",
    "args": [
      "{workdir}/check-test",
      "--write-iqs"
    ],
    "checks": {
      "stdout_contains": [
        "IQS 蓝图完备度：100/100",
        "已回填"
      ],
      "content_contains": {
        "{workdir}/check-test/09-结果.md": [
          "内部质量分（IQS，蓝图完备度）：100"
        ]
      }
    }
  },
  {
    "id": "check-iqs-empty",
    "name": "空蓝图 IQS 应为 0（check --json）",
    "description": "验证全新未填蓝图（init 后原样）IQS 判为 0——说明型文字与分组标题不得误判为已填。",
    "setup": "init-empty-blueprint",
    "command": "check",
    "args": [
      "{workdir}/empty-test",
      "--json"
    ],
    "expect_exit_code": 1,
    "checks": {
      "stdout_contains": [
        "\"score\": 0",
        "\"exit_code\": 1"
      ]
    }
  },
  {
    "id": "export-brief",
    "name": "蓝图交接产物导出（export）",
    "description": "验证完整蓝图能导出 summary.md / brief.json / SKETCH.md，且三种产物均含决策溯源表（关键决策↔来源格↔类型）。",
    "setup": "fill-export-blueprint",
    "command": "export",
    "args": [
      "{workdir}/export-test",
      "--output",
      "{workdir}/export-test/brief",
      "--format",
      "all"
    ],
    "checks": {
      "files_exist": [
        "{workdir}/export-test/brief/summary.md",
        "{workdir}/export-test/brief/brief.json",
        "{workdir}/export-test/brief/SKETCH.md"
      ],
      "content_contains": {
        "{workdir}/export-test/brief/summary.md": [
          "决策溯源表"
        ],
        "{workdir}/export-test/brief/brief.json": [
          "provenance",
          "source_block",
          "schema_version"
        ],
        "{workdir}/export-test/brief/SKETCH.md": [
          "决策溯源"
        ]
      }
    }
  },
