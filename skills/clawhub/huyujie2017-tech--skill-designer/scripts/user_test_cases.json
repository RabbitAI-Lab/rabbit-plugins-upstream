      "--answers",
      "{\"problem\":\"从会议纪要自动提取行动项\",\"audience\":\"产品经理每次开完会后\",\"platform\":\"workbuddy\",\"entry\":\"create\",\"priority\":\"不要漏掉任何行动项\",\"example\":\"把今天的周会纪要粘贴进来，输出待办清单\"}"
    ],
    "checks": {
