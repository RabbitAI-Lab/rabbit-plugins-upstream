  {
    "id": "infer-design",
    "name": "设计推断引擎（infer --json）",
    "description": "验证 infer_design 能从一句话需求推出「交互模式 × 内容模式」与结构框架 archetype，且产出型（Generator）优先于澄清型（Inversion）。读书笔记→template。",
    "command": "infer",
    "args": [
      "--answers",
      "{\"problem\":\"把读书笔记整理成结构化卡片沉淀到 Obsidian\"}",
      "--json"
    ],
    "checks": {
      "stdout_contains": [
        "\"interaction\": \"Generator + 知识路由\"",
        "\"content\": \"D 模板渲染\"",
        "\"id\": \"template\"",
        "\"consistent_with_pattern\": true",
        "产出型优先"
      ]
    }
  },
  {
    "id": "infer-design-tool",
    "name": "设计推断引擎：外部调用判为 tool（infer）",
    "description": "验证存在外部 API / 数据调用时，决策表把结构判为 tool（工具编排型），而非被知识信号带偏。",
